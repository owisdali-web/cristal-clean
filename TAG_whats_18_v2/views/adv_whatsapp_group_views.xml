<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View للمجموعات -->
    <record id="adv_whatsapp_group_form_view" model="ir.ui.view">
        <field name="name">adv.whatsapp.group.form</field>
        <field name="model">adv.whatsapp.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_groups_from_api" type="object" 
                            class="btn-primary" string="🔄 Fetch Groups"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="group_id"/>
                        <field name="participant_count"/>
                        <field name="is_admin"/>
                        <field name="last_sync"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="adv_whatsapp_group_tree_view" model="ir.ui.view">
        <field name="name">adv.whatsapp.group.list</field>
        <field name="model">adv.whatsapp.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="group_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="adv_whatsapp_group_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">adv.whatsapp.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ✅ تغيير جذري: نجعلها قائمة منفصلة في المستوى الرئيسي -->
    <menuitem id="adv_whatsapp_groups_menu"
              name="📱 WhatsApp Groups"
              parent="adv_root_menu"
              action="adv_whatsapp_group_action"
              sequence="15"/>
        <!-- ✅ بديل آخر: في الإعدادات -->
    <menuitem id="adv_whatsapp_groups_menu"
              name="WhatsApp Groups"
              parent="base.menu_administration"
              action="adv_whatsapp_group_action"
              sequence="50"/>

</odoo>
