<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="adv_whatsapp_dashboard_action" model="ir.actions.client">
        <field name="name">WhatsApp Dashboard</field>
        <field name="tag">whatsapp_dashboard</field>
    </record>

    <record id="adv_whatsapp_chat_action" model="ir.actions.client">
        <field name="name">WhatsApp Chat</field>
        <field name="tag">whatsapp_chat</field>
    </record>

    <menuitem id="adv_whatsapp_dashboard_menu"
              name="Dashboard"
              parent="adv_root_menu"
              action="adv_whatsapp_dashboard_action"
              sequence="1"/>

    <menuitem id="adv_whatsapp_chat_menu"
              name="Chat"
              parent="adv_root_menu"
              action="adv_whatsapp_chat_action"
              sequence="2"/>

</odoo>
