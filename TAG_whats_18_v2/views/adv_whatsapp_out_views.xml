<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ✅ القائمة الرئيسية والأب -->
    <menuitem id="adv_root_menu"
              name="Adv Notifications"
              sequence="99"
              web_icon="TAG_whats_18_v2,static/description/icon.png"/>

    <menuitem id="adv_whatsapp_notifications_menu"
              name="Whatsapp Notifications"
              parent="adv_root_menu"
              sequence="10"/>

    <!-- Tree View للرسائل -->
    <record id="adv_whatsapp_out_treeview" model="ir.ui.view">
        <field name="name">adv.whatsapp.out.list</field>
        <field name="model">adv.whatsapp.out</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'sent'" 
                  decoration-warning="status == 'pending'" 
                  decoration-danger="status == 'failed'">
                <field name="create_date" string="Creation Date"/>
                <field name="recipient_type" string="Recipient Type"/>
                <field name="phone" string="Phone"/>
                <field name="group_id" string="Group ID"/>
                <field name="body" string="Body"/>
                <field name="status" string="Status"/>
                <field name="last_error" string="Last Error" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View للرسائل -->
    <record id="adv_whatsapp_out_formview" model="ir.ui.view">
        <field name="name">adv.whatsapp.out.form</field>
        <field name="model">adv.whatsapp.out</field>
        <field name="arch" type="xml">
            <form string="Whatsapp Notification">
                <header>
                    <button name="action_send_to_individual" type="object" 
                            string="📱 Send to Individual" class="btn-primary"
                            invisible="recipient_type != 'individual' or status == 'sent'"/>
                    <button name="action_send_to_group" type="object" 
                            string="👥 Send to Group" class="btn-success"
                            invisible="recipient_type != 'group' or status == 'sent'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="recipient_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="phone" placeholder="e.g. 966501234567"
                                   invisible="recipient_type != 'individual'"
                                   required="recipient_type == 'individual'"/>
                            <field name="group_id" placeholder="e.g. 123456789-987654321@g.us"
                                   invisible="recipient_type != 'group'"
                                   required="recipient_type == 'group'"/>
                        </group>
                    </group>
                    <group>
                         <field name="body" placeholder="Type your message here..."/>
                    </group>
                    <group>
                         <field name="media" filename="media_filename" invisible="type != 'media'"/>
                         <field name="media_filename" invisible="1"/>
                    </group>
                    <group string="Technical Information" groups="base.group_system">
                        <field name="attempts"/>
                        <field name="next_try"/>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action للرسائل -->
    <record id="adv_whatsapp_out_action" model="ir.actions.act_window">
        <field name="name">Whatsapp Messages</field>
        <field name="res_model">adv.whatsapp.out</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">There are no WhatsApp messages to show.</p>
        </field>
    </record>

    <!-- ✅ قائمة الرسائل فقط -->
    <menuitem id="adv_whatsapp_out_menu"
              name="Messages"
              parent="adv_whatsapp_notifications_menu"
              action="adv_whatsapp_out_action"
              sequence="10"/>

</odoo>
