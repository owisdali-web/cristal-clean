<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_phone_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">phone.duplicate.wizard.form</field>
        <field name="model">phone.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Phone Detected">
                <field name="message" nolabel="1" readonly="1"/>
                <field name="existing_partner_id" invisible="1"/>
                <field name="current_partner_id" invisible="1"/>
                <field name="current_partner_name" invisible="1"/>
                <field name="phone_input" invisible="1"/>
                <footer>
                    <button name="action_link_existing"
                            string="Add as Related Contact"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_open_existing"
                            string="Open Existing Contact"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>