<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tag_whats_18" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tag.whats</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">

                <div class="app_settings_block" data-string="WhatsApp Notifications" string="WhatsApp Notifications">
                    <h2>WhatsApp – إشعارات الاستلام</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">

                            <!-- الإعداد الأول: تفعيل الإشعارات -->
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="enable_receipt_notify"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="enable_receipt_notify"/>
                                    <div class="text-muted">
                                        تفعيل إرسال إشعارات واتساب تلقائيًا عند اعتماد الاستلامات (incoming).
                                    </div>
                                </div>
                            </div>

                            <!-- الإعداد الثاني: فقط لأوامر الشراء -->
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="receipt_notify_only_po"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="receipt_notify_only_po"/>
                                    <div class="text-muted">
                                        أرسل فقط للاستلامات المرتبطة بأوامر شراء (PO).
                                    </div>
                                </div>
                            </div>

                            <!-- الإعداد الثالث: الحد الأقصى للسطور -->
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="receipt_notify_max_lines"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="receipt_notify_max_lines"/>
                                    <div class="text-muted">
                                        الحد الأقصى لسطور الرسالة قبل التحويل إلى مرفق CSV.
                                    </div>
                                </div>
                            </div>

                            <!-- الإعداد الرابع: رقم الهاتف البديل (تم تعديله) -->
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane"/> <!-- الجزء الأيسر فارغ -->
                                <div class="o_setting_right_pane">
                                    <!-- تم نقل الحقل إلى هنا مع العنوان -->
                                    <label for="receipt_notify_phone"/>
                                    <div class="text-muted">
                                        <field name="receipt_notify_phone" class="oe_inline"/>
                                        رقم بديل عند عدم توفر رقم لمسؤول المخزن أو للشركة.
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>
