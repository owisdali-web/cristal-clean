<odoo>
  <record id="view_pos_order_form_inherit_whatsapp" model="ir.ui.view">
    <field name="name">pos.order.form.inherit.whatsapp</field>
    <field name="model">pos.order</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="priority" eval="50"/>
    <field name="arch" type="xml">
      <!-- header button to force send (also useful for testing) -->
      <xpath expr="//header" position="inside">
        <button name="action_send_whatsapp_now"
                type="object"
                string="Send WhatsApp Now"
                class="oe_highlight"
                invisible="whatsapp_auto_sent or not partner_id"/>
      </xpath>

      <!-- show status fields somewhere visible -->
      <xpath expr="//sheet//group" position="inside">
        <group string="WhatsApp">
          <field name="whatsapp_auto_sent" readonly="1"/>
          <field name="whatsapp_auto_due" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
