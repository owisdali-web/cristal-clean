<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="car_wash_dashboard.DashboardV9">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;600;700;800;900&amp;display=swap"/>
  <div t-att-class="'cc12-root cc13-root theme-' + state.theme" dir="rtl">
    <div t-if="state.loading" class="cc12-loader">
      <img src="/car_wash_dashboard/static/src/img/premium_real_v12/logo_white.png" alt="Crystal Clean"/>
      <strong>يتم تجهيز لوحة كريستال كلين...</strong>
      <span></span>
    </div>

    <div t-else="" class="cc12-app">
      <header class="cc12-hero">
        <div class="cc12-hero-overlay"></div>
        <img class="cc12-brand" src="/car_wash_dashboard/static/src/img/premium_real_v12/logo_white.png" alt="Crystal Clean"/>
        <div class="cc12-hero-copy">
          <h1>نظام إدارة مغاسل السيارات</h1>
          <p>تشغيل أذكى .. تجربة أنظف .. عناية تليق بعملائنا</p>
        </div>
        <div class="cc12-hero-tagline">
          <b>سيارات أنظف</b>
          <b>حياة أجمل</b>
          <small>CLEANER CARS · HAPPIER PEOPLE</small>
        </div>
      </header>

      <main class="cc12-shell">
        <div class="cc12-toolbar">
          <nav class="cc12-tabs">
            <button t-att-class="state.page === 'dashboard' ? 'active' : ''" t-on-click="() => this.setPage('dashboard')"><i class="fa fa-home"></i><span>لوحة</span></button>
            <button t-att-class="state.page === 'customers' ? 'active' : ''" t-on-click="() => this.setPage('customers')"><i class="fa fa-television"></i><span>زبائن</span></button>
            <button t-att-class="state.page === 'finance' ? 'active' : ''" t-on-click="() => this.setPage('finance')"><i class="fa fa-cubes"></i><span>مواد ومالية</span></button>
            <button t-att-class="state.page === 'hr' ? 'active' : ''" t-on-click="() => this.setPage('hr')"><i class="fa fa-users"></i><span>فريق</span></button>
            <button t-att-class="state.page === 'clients' ? 'active' : ''" t-on-click="() => this.setPage('clients')"><i class="fa fa-user"></i><span>عملاء</span></button>
          </nav>
          <div class="cc12-session">
            <div class="cc12-user"><span t-esc="userInitial"></span><div><b t-esc="state.data.current_user_name || 'المستخدم الحالي'"></b><small t-esc="state.data.company_name"></small></div></div>
            <div class="cc12-clock"><small t-esc="dateLabel"></small><b t-esc="timeLabel"></b></div>
            <button class="cc13-theme-toggle" t-on-click="toggleTheme" t-att-title="state.theme === 'dark' ? 'الوضع الفاتح' : 'الوضع الداكن'"><i t-att-class="state.theme === 'dark' ? 'fa fa-sun-o' : 'fa fa-moon-o'"></i><span t-esc="state.theme === 'dark' ? 'فاتح' : 'داكن'"></span></button>
            <button class="cc12-refresh" t-on-click="manualRefresh" title="تحديث"><i class="fa fa-refresh"></i></button>
          </div>
        </div>

        <!-- DASHBOARD -->
        <section t-if="state.page === 'dashboard'" class="cc12-page cc13-page cc13-dashboard">
          <div class="cc13-dashboard-head">
            <div class="cc13-title"><span>CRYSTAL CLEAN OPERATIONS</span><h2>لوحة التحكم الرئيسية</h2><p>مراقبة المحطات والسيارات والفريق في الوقت الفعلي</p></div>
            <div class="cc13-head-status"><span class="cc13-live"><i></i> مباشر</span><small>آخر تحديث <b t-esc="state.lastUpdate || timeLabel"></b></small></div>
          </div>

          <div class="cc13-kpis">
            <button class="cc13-kpi cars" t-on-click="() => this.openKpi('total_today')"><i class="fa fa-car"></i><div><small>إجمالي السيارات اليوم</small><strong t-esc="state.data.total_today"></strong><em><t t-esc="state.data.done_today"/> منجزة</em></div><span class="cc13-mini-ring"></span></button>
            <button class="cc13-kpi service" t-on-click="() => this.openKpi('in_progress')"><i class="fa fa-wrench"></i><div><small>قيد التنفيذ</small><strong t-esc="state.data.in_progress"></strong><em>سيارات تعمل الآن</em></div><span class="cc13-mini-ring blue"></span></button>
            <button class="cc13-kpi waiting" t-on-click="() => this.openKpi('waiting')"><i class="fa fa-clock-o"></i><div><small>في الانتظار</small><strong t-esc="state.data.waiting"></strong><em>بانتظار محطة</em></div><span class="cc13-mini-ring orange"></span></button>
            <button class="cc13-kpi ready" t-on-click="() => this.openKpi('ready_delivery')"><i class="fa fa-check-circle"></i><div><small>جاهزة للتسليم</small><strong t-esc="state.data.ready_delivery"></strong><em>جاهزة للعميل</em></div><span class="cc13-mini-ring green"></span></button>
            <article class="cc13-kpi turnaround"><i class="fa fa-stopwatch"></i><div><small>متوسط وقت الخدمة</small><strong><t t-esc="state.data.avg_turnaround || 0"/> <small>دقيقة</small></strong><em>حسب الخدمات المكتملة</em></div></article>
            <article class="cc13-kpi efficiency"><i class="fa fa-line-chart"></i><div><small>إشغال المحطات</small><strong><t t-esc="state.data.reports_page.station_utilization || 0"/>%</strong><em>متوسط التشغيل الحالي</em></div></article>
          </div>

          <section class="cc13-station-board">
            <div class="cc13-section-head">
              <div><h3>المحطات A1–A10</h3><span>تفاصيل تشغيلية حية · A9 آلي · A10 لمعة</span></div>
              <button t-on-click="openShopFloor"><i class="fa fa-desktop"></i> فتح شاشة التشغيل</button>
            </div>
            <div class="cc13-stations-grid">
              <t t-foreach="stationSlots" t-as="station" t-key="station.id">
                <article t-att-class="'cc13-station-card tone-' + stationTone(station)" t-on-click="() => this.selectStation(station)">
                  <header>
                    <div class="cc13-station-name"><strong t-esc="stationCode(station)"></strong><span t-esc="stationTypeLabel(station)"></span></div>
                    <span t-att-class="'cc13-status is-' + stationStatus(station)"><i></i><t t-esc="stationStatusLabel(station)"/></span>
                  </header>
                  <div class="cc13-station-media">
                    <img t-att-src="stationPhoto(station)" alt=""/>
                    <span class="cc13-media-shade"></span>
                    <i t-if="stationStatus(station) === 'busy'" class="cc13-light-scan"></i>
                    <div t-if="stationCar(station)" class="cc13-timer"><i class="fa fa-clock-o"></i><t t-esc="stationElapsedLabel(station)"/></div>
                    <div t-if="stationKind(station) === 'auto'" class="cc13-special auto"><i class="fa fa-cogs"></i> محطة آلية</div>
                    <div t-if="stationKind(station) === 'polish'" class="cc13-special polish"><i class="fa fa-diamond"></i> محطة لمعة</div>
                  </div>
                  <div class="cc13-station-body">
                    <t t-if="stationCar(station)">
                      <div class="cc13-car-title"><div><b t-esc="stationCar(station).vehicle_model || stationCar(station).service_name"></b><small t-esc="stationCar(station).service_name"></small></div><strong><t t-esc="stationCar(station).progress"/>%</strong></div>
                      <div class="cc13-progress"><i t-att-style="progressWidth(stationCar(station).progress)"></i></div>
                      <div class="cc13-car-meta"><span><i class="fa fa-id-card-o"></i><t t-esc="stationCar(station).public_reference || stationCar(station).plate || 'بدون لوحة'"/></span><span><i class="fa fa-user"></i><t t-esc="stationCar(station).customer || 'عميل المغسلة'"/></span></div>
                      <div class="cc13-operation"><i t-att-class="'fa ' + operationIcon(focusedOperation(station).name)"></i><div><small>العملية الحالية</small><b t-esc="focusedOperation(station).name"></b></div><em t-esc="remainingLabel(stationCar(station))"></em></div>
                    </t>
                    <t t-else="">
                      <div class="cc13-idle-state"><i class="fa fa-check-circle"></i><b>المحطة متاحة</b><span>جاهزة لاستقبال سيارة جديدة</span></div>
                    </t>
                  </div>
                  <footer>
                    <span><i class="fa fa-users"></i><t t-esc="stationCrewLabel(station)"/></span>
                    <span><i class="fa fa-hourglass-half"></i><t t-esc="stationQueueLabel(station)"/></span>
                    <span><i class="fa fa-check"></i><t t-esc="stationDoneLabel(station)"/></span>
                  </footer>
                </article>
              </t>
            </div>
          </section>

          <div class="cc13-bottom-grid">
            <article class="cc13-panel activity"><header><h3>الأنشطة الأخيرة</h3><button t-on-click="manualRefresh">تحديث</button></header><div class="cc13-activity-list"><t t-foreach="state.data.timeline.slice(0,4)" t-as="row" t-key="row.id"><div><time t-esc="row.completed_at || '--:--'"></time><i></i><span>اكتملت خدمة <b t-esc="row.service_name"></b> للسيارة <t t-esc="row.public_reference || row.plate"/></span></div></t><div t-if="!state.data.timeline.length" class="cc13-empty">لا توجد عمليات مكتملة اليوم حتى الآن.</div></div></article>
            <article class="cc13-panel materials"><header><h3>المواد اليوم</h3><button t-on-click="() => this.setPage('finance')">التفاصيل</button></header><div class="cc13-material-list"><t t-foreach="displayMaterials.slice(0,4)" t-as="item" t-key="item.product_id"><div><span t-esc="item.product_name"></span><i><em t-att-style="materialStyle(item)"></em></i><b><t t-esc="materialPct(item)"/>%</b></div></t><div t-if="!displayMaterials.length" class="cc13-empty">لا توجد مواد مرتبطة بخدمات الغسيل.</div></div></article>
            <article class="cc13-panel team"><header><h3>أداء الفريق اليوم</h3><button t-on-click="() => this.setPage('hr')">عرض الفريق</button></header><div class="cc13-team-list"><t t-foreach="hrUserRows.slice(0,4)" t-as="row" t-key="row.id"><div><span class="avatar" t-esc="initialOf(row.name)"></span><div><b t-esc="row.name"></b><small t-esc="row.role"></small></div><i><em t-att-style="staffProgressStyle(row)"></em></i><strong t-esc="row.status_label"></strong></div></t><div t-if="!hrUserRows.length" class="cc13-empty">لا توجد بيانات فريق متاحة حالياً.</div></div></article>
            <article class="cc13-panel alerts"><header><h3>التنبيهات</h3><button>الآن</button></header><div class="cc13-alert-list"><t t-foreach="dashboardAlerts" t-as="alert" t-key="alert_index"><div t-att-class="'tone-' + alert.tone"><i t-att-class="'fa ' + alert.icon"></i><span t-esc="alert.text"></span></div></t></div></article>
          </div>

          <aside t-if="selectedStation" class="cc13-station-drawer">
            <div class="cc13-drawer-head"><div><span t-esc="stationTypeLabel(selectedStation)"></span><h3><t t-esc="stationCode(selectedStation)"/> · تفاصيل المحطة</h3></div><button t-on-click="closeStation"><i class="fa fa-times"></i></button></div>
            <div class="cc13-drawer-photo"><img t-att-src="stationPhoto(selectedStation)" alt=""/><span></span><div><b t-esc="stationStatusLabel(selectedStation)"></b><small t-esc="stationEfficiencyLabel(selectedStation)"></small></div></div>
            <t t-if="selectedStationCar">
              <div class="cc13-drawer-kpis"><div><small>السيارة</small><b t-esc="selectedStationCar.vehicle_model || selectedStationCar.service_name"></b></div><div><small>اللوحة</small><b t-esc="selectedStationCar.public_reference || selectedStationCar.plate"></b></div><div><small>العميل</small><b t-esc="selectedStationCar.customer || 'غير مسجل'"></b></div><div><small>الهاتف</small><b t-esc="selectedStationCar.customer_phone || '—'"></b></div><div><small>الوقت المنقضي</small><b t-esc="carDurationLabel(selectedStationCar)"></b></div><div><small>المتبقي</small><b t-esc="remainingLabel(selectedStationCar)"></b></div></div>
              <div class="cc13-drawer-section"><h4>الخدمة والمراحل</h4><div class="cc13-drawer-service"><b t-esc="selectedStationCar.service_name"></b><span><t t-esc="selectedStationCar.done_steps"/> / <t t-esc="selectedStationCar.total_steps"/> مراحل</span></div><div class="cc13-progress large"><i t-att-style="progressWidth(selectedStationCar.progress)"></i></div><div class="cc13-op-list"><t t-foreach="selectedStationCar.operations" t-as="op" t-key="op.id"><span t-att-class="'state-' + op.state"><i t-att-class="'fa ' + operationIcon(op.name)"></i><t t-esc="op.name"/></span></t></div></div>
              <div class="cc13-drawer-section"><h4>بيانات التشغيل</h4><div class="cc13-detail-lines"><p><span>الفريق</span><b t-esc="stationCrewLabel(selectedStation)"></b></p><p><span>الطابور</span><b t-esc="stationQueueLabel(selectedStation)"></b></p><p><span>المنجز اليوم</span><b t-esc="stationDoneLabel(selectedStation)"></b></p><p><span>قيمة الطلب</span><b t-esc="formatMoney(selectedStationCar.pos_amount)"></b></p></div></div>
              <div class="cc13-drawer-actions"><button class="primary" t-on-click="() => this.openProduction(selectedStationCar.id)"><i class="fa fa-file-text-o"></i> فتح أمر الغسيل</button><button t-on-click="() => this.openWorkcenter(selectedStation)"><i class="fa fa-desktop"></i> أوامر المحطة</button></div>
            </t>
            <t t-else=""><div class="cc13-drawer-empty"><i class="fa fa-check-circle"></i><b>المحطة متاحة حالياً</b><span>لا توجد سيارة قيد التنفيذ في هذه المحطة.</span><button t-on-click="() => this.openWorkcenter(selectedStation)">فتح المحطة</button></div></t>
          </aside>
        </section>

        <!-- CUSTOMER LOUNGE -->
        <section t-if="state.page === 'customers'" class="cc12-page cc12-customer-page">
          <div class="cc12-customer-bg"><img src="/car_wash_dashboard/static/src/img/premium_real_v12/lounge.webp" alt=""/><span></span></div>
          <div class="cc12-customer-brand"><img src="/car_wash_dashboard/static/src/img/premium_real_v12/logo_white.png" alt="Crystal Clean"/><div><b>شاشة الزبائن</b><small>متابعة مباشرة لحالة الخدمة</small></div></div>
          <button class="cc12-fullscreen" t-on-click="toggleCustomerFullscreen"><i class="fa fa-arrows-alt"></i> ملء الشاشة</button>
          <div class="cc12-customer-card">
            <t t-if="customerFocusCar">
              <span>سيارتكم الآن تحت العناية</span>
              <h2 t-esc="customerFocusCar.public_reference || customerFocusCar.plate || customerFocusCar.name"></h2>
              <p t-esc="customerFocusCar.vehicle_model || customerFocusCar.service_name"></p>
              <div class="cc12-customer-kpis"><div><small>الحالة</small><b t-esc="statusLabel(customerFocusCar)"></b></div><div><small>الوقت المتوقع</small><b t-esc="remainingLabel(customerFocusCar)"></b></div></div>
              <div class="cc12-customer-progress"><i t-att-style="progressWidth(customerFocusCar.progress)"></i></div>
              <strong><t t-esc="customerFocusCar.progress"/>% مكتمل</strong>
            </t>
            <t t-else=""><span>كريستال كلين</span><h2>أهلاً بكم</h2><p>لا توجد سيارات قيد الخدمة حالياً</p></t>
            <div class="cc12-thank"><i class="fa fa-heart"></i><div><b>شكراً لاختياركم كريستال كلين</b><small>العناية التي تستحقها سيارتكم</small></div></div>
          </div>
          <div class="cc12-ready-line"><b>جاهزة للتسليم</b><div><t t-foreach="readyCars.slice(0,4)" t-as="car" t-key="car.id"><span><i class="fa fa-check-circle"></i><t t-esc="car.public_reference || car.plate || car.name"/></span></t><small t-if="!readyCars.length">لا توجد سيارات جاهزة الآن</small></div></div>
        </section>

        <!-- MATERIALS & FINANCE -->
        <section t-if="state.page === 'finance'" class="cc12-page cc12-data-page">
          <div class="cc12-data-hero finance"><img src="/car_wash_dashboard/static/src/img/premium_real_v12/overview_day.webp" alt=""/><span></span><div><h2>المواد والمالية</h2><p>المخزون والمشتريات والمصروفات والإيرادات</p></div><button class="cc12-outline" t-on-click="openAccounting">فتح الحسابات</button></div>
          <div class="cc12-data-kpis"><article><i class="fa fa-cubes"></i><small>المواد</small><b t-esc="state.data.materials.length"></b></article><article><i class="fa fa-line-chart"></i><small>إيرادات الشهر</small><b t-esc="formatMoney(state.data.pos_page.month_revenue)"></b></article><article><i class="fa fa-arrow-down"></i><small>مصروفات اليوم</small><b t-esc="formatMoney(state.data.finance_page.expense_today)"></b></article><article><i class="fa fa-money"></i><small>صافي اليوم</small><b t-esc="formatMoney(state.data.finance_page.net_today)"></b></article></div>
          <div class="cc12-data-grid"><article class="cc12-table-card"><header><h3>المواد التشغيلية</h3><button t-on-click="openMaterials">عرض الكل</button></header><table><thead><tr><th>المادة</th><th>المتوفر</th><th>الوحدة</th><th>يكفي</th><th>الحالة</th></tr></thead><tbody><t t-foreach="displayMaterials" t-as="item" t-key="item.product_id"><tr t-on-click="() => this.openProduct(item.product_id)"><td><b t-esc="item.product_name"></b></td><td t-esc="item.free"></td><td t-esc="item.uom"></td><td t-esc="materialDaysLabel(item)"></td><td><span t-att-class="'cc12-pill ' + (item.burn_status || 'good')" t-esc="burnStatusLabel(item)"></span></td></tr></t><tr t-if="!displayMaterials.length"><td colspan="5" class="cc12-empty">لا توجد مواد مرتبطة بالخدمات حالياً.</td></tr></tbody></table></article><article class="cc12-finance-card"><header><h3>ملخص مالي</h3></header><div class="line"><span>المقبوضات</span><b class="up" t-esc="formatMoney(state.data.finance_page.collected_today)"></b></div><div class="line"><span>المصروفات</span><b class="down" t-esc="formatMoney(state.data.finance_page.expense_today)"></b></div><div class="line"><span>صافي التشغيل</span><b t-esc="formatMoney(state.data.finance_page.net_today)"></b></div><div class="bars"><t t-foreach="state.data.finance_page.week_pos_sales" t-as="item" t-key="item.label"><i t-att-style="financeBarStyle(item)"><small t-esc="item.label"></small></i></t></div></article></div>
        </section>

        <!-- TEAM -->
        <section t-if="state.page === 'hr'" class="cc12-page cc12-data-page">
          <div class="cc12-data-hero hr"><img src="/car_wash_dashboard/static/src/img/premium_real_v12/station_worker.webp" alt=""/><span></span><div><h2>الفريق</h2><p>المستخدمون والموظفون والورديات التشغيلية</p></div><button class="cc12-outline" t-on-click="openUsersList">فتح المستخدمين</button></div>
          <div class="cc12-data-kpis"><article><i class="fa fa-users"></i><small>إجمالي المستخدمين</small><b t-esc="state.data.client_hr_page.total_users"></b></article><article><i class="fa fa-user-circle"></i><small>متواجد حالياً</small><b t-esc="state.data.client_hr_page.present_today"></b></article><article><i class="fa fa-calendar"></i><small>الورديات</small><b t-esc="state.data.client_hr_page.shift_count"></b></article><article><i class="fa fa-line-chart"></i><small>الحضور</small><b><t t-esc="state.data.client_hr_page.attendance_rate"/>%</b></article></div>
          <article class="cc12-table-card full"><header><h3>المستخدمون والموظفون</h3></header><table><thead><tr><th>الموظف</th><th>الوظيفة</th><th>القسم / المحطة</th><th>الوردية</th><th>الحالة</th></tr></thead><tbody><t t-foreach="hrUserRows" t-as="row" t-key="row.id"><tr><td><b t-esc="row.name"></b></td><td t-esc="row.role"></td><td t-esc="row.station || row.department"></td><td t-esc="row.shift"></td><td><span t-att-class="'cc12-pill ' + staffStatusClass(row)" t-esc="row.status_label"></span></td></tr></t><tr t-if="!hrUserRows.length"><td colspan="5" class="cc12-empty">لا توجد بيانات موظفين حالياً.</td></tr></tbody></table></article>
        </section>

        <!-- CLIENTS -->
        <section t-if="state.page === 'clients'" class="cc12-page cc12-data-page">
          <div class="cc12-data-hero clients"><img src="/car_wash_dashboard/static/src/img/premium_real_v12/night_lineup.webp" alt=""/><span></span><div><h2>العملاء</h2><p>الزيارات والخدمات والعلاقات مع العملاء</p></div><button class="cc12-outline" t-on-click="openCustomerList">فتح العملاء</button></div>
          <div class="cc12-data-kpis"><article><i class="fa fa-users"></i><small>إجمالي العملاء</small><b t-esc="state.data.client_hr_page.total_customers"></b></article><article><i class="fa fa-repeat"></i><small>عملاء متكررون</small><b t-esc="state.data.client_hr_page.repeat_customers"></b></article><article><i class="fa fa-user-plus"></i><small>هذا الشهر</small><b t-esc="state.data.client_hr_page.new_customers_month"></b></article><article><i class="fa fa-star"></i><small>أفضل العملاء</small><b t-esc="topCustomerRows.length"></b></article></div>
          <article class="cc12-table-card full"><header><h3>قائمة العملاء</h3></header><table><thead><tr><th>العميل</th><th>الهاتف</th><th>عدد الزيارات</th><th>آخر زيارة</th><th>الخدمة المفضلة</th></tr></thead><tbody><t t-foreach="clientHrRows.slice(0,12)" t-as="row" t-key="row.id"><tr t-on-click="() => this.openPartner(row.id)"><td><b t-esc="row.name"></b></td><td t-esc="row.phone || '—'"></td><td t-esc="row.visits"></td><td t-esc="row.last_visit || '—'"></td><td t-esc="row.favorite_service || '—'"></td></tr></t><tr t-if="!clientHrRows.length"><td colspan="5" class="cc12-empty">لا توجد بيانات عملاء كافية بعد.</td></tr></tbody></table></article>
        </section>

