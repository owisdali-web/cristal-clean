<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="car_wash_dashboard.DashboardV8">
    <div class="cc8-root" dir="rtl">
      <div t-if="state.loading" class="cc8-loader"><div class="cc8-loader-car"><i class="fa fa-car"></i><span></span></div><strong>يتم تجهيز مركز التحكم...</strong></div>
      <div t-else="" class="cc8-shell">
        <!-- RIGHT SIDEBAR -->
        <aside class="cc8-sidebar">
          <div class="cc8-brand"><div class="cc8-logo-drop"><i class="fa fa-tint"></i></div><div><strong>كريستال كلين</strong><span>العناية بالسيارات</span></div></div>
          <nav>
            <button t-att-class="state.page === 'dashboard' ? 'active' : ''" t-on-click="() => this.setPage('dashboard')"><i class="fa fa-home"></i><span>الرئيسية</span></button>
            <button t-on-click="openShopFloor"><i class="fa fa-car"></i><span>المحطات</span></button>
            <button t-att-class="state.page === 'customers' ? 'active' : ''" t-on-click="() => this.setPage('customers')"><i class="fa fa-television"></i><span>شاشة الزبائن</span></button>
            <button t-att-class="state.page === 'finance' ? 'active' : ''" t-on-click="() => this.setPage('finance')"><i class="fa fa-cubes"></i><span>المواد والحسابات</span></button>
            <button t-att-class="state.page === 'pos' ? 'active' : ''" t-on-click="() => this.setPage('pos')"><i class="fa fa-shopping-cart"></i><span>نقطة البيع</span></button>
            <button t-on-click="openAccounting"><i class="fa fa-bar-chart"></i><span>التقارير</span></button>
          </nav>
          <div class="cc8-side-bottom"><button t-on-click="manualRefresh"><i class="fa fa-refresh"></i><span>تحديث</span></button><div class="cc8-side-promo"><img src="/car_wash_dashboard/static/src/img/v7/promo_car.png" alt=""/><strong>أكثر من مغسلة</strong><span>تجربة بصرية حية</span></div></div>
        </aside>

        <main class="cc8-main">
          <!-- TOP BAR -->
          <header class="cc8-topbar">
            <div class="cc8-user"><span class="cc8-avatar">A</span><div><strong>مدير المغسلة</strong><small t-esc="state.data.company_name"/></div></div>
            <div class="cc8-live-status"><span t-att-class="state.realtime ? 'is-live' : 'is-polling'"><i></i><t t-if="state.realtime">مباشر لحظي</t><t t-else="">تحديث تلقائي</t></span><em t-if="state.liveMessage" t-att-class="state.livePulse ? 'pulse' : ''"><i class="fa fa-bolt"></i><t t-esc="state.liveMessage"/></em></div>
            <div class="cc8-clock"><strong t-esc="dateLabel"></strong><span><i class="fa fa-clock-o"></i> <t t-esc="timeLabel"/></span></div>
            <label class="cc8-search"><i class="fa fa-search"></i><input placeholder="ابحث عن لوحة، عميل، خدمة أو محطة..." t-att-value="state.query" t-on-input="onSearchInput"/></label>
            <div class="cc8-top-actions"><button t-on-click="manualRefresh"><i class="fa fa-refresh"></i></button><button><i class="fa fa-bell"></i><em t-if="state.data.overdue" t-esc="state.data.overdue"></em></button></div>
          </header>

          <!-- DASHBOARD PAGE -->
          <div t-if="state.page === 'dashboard'" class="cc8-page cc8-dashboard-page">
            <section class="cc8-hero"><div class="cc8-hero-car"><img src="/car_wash_dashboard/static/src/img/v7/hero_car.png" alt=""/><div>سيارتك<br/><strong>تستحق الأفضل</strong></div></div><div class="cc8-hero-title"><h1>لوحة تحكم المغسلة</h1><p>إدارة العمليات والمحطات لحظة بلحظة</p></div><div class="cc8-hero-slogan"><span class="bubble b1"></span><span class="bubble b2"></span><strong>نظافة أكثر<br/>لحياة أجمل</strong></div></section>

            <section class="cc8-kpis">
              <button t-on-click="() => this.openKpi('active_total')"><i class="fa fa-car blue"></i><span>السيارات الحالية</span><b t-esc="state.data.active_total"></b><small>داخل دورة الخدمة</small></button>
              <button t-on-click="() => this.openKpi('in_progress')"><i class="fa fa-tint cyan"></i><span>قيد الغسيل</span><b t-esc="state.data.in_progress"></b><small>سيارة</small></button>
              <button t-on-click="() => this.openKpi('waiting')"><i class="fa fa-clock-o amber"></i><span>في الانتظار</span><b t-esc="state.data.waiting"></b><small>سيارة</small></button>
              <button t-on-click="() => this.openKpi('ready_delivery')"><i class="fa fa-check-circle green"></i><span>جاهزة للتسليم</span><b t-esc="state.data.ready_delivery"></b><small>سيارة</small></button>
              <button t-on-click="() => this.setPage('pos')"><i class="fa fa-shopping-cart violet"></i><span>طلبات POS اليوم</span><b t-esc="state.data.pos_page.orders_today"></b><small t-esc="formatMoney(state.data.pos_page.revenue_today)"></small></button>
              <button class="ring-card"><div class="cc8-ring" t-att-style="completionRingStyle()"><span><t t-esc="completionRate"/>%</span></div><span>نسبة الإنجاز</span><small><t t-esc="state.data.done_today"/> مكتملة اليوم</small></button>
            </section>

            <!-- STATIONS SHOW -->
            <section class="cc8-card cc8-stations-show">
              <div class="cc8-section-head"><div><h2><i class="fa fa-car"></i> تشغيل المحطات المباشر <span>(10)</span></h2><p>كل محطة تعرض السيارة الفعلية والعمليات المطلوبة فقط</p></div><div class="cc8-head-actions"><span class="cc8-live-chip"><i></i> مباشر</span><button t-on-click="openShopFloor">فتح شاشة التشغيل <i class="fa fa-external-link"></i></button></div></div>
              <div class="cc8-stations-grid">
                <t t-foreach="stationSlots" t-as="station" t-key="station.id">
                  <button t-att-class="stationCardClass(station)" t-on-click="() => this.openWorkcenter(station)">
                    <div class="cc8-station-head"><strong><t t-esc="station.name"/></strong><span t-att-class="'state is-' + stationStatus(station)" t-esc="stationStatusLabel(station)"></span></div>
                    <div class="cc8-station-scene" t-att-class="'cc8-station-scene op-' + focusedOperation(station).kind">
                      <div class="cc8-scene-wash" aria-hidden="true"><i/><i/><i/><i/><i/></div>
                      <div class="cc8-scene-polish" aria-hidden="true"><i/><i/><i/><i/></div>
                      <div class="cc8-scene-vacuum" aria-hidden="true"><i class="fa fa-circle-o-notch"></i></div>
                      <div class="cc8-scene-foam" aria-hidden="true"><i/><i/><i/><i/><i/><i/></div>
                      <div class="cc8-scene-brushes" aria-hidden="true"><i/><i/></div>
                      <img t-if="stationCar(station)" class="cc8-station-car" t-att-src="vehicleImage(stationCar(station))" alt=""/>
                      <div t-else="" class="cc8-empty-bay"><i class="fa fa-car"></i><span>جاهزة لاستقبال سيارة</span></div>
                      <div t-if="stationCar(station)" class="cc8-op-focus"><i t-att-class="'fa ' + operationIcon(focusedOperation(station).name)"></i><span t-esc="focusedOperation(station).name"></span></div>
                    </div>
                    <div t-if="stationCar(station)" class="cc8-vehicle-size"><i class="fa fa-car"></i><span t-esc="vehicleSizeLabel(stationCar(station))"></span><em t-esc="stationCar(station).public_reference or stationCar(station).name"></em></div>
                    <div t-if="stationCar(station)" class="cc8-op-tags"><t t-foreach="stationOperations(station)" t-as="op" t-key="op.id"><span t-att-class="'op-' + (op.kind || operationKind(op.name))"><i t-att-class="'fa ' + operationIcon(op.name)"></i><t t-esc="op.name"/></span></t></div>
                    <div t-if="!station.placeholder" class="cc8-station-foot"><span><i class="fa fa-play-circle"></i><t t-esc="station.in_progress"/> تشغيل</span><span><i class="fa fa-clock-o"></i><t t-esc="station.queue"/> انتظار</span></div>
                  </button>
                </t>
              </div>
            </section>

            <section class="cc8-dashboard-grid">
              <article class="cc8-card cc8-cars-table"><div class="cc8-section-head compact"><h3><i class="fa fa-list"></i> العمليات الحية</h3><button t-on-click="() => this.openKpi('active_total')">عرض الكل</button></div><div class="cc8-table-wrap"><table><thead><tr><th>#</th><th>اللوحة</th><th>الخدمة</th><th>المحطة</th><th>المرحلة</th><th>المدة</th><th>الحالة</th></tr></thead><tbody><t t-foreach="filteredCars" t-as="car" t-key="car.id"><tr t-on-click="() => this.openProduction(car.id)"><td t-esc="car_index + 1"></td><td class="plate" t-esc="car.public_reference or car.plate"></td><td t-esc="car.service_name"></td><td t-esc="car.workcenter_name or '—'"></td><td t-esc="car.current_stage"></td><td t-esc="carDurationLabel(car)"></td><td><span t-att-class="'cc8-status is-' + statusClass(car)" t-esc="statusLabel(car)"></span></td></tr></t><tr t-if="!filteredCars.length"><td colspan="7" class="empty">لا توجد سيارات مطابقة.</td></tr></tbody></table></div></article>
              <article class="cc8-card cc8-queue-panel"><div class="cc8-section-head compact"><h3><i class="fa fa-clock-o"></i> السيارات القادمة والانتظار</h3></div><div class="cc8-mini-cars"><t t-foreach="(state.data.upcoming || []).slice(0,5)" t-as="car" t-key="car.id"><button t-on-click="() => this.openProduction(car.id)"><img t-att-src="vehicleImage(car)" alt=""/><div><b t-esc="car.public_reference or car.name"></b><span t-esc="car.service_name"></span><small t-esc="remainingLabel(car)"></small></div></button></t><div t-if="!(state.data.upcoming || []).length" class="empty">لا توجد مواعيد قادمة حالياً.</div></div></article>
            </section>

            <section class="cc8-dashboard-bottom">
              <article class="cc8-card cc8-material-preview"><div class="cc8-section-head compact"><h3><i class="fa fa-cubes"></i> المواد</h3><button t-on-click="() => this.setPage('finance')">المواد والحسابات</button></div><div class="cc8-material-mini"><t t-foreach="displayMaterials.slice(0,5)" t-as="item" t-key="item.product_id"><button t-on-click="() => this.openProduct(item.product_id)"><b t-esc="item.product_name"></b><span><t t-esc="item.free"/> <t t-esc="item.uom"/></span><div><i t-att-style="materialStyle(item)"></i></div></button></t></div></article>
              <article class="cc8-card cc8-quick"><div class="cc8-section-head compact"><h3><i class="fa fa-bolt"></i> إجراءات سريعة</h3></div><div><button class="green" t-on-click="() => this.quickAction('start')"><i class="fa fa-play"></i> شاشة الغسيل</button><button class="blue" t-on-click="() => this.quickAction('pos')"><i class="fa fa-shopping-cart"></i> نقطة البيع</button><button class="purple" t-on-click="() => this.quickAction('customer')"><i class="fa fa-television"></i> شاشة الزبائن</button><button class="orange" t-on-click="() => this.quickAction('materials')"><i class="fa fa-cubes"></i> الحسابات</button></div></article>
            </section>
          </div>

          <!-- CUSTOMER SCREEN -->
          <div t-if="state.page === 'customers'" class="cc8-page cc8-customer-page">
            <section class="cc8-page-hero customer"><div><h1>شاشة الزبائن</h1><p>تابع حالة سيارتك مباشرة أثناء الاستراحة</p></div><div class="cc8-page-hero-actions"><span><i class="fa fa-wifi"></i> تحديث تلقائي</span><button t-on-click="toggleCustomerFullscreen"><i class="fa fa-expand"></i> ملء الشاشة</button></div></section>
            <section class="cc8-customer-kpis"><div><i class="fa fa-tint"></i><span>قيد الخدمة</span><b t-esc="state.data.customer_screen.washing_count"></b></div><div><i class="fa fa-clock-o"></i><span>في الانتظار</span><b t-esc="state.data.customer_screen.waiting_count"></b></div><div><i class="fa fa-check"></i><span>جاهزة للتسليم</span><b t-esc="state.data.customer_screen.ready_count"></b></div><div><i class="fa fa-hourglass-half"></i><span>متوسط الخدمة</span><b><t t-esc="state.data.customer_screen.avg_turnaround"/> د</b></div></section>
            <section t-if="customerFocusCar" class="cc8-customer-spotlight" t-att-class="'is-' + statusClass(customerFocusCar)"><div class="cc8-customer-spot-copy"><span>سيارتك الآن</span><h2 t-esc="customerFocusCar.public_reference or customerFocusCar.name"></h2><strong t-esc="statusLabel(customerFocusCar)"></strong><p><t t-esc="customerFocusCar.service_name"/> · <t t-esc="customerFocusCar.current_stage"/></p><div class="cc8-customer-progress"><i t-att-style="`--cc-customer-progress:${customerFocusCar.progress || 0}%`"></i></div><small><t t-esc="customerFocusCar.progress"/>% · <t t-esc="remainingLabel(customerFocusCar)"/></small></div><div class="cc8-customer-spot-car"><div class="cc8-glow"></div><img t-att-src="vehicleImage(customerFocusCar)" alt=""/><div class="cc8-customer-water"><i/><i/><i/><i/></div></div></section>
            <section class="cc8-customer-grid"><t t-foreach="customerCars" t-as="car" t-key="car.id"><article t-att-class="customerCardClass(car, car_index)" t-on-click="() => { state.customerFocusIndex = car_index }"><div class="head"><span t-att-class="'cc8-status is-' + statusClass(car)" t-esc="statusLabel(car)"></span><b t-esc="car.public_reference or car.name"></b></div><img t-att-src="vehicleImage(car)" alt=""/><h3 t-esc="car.service_name"></h3><p t-esc="car.current_stage"></p><div class="progress"><i t-att-style="`--cc-progress:${car.progress || 0}%`"></i></div><footer><span><t t-esc="car.progress"/>%</span><small t-esc="remainingLabel(car)"></small></footer></article></t><div t-if="!customerCars.length" class="cc8-empty-screen"><i class="fa fa-car"></i><h2>لا توجد سيارات قيد الخدمة الآن</h2><p>نتمنى لكم يومًا سعيدًا مع كريستال كلين.</p></div></section>
            <section class="cc8-customer-lounge"><div><img src="/car_wash_dashboard/static/src/img/v7/lounge.png" alt=""/></div><div><span>لأن راحتك تهمنا</span><h2>استمتع بوقتك في منطقة الانتظار</h2><p><i class="fa fa-wifi"></i> واي فاي · <i class="fa fa-coffee"></i> ضيافة · <i class="fa fa-television"></i> متابعة مباشرة</p></div><div class="cc8-ready-call"><i class="fa fa-bullhorn"></i><strong>السيارات الجاهزة</strong><t t-foreach="readyCars.slice(0,3)" t-as="car" t-key="car.id"><span t-esc="car.public_reference or car.name"></span></t></div></section>
          </div>

          <!-- MATERIALS & ACCOUNTS -->
          <div t-if="state.page === 'finance'" class="cc8-page cc8-finance-page">
            <section class="cc8-page-hero finance"><div><h1>المواد والحسابات</h1><p>المخزون والمبيعات والفواتير والذمم في مكان واحد</p></div><div class="cc8-finance-hero-art"><i class="fa fa-cubes"></i><i class="fa fa-line-chart"></i></div></section>
            <section class="cc8-fin-kpis"><div class="green"><i class="fa fa-shopping-cart"></i><span>مبيعات POS اليوم</span><b t-esc="formatMoney(state.data.finance_page.pos_revenue_today)"></b></div><div class="violet"><i class="fa fa-bar-chart"></i><span>مبيعات POS الشهر</span><b t-esc="formatMoney(state.data.finance_page.pos_month_revenue)"></b></div><div class="blue"><i class="fa fa-file-text-o"></i><span>فواتير العملاء اليوم</span><b t-esc="formatMoney(state.data.finance_page.customer_invoices_today)"></b></div><div class="red"><i class="fa fa-truck"></i><span>فواتير الموردين اليوم</span><b t-esc="formatMoney(state.data.finance_page.vendor_bills_today)"></b></div><div class="amber"><i class="fa fa-money"></i><span>ذمم العملاء</span><b t-esc="formatMoney(state.data.finance_page.receivable_open)"></b></div><div class="cyan"><i class="fa fa-cubes"></i><span>قيمة المخزون التقريبية</span><b t-esc="formatMoney(state.data.stock_value)"></b></div></section>
            <section class="cc8-fin-grid-top"><article class="cc8-card cc8-week-chart"><div class="cc8-section-head compact"><h3>مبيعات نقطة البيع - آخر 7 أيام</h3></div><div class="cc8-bars"><t t-foreach="state.data.finance_page.week_pos_sales" t-as="item" t-key="item.label"><div><span t-esc="formatMoney(item.amount)"></span><i t-att-style="financeBarStyle(item)"></i><b t-esc="item.label"></b></div></t></div></article><article class="cc8-card cc8-expenses"><div class="cc8-section-head compact"><h3>توزيع المصروفات الشهرية</h3></div><t t-foreach="state.data.finance_page.expense_breakdown" t-as="item" t-key="item.name"><div class="cc8-exp-row"><span t-esc="item.name"></span><div><i t-att-style="expenseStyle(item)"></i></div><b t-esc="formatMoney(item.amount)"></b></div></t><div t-if="!state.data.finance_page.expense_breakdown.length" class="empty">لا توجد مصروفات مرحلة في الفترة.</div></article></section>
            <section class="cc8-card cc8-material-full"><div class="cc8-section-head"><div><h2><i class="fa fa-cubes"></i> المواد والمخزون</h2><p>الكميات الحرة والمحجوزة من المواد المرتبطة بوصفات الغسيل</p></div><button t-on-click="openMaterials">فتح المنتجات</button></div><div class="cc8-material-cards"><t t-foreach="displayMaterials" t-as="item" t-key="item.product_id"><button t-on-click="() => this.openProduct(item.product_id)"><div class="icon"><i class="fa fa-flask"></i></div><strong t-esc="item.product_name"></strong><b><t t-esc="item.free"/> <t t-esc="item.uom"/></b><span>محجوز: <t t-esc="item.reserved"/></span><div class="bar"><i t-att-style="materialStyle(item)"></i></div><small><t t-esc="materialPct(item)"/>%</small></button></t></div></section>
            <section class="cc8-card cc8-moves"><div class="cc8-section-head"><h2><i class="fa fa-file-text-o"></i> آخر الحركات المحاسبية</h2><button t-on-click="openAccounting">فتح المحاسبة</button></div><div class="cc8-table-wrap"><table><thead><tr><th>#</th><th>التاريخ</th><th>النوع</th><th>البيان</th><th>الشريك</th><th>المبلغ</th></tr></thead><tbody><t t-foreach="state.data.finance_page.recent_moves" t-as="move" t-key="move.id"><tr t-on-click="() => this.openAccountingMove(move.id)"><td t-esc="move_index + 1"></td><td t-esc="move.date"></td><td t-esc="move.type"></td><td t-esc="move.name"></td><td t-esc="move.partner or '—'"></td><td t-esc="formatMoney(move.amount)"></td></tr></t></tbody></table></div></section>
          </div>

          <!-- POS PAGE -->
          <div t-if="state.page === 'pos'" class="cc8-page cc8-pos-page">
            <section class="cc8-page-hero pos"><div><h1>نقطة البيع</h1><p>طلبات الغسيل هي نقطة البداية الفعلية لدورة السيارة</p></div><button class="cc8-launch-pos" t-on-click="openPosApp"><i class="fa fa-play"></i> فتح نقطة البيع</button></section>
            <section class="cc8-pos-kpis"><div><i class="fa fa-shopping-cart"></i><span>طلبات اليوم</span><b t-esc="state.data.pos_page.orders_today"></b></div><div><i class="fa fa-money"></i><span>مبيعات اليوم</span><b t-esc="formatMoney(state.data.pos_page.revenue_today)"></b></div><div><i class="fa fa-ticket"></i><span>متوسط الطلب</span><b t-esc="formatMoney(state.data.pos_page.avg_ticket)"></b></div><div><i class="fa fa-users"></i><span>عملاء مسجلون</span><b t-esc="state.data.pos_page.customers_today"></b></div><div><i class="fa fa-calendar"></i><span>مبيعات الشهر</span><b t-esc="formatMoney(state.data.pos_page.month_revenue)"></b></div></section>
            <section class="cc8-pos-grid"><article class="cc8-card cc8-pos-orders"><div class="cc8-section-head"><h2>طلبات الغسيل اليوم</h2><button t-on-click="openPosOrders">عرض الكل</button></div><div class="cc8-table-wrap"><table><thead><tr><th>#</th><th>الطلب</th><th>الوقت</th><th>العميل</th><th>اللوحة</th><th>الخدمات</th><th>المبلغ</th><th>الحالة</th></tr></thead><tbody><t t-foreach="state.data.pos_page.orders" t-as="row" t-key="row.id"><tr t-on-click="() => this.openPosOrder(row)"><td t-esc="row_index + 1"></td><td t-esc="row.name"></td><td t-esc="row.time"></td><td t-esc="row.customer"></td><td class="plate" t-esc="row.plate"></td><td><span class="cc8-service-list" t-esc="row.services.join(' + ')"></span></td><td t-esc="formatMoney(row.amount)"></td><td><span class="cc8-status is-ready" t-esc="row.wash_status"></span></td></tr></t><tr t-if="!state.data.pos_page.orders.length"><td colspan="8" class="empty">لا توجد طلبات غسيل مدفوعة اليوم.</td></tr></tbody></table></div></article><article class="cc8-card cc8-pos-side"><div class="cc8-section-head compact"><h3>المبيعات حسب الساعة</h3></div><div class="cc8-hour-chart"><t t-foreach="state.data.pos_page.hourly" t-as="item" t-key="item.label"><div><i t-att-style="posHourStyle(item)"></i><b t-esc="item.label"></b><span t-esc="formatMoney(item.amount)"></span></div></t></div><div class="cc8-section-head compact"><h3>أفضل الخدمات اليوم</h3></div><div class="cc8-top-services"><t t-foreach="state.data.pos_page.top_services" t-as="item" t-key="item.name"><div><span><b t-esc="item.name"></b><small><t t-esc="item.qty"/> خدمة</small></span><div><i t-att-style="topServiceStyle(item)"></i></div><em t-esc="formatMoney(item.amount)"></em></div></t></div></article></section>
          </div>

          <footer class="cc8-footer"><span><strong>كريستال كلين</strong> · مركز التشغيل الذكي</span><span>آخر تحديث <t t-esc="state.lastUpdate or '—'"/></span><span class="ok"><i></i> V8 LIVE SHOW · النظام يعمل بشكل طبيعي</span></footer>
        </main>
      </div>
    </div>
  </t>
</templates>
