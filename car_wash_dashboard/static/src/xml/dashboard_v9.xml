<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="car_wash_dashboard.DashboardV9">
  <div class="cc9-root" dir="rtl">
    <div t-if="state.loading" class="cc9-loader"><i class="fa fa-car"></i><strong>يتم تجهيز كريستال كلين...</strong><span></span></div>
    <div t-else="" class="cc9-shell">
      <aside class="cc9-sidebar">
        <div class="cc9-brand"><i class="fa fa-tint"></i><div><b>كريستال كلين</b><span>حلول العناية بالسيارات</span></div></div>
        <nav>
          <button t-att-class="state.page === 'dashboard' ? 'active' : ''" t-on-click="() => this.setPage('dashboard')"><i class="fa fa-home"></i><span>الرئيسية</span></button>
          <button t-att-class="state.page === 'appointments' ? 'active' : ''" t-on-click="() => this.setPage('appointments')"><i class="fa fa-calendar-check-o"></i><span>المواعيد</span></button>
          <button t-att-class="state.page === 'stations' ? 'active' : ''" t-on-click="() => this.setPage('stations')"><i class="fa fa-th-large"></i><span>المحطات</span></button>
          <button t-att-class="state.page === 'clients' ? 'active' : ''" t-on-click="() => this.setPage('clients')"><i class="fa fa-users"></i><span>العملاء والموارد البشرية</span></button>
          <button t-att-class="state.page === 'finance' ? 'active' : ''" t-on-click="() => this.setPage('finance')"><i class="fa fa-cube"></i><span>المواد والحسابات</span></button>
          <button t-att-class="state.page === 'pos' ? 'active' : ''" t-on-click="() => this.setPage('pos')"><i class="fa fa-credit-card"></i><span>نقطة البيع</span></button>
          <button t-att-class="state.page === 'customers' ? 'active' : ''" t-on-click="() => this.setPage('customers')"><i class="fa fa-television"></i><span>شاشة الزبائن</span></button>
        </nav>
        <div class="cc9-side-promo"><img src="/car_wash_dashboard/static/src/img/v9/side_promo.png" alt=""/><b>كريستال كلين</b><span>أكثر من مغسلة<br/>تجربة مميزة</span></div>
      </aside>

      <main class="cc9-main">
        <header class="cc9-topbar">
          <div class="cc9-user"><span class="avatar" t-esc="userInitial"></span><div><b t-esc="state.data.current_user_name or 'المستخدم الحالي'"></b><small t-esc="userSubLabel"></small></div></div>
          <div class="cc9-clock"><small t-esc="dateLabel"></small><b><i class="fa fa-clock-o"></i> <t t-esc="timeLabel"/></b></div>
          <label class="cc9-search"><i class="fa fa-search"></i><input t-att-value="state.query" t-on-input="onSearchInput" placeholder="ابحث عن سيارة، رقم لوحة، عميل، مادة، فاتورة أو مورد ..."/></label>
          <div class="cc9-wordmark"><span class="bubbles">○ ◯</span><div><b>كريستال كلين</b><small>حلول العناية بالسيارات</small></div><i class="fa fa-tint"></i></div>
        </header>

        <!-- MAIN PAGE - V9.1 APPROVED EXACT SCREEN -->
        <section t-if="state.page === 'dashboard'" class="cc9-page cc9-page-dashboard cc91-main-page">
          <div class="cc91-hero">
            <div class="cc91-hero-car"><img src="/car_wash_dashboard/static/src/img/v9/main_exact/hero_main.webp" alt=""/></div>
            <div class="cc91-hero-left-copy"><span>سيارتك</span><b>تستحق الأفضل</b></div>
            <div class="cc91-hero-title"><h1>لوحة تحكم المغسلة</h1><p>إدارة العمليات والمحطات لحظة بلحظة</p></div>
            <div class="cc91-hero-slogan"><span>نظافة أكثر</span><b>لحياة أجمل</b></div>
            <div class="cc91-bubbles"><i/><i/><i/><i/></div>
          </div>

          <div class="cc91-kpis">
            <button class="cc91-kpi kpi-completion" t-on-click="() => this.openKpi('done_today')">
              <div class="cc91-ring" t-att-style="completionRingStyle()"><b><t t-esc="completionRate"/>%</b></div>
              <div><b>نسبة الإنجاز</b><small><t t-esc="state.data.done_today"/> من <t t-esc="state.data.total_today"/> اليوم</small></div>
              <i class="fa fa-bar-chart"></i>
            </button>
            <button class="cc91-kpi" t-on-click="() => this.openKpi('total_today')"><i class="fa fa-bar-chart violet"></i><div><b>إجمالي اليوم</b><strong t-esc="state.data.total_today"></strong><small>سيارة تم غسلها</small></div></button>
            <button class="cc91-kpi" t-on-click="() => this.openKpi('in_progress')"><i class="fa fa-check-circle green"></i><div><b>قيد الخدمة الآن</b><strong t-esc="state.data.in_progress"></strong><small>سيارة</small></div></button>
            <button class="cc91-kpi" t-on-click="() => this.openKpi('waiting')"><i class="fa fa-clock-o blue"></i><div><b>في الانتظار</b><strong t-esc="state.data.waiting"></strong><small>سيارات</small></div></button>
            <button class="cc91-kpi" t-on-click="() => this.openKpi('ready_delivery')"><i class="fa fa-car orange"></i><div><b>جاهزة للتسليم</b><strong t-esc="state.data.ready_delivery"></strong><small>سيارات</small></div></button>
            <button class="cc91-kpi" t-on-click="() => this.setPage('pos')"><i class="fa fa-database cyan"></i><div><b>إيرادات اليوم</b><strong t-esc="formatMoney(state.data.pos_page.revenue_today)"></strong><small>من نقطة البيع</small></div></button>
          </div>

          <article class="cc91-stations-panel">
            <div class="cc91-station-head">
              <div class="cc91-station-title-right"><span class="cc91-badge-b">B</span><h2>إدارة المحطات (10)</h2></div>
              <div class="cc91-station-title-left"><i class="fa fa-bullseye"></i><h2>المحطات العاملة</h2><small>متابعة مباشرة لحالة كل محطة والخدمات قيد التنفيذ</small></div>
              <div class="cc91-station-head-actions"><span class="cc91-live"><i></i> مباشر</span><button t-on-click="openShopFloor">فتح شاشة التشغيل</button></div>
            </div>
            <div class="cc91-stations-grid">
              <t t-foreach="stationSlots" t-as="station" t-key="station.id">
                <button t-att-class="'cc91-station kind-' + stationKind(station) + ' status-' + stationStatus(station)" t-on-click="() => this.openWorkcenter(station)">
                  <div class="cc91-station-top">
                    <span t-att-class="'cc91-status ' + stationStatus(station)"><i></i><t t-esc="stationStatusLabel(station)"/></span>
                    <b>
                      <t t-if="stationKind(station) === 'auto'">محطة الغسيل الآلي</t>
                      <t t-elif="stationKind(station) === 'polish'">محطة اللمعة</t>
                      <t t-else="">المحطة <t t-esc="station.slot"/></t>
                    </b>
                  </div>
                  <div t-att-class="'cc91-station-scene op-' + focusedOperation(station).kind + (!stationCar(station) ? ' is-idle' : '')">
                    <img t-att-src="stationArtwork(station)" class="cc91-station-art" alt=""/>
                    <div t-if="stationCar(station)" class="cc91-fx">
                      <div class="wash-drops"><i/><i/><i/><i/><i/></div><div class="foam"><i/><i/><i/><i/></div><div class="sparkles"><i/><i/><i/><i/></div><div class="vacuum"><i class="fa fa-circle-o-notch"></i></div><div class="brushes"><i/><i/></div>
                    </div>
                    <div t-if="!stationCar(station)" class="cc91-idle-mask"><i class="fa fa-car"></i><span t-esc="stationIdleLabel(station)"></span></div>
                  </div>
                  <div t-if="stationCar(station)" class="cc91-size-pill"><i class="fa fa-car"></i><span t-esc="vehicleSizeLabel(stationCar(station))"></span></div>
                  <div t-if="stationCar(station)" class="cc91-operation-chips"><t t-foreach="stationOperations(station).slice(0,4)" t-as="op" t-key="op.id"><span t-att-class="'kind-' + operationKind(op.name)"><i t-att-class="'fa ' + operationIcon(op.name)"></i><t t-esc="op.name"/></span></t></div>
                  <div t-else="" t-att-class="'cc91-operation-chips idle kind-' + stationKind(station)"><span><i t-att-class="stationKind(station) === 'auto' ? 'fa fa-cogs' : stationKind(station) === 'polish' ? 'fa fa-diamond' : 'fa fa-check-circle'"></i><t t-esc="stationIdleLabel(station)"/></span></div>
                </button>
              </t>
            </div>
          </article>

          <div class="cc91-bottom-grid">
            <article class="cc91-bottom-card cc91-live-ops">
              <div class="cc91-bottom-head"><h3>العمليات الحية <span class="cc91-live"><i></i> مباشر</span></h3><button t-on-click="openVehicles">عرض الكل</button></div>
              <table><thead><tr><th>#</th><th>رقم اللوحة</th><th>نوع الخدمة</th><th>المحطة</th><th>وقت الدخول</th><th>المدة</th></tr></thead><tbody><t t-foreach="filteredCars.slice(0,5)" t-as="car" t-key="car.id"><tr t-on-click="() => this.openProduction(car.id)"><td t-esc="car_index + 1"></td><td class="plate" t-esc="car.public_reference or car.plate"></td><td t-esc="car.service_name"></td><td t-esc="car.workcenter_name or '—'"></td><td t-esc="car.started_at or '—'"></td><td t-esc="carDurationLabel(car)"></td></tr></t><tr t-if="!filteredCars.length"><td colspan="6" class="empty-row">لا توجد عمليات حية الآن</td></tr></tbody></table>
            </article>
            <article class="cc91-bottom-card cc91-current-cars">
              <div class="cc91-bottom-head"><h3>السيارات الحالية في المغسلة (<t t-esc="state.data.active_total"/>)</h3></div>
              <div class="cc91-current-summary"><button t-on-click="() => this.openKpi('in_progress')"><b t-esc="state.data.in_progress"></b><span>قيد الغسيل</span><i class="fa fa-tint"></i></button><button t-on-click="() => this.openKpi('waiting')"><b t-esc="state.data.waiting"></b><span>في الانتظار</span><i class="fa fa-clock-o"></i></button><button t-on-click="() => this.openKpi('ready_delivery')"><b t-esc="state.data.ready_delivery"></b><span>جاهزة للتسليم</span><i class="fa fa-car"></i></button></div>
              <div class="cc91-car-strip"><t t-foreach="filteredCars.slice(0,4)" t-as="car" t-key="car.id"><button t-on-click="() => this.openProduction(car.id)"><img t-att-src="vehicleImage(car)"/><b t-esc="car.public_reference or car.name"></b><small t-esc="car.current_stage"></small></button></t><div t-if="!filteredCars.length" class="cc91-empty-cars"><i class="fa fa-car"></i><span>لا توجد سيارات داخل المغسلة حالياً</span></div></div>
            </article>
            <article class="cc91-bottom-card cc91-materials">
              <div class="cc91-bottom-head"><h3>المخزون والمواد</h3><button t-on-click="() => this.setPage('finance')">عرض الكل</button></div>
              <t t-foreach="displayMaterials.slice(0,3)" t-as="item" t-key="item.product_id"><button class="cc91-material-line" t-on-click="() => this.openProduct(item.product_id)"><span><i t-att-class="item_index === 0 ? 'green' : item_index === 1 ? 'violet' : 'orange'"></i><t t-esc="item.product_name"/></span><div><i t-att-style="materialStyle(item)"></i></div><b><t t-esc="materialPct(item)"/>%</b></button></t><div t-if="!displayMaterials.length" class="cc91-empty-materials">لا توجد مواد معرفة بعد</div>
              <footer><button class="green" t-on-click="openMaterials">طلبات مواد</button><button class="blue" t-on-click="() => this.setPage('pos')">نقطة البيع</button><button class="violet" t-on-click="openCustomers">إضافة عميل</button><button class="orange" t-on-click="openAccounting">تقرير سريع</button></footer>
            </article>
          </div>
        </section>

        <!-- VEHICLES PAGE -->
        <section t-if="state.page === 'vehicles'" class="cc9-page cc10-page cc10-vehicles">
          <div class="cc10-title-row"><div><h1>السيارات داخل المغسلة</h1><p>متابعة كل سيارة وتفاصيل رحلة الخدمة لحظة بلحظة</p></div><button class="cc10-primary" t-on-click="openPosApp"><i class="fa fa-plus"></i> إضافة سيارة</button></div>
          <div class="cc10-filter-tabs"><button t-att-class="state.vehicleFilter === 'all' ? 'active' : ''" t-on-click="() => this.setVehicleFilter('all')">الكل (<t t-esc="filteredCars.length"/>)</button><button t-att-class="state.vehicleFilter === 'service' ? 'active' : ''" t-on-click="() => this.setVehicleFilter('service')">في المغسلة (<t t-esc="state.data.in_progress"/>)</button><button t-att-class="state.vehicleFilter === 'waiting' ? 'active' : ''" t-on-click="() => this.setVehicleFilter('waiting')">في الانتظار (<t t-esc="state.data.waiting"/>)</button><button t-att-class="state.vehicleFilter === 'ready' ? 'active' : ''" t-on-click="() => this.setVehicleFilter('ready')">جاهزة (<t t-esc="state.data.ready_delivery"/>)</button></div>
          <div class="cc10-vehicle-layout">
            <article class="cc10-panel cc10-vehicle-list"><t t-foreach="vehiclePageCars" t-as="car" t-key="car.id"><button t-att-class="selectedCar &amp;&amp; selectedCar.id === car.id ? 'selected' : ''" t-on-click="() => this.selectCar(car.id)"><span class="cc10-num" t-esc="car_index + 1"></span><img t-att-src="vehicleImage(car)"/><span class="cc10-car-info"><b t-esc="car.public_reference or car.plate"></b><small t-esc="car.vehicle_model or car.service_name"></small></span><span class="cc10-stage"><b t-esc="car.current_stage"></b><i class="cc10-progress"><em t-att-style="progressStyle(car.progress)"></em></i></span><span class="cc10-time"><b t-esc="carDurationLabel(car)"></b><small t-esc="remainingLabel(car)"></small></span></button></t><div t-if="!vehiclePageCars.length" class="cc10-empty">لا توجد سيارات مطابقة حالياً.</div></article>
            <article class="cc10-panel cc10-car-detail" t-if="selectedCar"><h2>تفاصيل السيارة</h2><img class="cc10-detail-car" t-att-src="vehicleImage(selectedCar)"/><h3 t-esc="selectedCar.public_reference or selectedCar.plate"></h3><p t-esc="selectedCar.vehicle_model or selectedCar.service_name"></p><div class="cc10-contact"><span><i class="fa fa-user"></i><b t-esc="selectedCar.customer or 'عميل نقدي'"></b></span><span><i class="fa fa-phone"></i><b t-esc="selectedCar.customer_phone or '—'"></b></span></div><div class="cc10-journey"><t t-foreach="['استقبال','انتظار','غسيل','تنظيف داخلي','تلميع','فحص نهائي','تسليم']" t-as="label" t-key="label"><span t-att-class="label_index &lt; customerStageIndex(selectedCar) ? 'done' : label_index === customerStageIndex(selectedCar) ? 'current' : ''"><i></i><b t-esc="label"></b></span></t></div><div class="cc10-detail-actions"><button t-on-click="() => this.openProduction(selectedCar.id)">فتح أمر الغسيل</button><button class="light" t-if="selectedCar.customer_id" t-on-click="() => this.openPartner(selectedCar.customer_id)">العميل</button></div></article>
          </div>
        </section>

        <!-- APPOINTMENTS PAGE -->
        <section t-if="state.page === 'appointments'" class="cc9-page cc10-page cc10-appointments">
          <div class="cc10-title-row"><div><h1>المواعيد والطابور القادم</h1><p>الحجوزات القادمة وحالة الانتظار والتأخير</p></div><button class="cc10-primary" t-on-click="openPosApp"><i class="fa fa-calendar-plus-o"></i> إضافة موعد</button></div>
          <div class="cc10-kpi-row"><article><i class="fa fa-calendar blue"></i><span>مواعيد اليوم</span><b t-esc="appointmentRows.length"></b></article><article><i class="fa fa-hourglass-half cyan"></i><span>في الانتظار</span><b t-esc="appointmentWaiting"></b></article><article><i class="fa fa-fire red"></i><span>متأخر</span><b t-esc="appointmentLate"></b></article><article><i class="fa fa-check-square-o green"></i><span>مكتمل</span><b t-esc="appointmentCompleted"></b></article></div>
          <article class="cc10-panel cc10-table-panel"><table><thead><tr><th>الوقت</th><th>العميل</th><th>السيارة</th><th>الخدمة</th><th>الحالة</th><th>التأخير</th><th>المحطة المتوقعة</th></tr></thead><tbody><t t-foreach="appointmentRows" t-as="car" t-key="car.id"><tr t-on-click="() => this.openProduction(car.id)"><td t-esc="car.started_at or car.scheduled_date or '—'"></td><td t-esc="car.customer or 'عميل نقدي'"></td><td><b t-esc="car.vehicle_model or car.public_reference"></b></td><td t-esc="car.service_name"></td><td><span t-att-class="'cc10-badge ' + appointmentStatus(car).code" t-esc="appointmentStatus(car).label"></span></td><td><span t-if="appointmentStatus(car).code === 'late'" class="late">متأخر</span><span t-else="">—</span></td><td t-esc="car.workcenter_name or 'تحدد عند الدخول'"></td></tr></t><tr t-if="!appointmentRows.length"><td colspan="7" class="cc10-empty">لا توجد حجوزات قادمة حالياً.</td></tr></tbody></table></article>
        </section>

        <!-- STATIONS PAGE -->
        <section t-if="state.page === 'stations'" class="cc9-page cc10-page cc10-stations">
          <div class="cc10-title-row"><div><h1>إدارة المحطات</h1><p>التشغيل المباشر وكفاءة كل محطة</p></div><div class="cc10-legend"><span class="free"><i></i> متاحة</span><span class="busy"><i></i> تعمل</span><span class="queue"><i></i> منتظرة</span></div></div>
          <div class="cc10-station-layout"><div class="cc10-station-grid"><t t-foreach="stationSlots" t-as="station" t-key="station.id"><button t-att-class="'cc10-station-tile ' + stationStatus(station) + (selectedStation &amp;&amp; selectedStation.id === station.id ? ' selected' : '')" t-on-click="() => this.selectStation(station.id)"><header><b t-esc="station.slot"></b><span t-esc="stationStatusLabel(station)"></span></header><img t-att-src="stationCar(station) ? vehicleImage(stationCar(station)) : '/car_wash_dashboard/static/src/img/car_sedan.svg'"/><strong><t t-if="stationKind(station) === 'auto'">غسيل آلي</t><t t-elif="stationKind(station) === 'polish'">لمعة</t><t t-else="" t-esc="stationCar(station) ? focusedOperation(station).name : 'متاحة'"></t></strong><small t-esc="stationCar(station) ? stationCar(station).public_reference : 'جاهزة'"/></button></t></div><article class="cc10-panel cc10-station-detail" t-if="selectedStation"><h2>تفاصيل المحطة <t t-esc="selectedStation.slot"/></h2><img t-att-src="stationCar(selectedStation) ? vehicleImage(stationCar(selectedStation)) : '/car_wash_dashboard/static/src/img/car_sedan.svg'"/><div class="cc10-station-meta"><span><small>حالة المحطة</small><b t-esc="stationStatusLabel(selectedStation)"></b></span><span><small>كفاءة اليوم</small><b><t t-esc="selectedStation.efficiency || 0"/>%</b></span><span><small>السيارات المنجزة</small><b t-esc="selectedStation.done_today || 0"></b></span><span><small>الطابور</small><b t-esc="selectedStation.queue || 0"></b></span></div><button class="cc10-primary full" t-on-click="() => this.openWorkcenter(selectedStation)">فتح أوامر المحطة</button></article></div>
        </section>

        <!-- CLIENTS PAGE -->
        <section t-if="state.page === 'clients'" class="cc9-page cc10-page cc10-clients cc103-clients">
          <div class="cc10-title-row"><div><h1>العملاء والموارد البشرية</h1><p>إدارة العملاء والمستخدمين والورديات في صفحة تشغيل واحدة</p></div><div class="cc103-title-actions"><button class="cc10-primary" t-on-click="openCustomerList"><i class="fa fa-user-plus"></i> إضافة عميل</button><button class="cc10-primary light" t-on-click="openUsersList"><i class="fa fa-users"></i> المستخدمون</button></div></div>
          <div class="cc10-kpi-row cc103-six-kpis">
            <article><i class="fa fa-users green"></i><span>إجمالي العملاء</span><b t-esc="state.data.client_hr_page.total_customers"></b></article>
            <article><i class="fa fa-user-plus blue"></i><span>عملاء هذا الشهر</span><b t-esc="state.data.client_hr_page.new_customers_month"></b></article>
            <article><i class="fa fa-user-circle cyan"></i><span>المستخدمون النشطون</span><b t-esc="state.data.client_hr_page.total_users"></b></article>
            <article><i class="fa fa-id-badge violet"></i><span>عمال المحطات</span><b t-esc="state.data.client_hr_page.station_workers"></b></article>
            <article><i class="fa fa-calendar purple"></i><span>الورديات اليوم</span><b t-esc="state.data.client_hr_page.shift_count"></b></article>
            <article><i class="fa fa-line-chart orange"></i><span>متابعة الحضور</span><b><t t-esc="state.data.client_hr_page.attendance_rate"/>%</b></article>
          </div>
          <div class="cc103-split-grid">
            <article class="cc10-panel cc103-table-panel">
              <div class="cc103-panel-head"><h2>قائمة العملاء</h2><div><button t-on-click="openCustomerList">عرض الكل</button></div></div>
              <table><thead><tr><th>#</th><th>العميل</th><th>السيارة</th><th>الجوال</th><th>آخر زيارة</th><th>عدد الفواتير</th><th>الحالة</th></tr></thead><tbody><t t-foreach="clientHrRows.slice(0,6)" t-as="row" t-key="row.id"><tr t-on-click="() => this.openPartner(row.id)"><td t-esc="row_index + 1"></td><td><b t-esc="row.name"></b></td><td t-esc="row.favorite_service or '—'"></td><td t-esc="row.phone or '—'"></td><td t-esc="row.last_visit or '—'"></td><td t-esc="row.visits"></td><td><span t-att-class="row.visits &gt; 1 ? 'cc10-badge good' : 'cc10-badge waiting'" t-esc="row.visits &gt; 1 ? 'نشط' : 'جديد'"></span></td></tr></t><tr t-if="!clientHrRows.length"><td colspan="7" class="cc10-empty">لا توجد بيانات عملاء كافية حتى الآن.</td></tr></tbody></table>
            </article>
            <article class="cc10-panel cc103-table-panel">
              <div class="cc103-panel-head"><h2>المستخدمون والموظفون</h2><div><button t-on-click="openUsersList">عرض الكل</button></div></div>
              <table><thead><tr><th>#</th><th>الاسم</th><th>الدور الوظيفي</th><th>المحطة / القسم</th><th>الوردية</th><th>الحالة</th></tr></thead><tbody><t t-foreach="hrUserRows.slice(0,6)" t-as="row" t-key="row.id"><tr><td t-esc="row_index + 1"></td><td><b t-esc="row.name"></b></td><td t-esc="row.role"></td><td t-esc="row.station or row.department"></td><td t-esc="row.shift"></td><td><span t-att-class="'cc10-badge ' + staffStatusClass(row)" t-esc="row.status_label"></span></td></tr></t><tr t-if="!hrUserRows.length"><td colspan="6" class="cc10-empty">لا توجد بيانات موارد بشرية حالياً.</td></tr></tbody></table>
            </article>
          </div>
          <div class="cc103-bottom-grid">
            <article class="cc10-panel cc103-shifts-panel"><div class="cc103-panel-head"><h2>الورديات والحضور اليوم</h2><div><button>عرض الكل</button></div></div><div class="cc103-shift-rows"><t t-foreach="state.data.client_hr_page.shift_rows" t-as="shift" t-key="shift.name"><div class="cc103-shift-row"><span class="icon"><i class="fa fa-users"></i></span><div><b t-esc="shift.name"></b><small><t t-esc="shift.present"/> / <t t-esc="shift.total"/> حاضر</small></div><i class="cc10-progress"><em t-att-style="shiftBarStyle(shift)"></em></i><strong><t t-esc="shift.pct"/>%</strong></div></t><div t-if="!state.data.client_hr_page.shift_rows.length" class="cc10-empty">لا توجد ورديات مسجلة اليوم.</div></div></article>
            <article class="cc10-panel cc103-top-customers"><div class="cc103-panel-head"><h2>أهم العملاء</h2><div><button t-on-click="openCustomerList">عرض الكل</button></div></div><table><thead><tr><th>#</th><th>العميل</th><th>عدد الزيارات</th></tr></thead><tbody><t t-foreach="topCustomerRows" t-as="row" t-key="row.id"><tr t-on-click="() => this.openPartner(row.id)"><td t-esc="row_index + 1"></td><td><b t-esc="row.name"></b></td><td t-esc="row.visits"></td></tr></t><tr t-if="!topCustomerRows.length"><td colspan="3" class="cc10-empty">لا توجد بيانات كافية.</td></tr></tbody></table></article>
            <article class="cc10-panel cc103-quick-actions"><div class="cc103-panel-head"><h2>إجراءات سريعة</h2></div><div class="cc103-actions"><button class="green" t-on-click="openCustomerList"><i class="fa fa-user-plus"></i> إضافة عميل</button><button class="blue" t-on-click="openUsersList"><i class="fa fa-users"></i> إضافة مستخدم</button><button class="violet" t-on-click="openShopFloor"><i class="fa fa-calendar"></i> تعيين وردية</button><button class="orange" t-on-click="openCustomers"><i class="fa fa-id-card"></i> طباعة بطاقة</button></div></article>
          </div>
        </section>

        <!-- FINANCE/MATERIALS PAGE -->
        <section t-if="state.page === 'finance'" class="cc9-page cc10-page cc10-finance cc103-finance-page">
          <div class="cc103-fin-hero">
            <div class="cc103-fin-hero-car"><img src="/car_wash_dashboard/static/src/img/v9/main_exact/hero_main.webp" alt=""/></div>
            <div class="cc103-fin-left-copy"><span>مواد أفضل</span><b>لخدمة أكثر تميزاً</b></div>
            <div class="cc103-fin-title"><h1>المواد والحسابات</h1><p>إدارة المخزون والمشتريات والمصروفات والإيرادات في مكان واحد</p></div>
            <div class="cc103-fin-right-copy"><span>مخزون منظم</span><b>وحسابات دقيقة</b><em>لمستقبل أنظف</em></div>
            <div class="cc103-fin-bubbles"><i/><i/><i/><i/></div>
          </div>
          <div class="cc10-kpi-row cc103-five-kpis">
            <article><i class="fa fa-line-chart green"></i><span>صافي اليوم</span><b t-esc="formatMoney(state.data.finance_page.net_today)"></b><small>بعد خصم المصروفات</small></article>
            <article><i class="fa fa-area-chart red"></i><span>المصروفات</span><b t-esc="formatMoney(state.data.finance_page.expense_today)"></b><small>مصاريف هذا اليوم</small></article>
            <article><i class="fa fa-credit-card blue"></i><span>المقبوضات</span><b t-esc="formatMoney(state.data.finance_page.collected_today)"></b><small>إجمالي المدفوعات اليوم</small></article>
            <article><i class="fa fa-bar-chart violet"></i><span>إيرادات الشهر</span><b t-esc="formatMoney(state.data.pos_page.month_revenue)"></b><small>إجمالي إيرادات الشهر</small></article>
            <article><i class="fa fa-database cyan"></i><span>إيرادات اليوم</span><b t-esc="formatMoney(state.data.pos_page.revenue_today)"></b><small>من جميع الخدمات</small></article>
          </div>
          <div class="cc103-fin-middle">
            <article class="cc10-panel cc103-week-sales"><div class="cc103-panel-head"><h2>إيرادات الأسبوع الماضي</h2><div><button>آخر 7 أيام</button></div></div><div class="cc103-bar-chart"><t t-foreach="state.data.finance_page.week_pos_sales" t-as="item" t-key="item.label"><div><b t-esc="formatMoney(item.amount)"></b><i t-att-style="financeBarStyle(item)"></i><span t-esc="item.label"></span></div></t><div t-if="!state.data.finance_page.week_pos_sales.length" class="cc10-empty">لا توجد بيانات كافية بعد.</div></div></article>
            <article class="cc10-panel cc103-expenses"><div class="cc103-panel-head"><h2>توزيع المصروفات</h2><div><button>هذا الشهر</button></div></div><div class="cc103-expense-body"><div class="cc103-donut"><div class="cc103-donut-ring"></div><div class="cc103-donut-center"><b t-esc="formatMoney(expenseTotal())"></b><small>إجمالي المصروفات</small></div></div><ul><t t-foreach="state.data.finance_page.expense_breakdown" t-as="item" t-key="item.name"><li><span><i></i><t t-esc="item.name"/></span><b><t t-esc="expenseShare(item)"/>%</b></li></t><li t-if="!state.data.finance_page.expense_breakdown.length" class="empty">لا توجد مصروفات مصنفة بعد.</li></ul></div></article>
            <article class="cc10-panel cc103-fin-art"><img src="/car_wash_dashboard/static/src/img/v9/finance_material_art.webp" alt=""/><div><b>مواد عالية الجودة</b><strong>لنتائج استثنائية</strong><span>مخزون متوفر دائماً</span><span>تكلفة محسنة</span><span>جودة مضمونة</span></div></article>
          </div>
          <article class="cc10-panel cc103-materials-band"><div class="cc103-panel-head"><h2>المواد والمخزون</h2><div><button t-on-click="openMaterials">عرض الكل</button></div></div><div class="cc103-material-cards"><t t-foreach="displayMaterials.slice(0,6)" t-as="item" t-key="item.product_id"><button t-on-click="() => this.openProduct(item.product_id)" t-att-class="'cc103-material-card ' + (item.burn_status || 'good')"><img t-att-src="item_index === 0 ? '/car_wash_dashboard/static/src/img/v9/ready.png' : item_index === 1 ? '/car_wash_dashboard/static/src/img/v9/wait.png' : item_index === 2 ? '/car_wash_dashboard/static/src/img/v9/qc.png' : item_index === 3 ? '/car_wash_dashboard/static/src/img/v9/auto_wash.png' : item_index === 4 ? '/car_wash_dashboard/static/src/img/v9/polish.png' : '/car_wash_dashboard/static/src/img/v9/lounge.png'" alt=""/><div><b t-esc="item.product_name"></b><small><t t-esc="item.free"/> <t t-esc="item.uom"/></small><span t-esc="item.is_low ? ('متوفر ' + item.free) : ('متوفر ' + item.free)"></span><i class="cc103-progress"><em t-att-style="materialStyle(item)"></em></i></div></button></t><div t-if="!displayMaterials.length" class="cc10-empty">لا توجد مواد مرتبطة حالياً.</div></div></article>
          <div class="cc103-fin-bottom">
            <article class="cc10-panel cc103-best-services"><div class="cc103-panel-head"><h2>أفضل خدمات الغسيل مبيعاً</h2><div><button>هذا الشهر</button></div></div><table><thead><tr><th>#</th><th>الخدمة</th><th>عدد المبيعات</th></tr></thead><tbody><t t-foreach="state.data.pos_page.top_services.slice(0,5)" t-as="item" t-key="item.name"><tr><td t-esc="item_index + 1"></td><td><b t-esc="item.name"></b></td><td t-esc="item.orders or item.qty"></td></tr></t><tr t-if="!state.data.pos_page.top_services.length"><td colspan="3" class="cc10-empty">لا توجد مبيعات خدمات بعد.</td></tr></tbody></table></article>
            <article class="cc10-panel cc103-recent-moves"><div class="cc103-panel-head"><h2>آخر الحركات المحاسبية</h2><div><button t-on-click="openAccounting">عرض الكل</button></div></div><table><thead><tr><th>#</th><th>التاريخ</th><th>النوع</th><th>البيان</th><th>المبلغ</th></tr></thead><tbody><t t-foreach="state.data.finance_page.recent_moves.slice(0,5)" t-as="move" t-key="move.id"><tr t-on-click="() => this.openAccountingMove(move.id)"><td t-esc="move_index + 1"></td><td t-esc="move.date"></td><td t-esc="move.type"></td><td t-esc="move.name"></td><td t-esc="formatMoney(move.amount)"></td></tr></t><tr t-if="!state.data.finance_page.recent_moves.length"><td colspan="5" class="cc10-empty">لا توجد حركات محاسبية حديثة.</td></tr></tbody></table></article>
            <article class="cc10-panel cc103-actions-panel"><div class="cc103-panel-head"><h2>إجراءات سريعة</h2></div><div class="cc103-actions"><button class="green" t-on-click="openMaterials"><i class="fa fa-plus"></i> المواد</button><button class="blue" t-on-click="openAccounting"><i class="fa fa-file-text-o"></i> الحسابات</button><button class="violet" t-on-click="openPosApp"><i class="fa fa-credit-card"></i> نقطة البيع</button></div><div class="cc103-low-stock"><h3>تنبيهات المخزون المنخفض</h3><t t-foreach="state.data.low_stock.slice(0,4)" t-as="item" t-key="item.product_id"><div><span t-esc="item.product_name"></span><b>المتوفر: <t t-esc="item.free"/></b></div></t><div t-if="!state.data.low_stock.length" class="cc10-empty">لا توجد مواد منخفضة حالياً.</div></div></article>
          </div>
        </section>

        <!-- POS PAGE -->
        <section t-if="state.page === 'pos'" class="cc9-page cc10-page cc10-pos">
          <div class="cc10-title-row"><div><h1>تحليلات نقطة البيع</h1><p>المبيعات والخدمات وفرص البيع الإضافي</p></div><button class="cc10-primary" t-on-click="openPosApp"><i class="fa fa-shopping-cart"></i> فتح نقطة البيع</button></div>
          <div class="cc10-kpi-row"><article><i class="fa fa-shopping-basket blue"></i><span>طلبات اليوم</span><b t-esc="state.data.pos_page.orders_today"></b></article><article><i class="fa fa-money green"></i><span>مبيعات اليوم</span><b t-esc="formatMoney(state.data.pos_page.revenue_today)"></b></article><article><i class="fa fa-ticket cyan"></i><span>متوسط الفاتورة</span><b t-esc="formatMoney(state.data.pos_page.avg_ticket)"></b></article><article><i class="fa fa-line-chart green"></i><span>مبيعات الشهر</span><b t-esc="formatMoney(state.data.pos_page.month_revenue)"></b></article></div>
          <div class="cc10-pos-grid"><article class="cc10-panel"><h2>أفضل الخدمات مبيعاً</h2><t t-foreach="state.data.pos_page.top_services.slice(0,5)" t-as="item" t-key="item.name"><div class="cc10-rank-row"><b t-esc="item_index + 1"></b><span t-esc="item.name"></span><i><em t-att-style="topServiceStyle(item)"></em></i><strong><t t-esc="item.orders"/> طلب</strong></div></t><div t-if="!state.data.pos_page.top_services.length" class="cc10-empty">لا توجد مبيعات خدمات بعد.</div></article><article class="cc10-panel"><h2>فرص البيع الإضافي</h2><t t-foreach="upsellRows" t-as="item" t-key="item.name"><div class="cc10-upsell"><span><b t-esc="item.name"></b><small t-esc="item.label"></small></span><strong>+<t t-esc="item.pct"/>%</strong></div></t><div t-if="!upsellRows.length" class="cc10-empty">تظهر الفرص بعد توفر مبيعات كافية.</div></article></div>
        </section>

        <!-- CUSTOMER SCREEN -->
        <section t-if="state.page === 'customers'" class="cc9-page cc10-page cc10-customer-screen cc103-customer-screen">
          <div class="cc10-title-row compact"><div><h1>شاشة متابعة الزبائن</h1><p>واجهة عرض واقعية وواضحة للشاشة الموجودة في صالة الانتظار</p></div><button class="cc10-primary" t-on-click="toggleCustomerFullscreen"><i class="fa fa-arrows-alt"></i> ملء الشاشة</button></div>
          <div class="cc103-customer-stage">
            <article class="cc10-panel cc103-customer-hero" t-if="customerFocusCar"><div class="cc103-hero-copy"><span>رحلتك داخل المغسلة</span><b t-esc="customerFocusCar.public_reference or customerFocusCar.plate"></b><small t-esc="customerFocusCar.vehicle_model or customerFocusCar.service_name"></small><div class="cc103-hero-meta"><span><i class="fa fa-clock-o"></i><t t-esc="remainingLabel(customerFocusCar)"/></span><span><i class="fa fa-tint"></i><t t-esc="statusLabel(customerFocusCar)"/></span></div></div><img t-att-src="vehicleImage(customerFocusCar)" alt=""/><div class="cc103-hero-progress"><i class="cc10-progress"><em t-att-style="progressStyle(customerFocusCar.progress)"></em></i><strong><t t-esc="customerFocusCar.progress"/>%</strong></div></article>
            <article class="cc10-panel cc103-customer-columns"><div class="cc103-customer-tabs"><span>قيد الغسيل (<t t-esc="state.data.customer_screen.washing_count"/>)</span><span>في الانتظار (<t t-esc="state.data.customer_screen.waiting_count"/>)</span><span>جاهزة (<t t-esc="state.data.customer_screen.ready_count"/>)</span></div><div class="cc103-customer-rows"><t t-foreach="customerCars.slice(0,8)" t-as="car" t-key="car.id"><div class="cc103-customer-row"><img t-att-src="vehicleImage(car)" alt=""/><div><b t-esc="car.public_reference or car.plate"></b><small t-esc="car.vehicle_model or car.service_name"></small></div><span class="stage" t-esc="statusLabel(car)"></span><i class="cc10-progress"><em t-att-style="progressStyle(car.progress)"></em></i><strong t-esc="remainingLabel(car)"></strong></div></t><div t-if="!customerCars.length" class="cc10-empty">لا توجد سيارات قيد الخدمة حالياً.</div></div></article>
          </div>
          <article class="cc10-panel cc103-thanks-panel"><img src="/car_wash_dashboard/static/src/img/v9/customer_thanks.webp" alt=""/><div><span>شكراً لاختياركم</span><b>كريستال كلين</b><p>سيارتكم في أيدٍ أمينة — سيتم تحديث الحالة مباشرة على هذه الشاشة</p></div></article>
        </section>

        <!-- REPORTS PAGE -->
        <section t-if="state.page === 'reports'" class="cc9-page cc10-page cc10-reports">
          <div class="cc10-title-row"><div><h1>التقارير والتحليلات</h1><p>قراءة الأداء واتخاذ القرار من بيانات التشغيل الفعلية</p></div><div class="cc10-segment"><button>اليوم</button><button class="active">الأسبوع</button><button>الشهر</button><button>مخصص</button></div></div>
          <div class="cc10-report-grid"><article class="cc10-panel"><h2>حركة السيارات</h2><div class="cc10-bar-chart"><t t-foreach="state.data.reports_page.trend" t-as="item" t-key="item.date"><div><b t-esc="item.count"></b><i t-att-style="reportTrendStyle(item)"></i><span t-esc="item.label"></span></div></t></div></article><article class="cc10-panel"><h2>أوقات الذروة</h2><div class="cc10-heatmap"><t t-foreach="state.data.reports_page.hourly" t-as="item" t-key="item.label"><span t-att-class="heatLevel(item)"><b t-esc="item.label"></b><small t-esc="formatMoney(item.amount)"></small></span></t></div></article></div>
          <div class="cc10-kpi-row report"><article><span>متوسط وقت الخدمة</span><b><t t-esc="state.data.reports_page.avg_service_minutes"/> دقيقة</b></article><article><span>كفاءة أوامر العمل</span><b><t t-esc="state.data.reports_page.workorder_efficiency"/>%</b></article><article><span>معدل إشغال المحطات</span><b><t t-esc="state.data.reports_page.station_utilization"/>%</b></article><article><span>جودة البيانات</span><b><t t-esc="state.data.reports_page.data_quality"/>%</b></article></div>
          <article class="cc10-panel cc10-service-mix"><h2>مزيج الخدمات</h2><t t-foreach="state.data.reports_page.top_services.slice(0,6)" t-as="item" t-key="item.name"><div><span t-esc="item.name"></span><i><em t-att-style="serviceMixStyle(item)"></em></i><b><t t-esc="item.qty"/> خدمة</b></div></t></article>
        </section>

        <!-- MAINTENANCE PAGE -->
        <section t-if="state.page === 'maintenance'" class="cc9-page cc10-page cc10-maintenance">
          <div class="cc10-title-row"><div><h1>المعدات والصيانة</h1><p>صحة المعدات وجدولة الصيانة الوقائية والتصحيحية</p></div><button class="cc10-primary" t-on-click="openMaintenance"><i class="fa fa-wrench"></i> فتح الصيانة</button></div>
          <div class="cc10-kpi-row"><article><i class="fa fa-cogs blue"></i><span>إجمالي المعدات</span><b t-esc="state.data.maintenance_page.equipment_count"></b></article><article><i class="fa fa-calendar orange"></i><span>صيانة قريبة</span><b t-esc="state.data.maintenance_page.due_soon"></b></article><article><i class="fa fa-exclamation-circle red"></i><span>أعطال مفتوحة</span><b t-esc="state.data.maintenance_page.open_faults"></b></article><article><i class="fa fa-heartbeat green"></i><span>صحة المعدات</span><b><t t-esc="state.data.maintenance_page.health_avg"/>%</b></article></div>
          <article class="cc10-panel cc10-table-panel"><table><thead><tr><th>المعدة</th><th>التصنيف</th><th>الحالة</th><th>آخر صيانة</th><th>الصيانة القادمة</th><th>مؤشر الصحة</th><th>طلبات مفتوحة</th></tr></thead><tbody><t t-foreach="maintenanceRows" t-as="row" t-key="row.id"><tr><td><b t-esc="row.name"></b></td><td t-esc="row.category or '—'"></td><td><span t-att-class="'cc10-badge ' + maintenanceStatusClass(row)" t-esc="row.status_label"></span></td><td t-esc="row.last_maintenance or '—'"></td><td t-esc="row.next_maintenance or '—'"></td><td><div class="cc10-health"><i><em t-att-style="progressStyle(row.health)"></em></i><b><t t-esc="row.health"/>%</b></div></td><td t-esc="row.open_requests"></td></tr></t><tr t-if="!state.data.maintenance_page.available"><td colspan="7" class="cc10-empty">تطبيق الصيانة غير مثبت في هذه القاعدة. الصفحة جاهزة وستعرض البيانات تلقائياً عند توفره.</td></tr><tr t-elif="!maintenanceRows.length"><td colspan="7" class="cc10-empty">لا توجد معدات معرفة حتى الآن.</td></tr></tbody></table></article>
        </section>

        <footer class="cc9-footer"><span><b>كريستال كلين</b> | حلول العناية بالسيارات</span><span>V10.3.0</span><span class="ok"><i></i><t t-if="state.realtime">النظام مباشر</t><t t-else="">تحديث تلقائي</t></span></footer>
      </main>
      <div t-if="state.liveMessage" t-att-class="'cc9-toast ' + (state.livePulse ? 'pulse' : '')"><i class="fa fa-bolt"></i><span t-esc="state.liveMessage"></span></div>
    </div>
  </div>
</t>
</templates>
