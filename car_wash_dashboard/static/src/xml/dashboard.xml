<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="car_wash_dashboard.CarVisual" owl="1">
    <div t-att-class="'cw-car-visual ' + (props.compact ? 'is-compact' : '')" t-att-style="carStyle()">
            <div class="cw-car-water" aria-hidden="true">
                <i/><i/><i/><i/>
            </div>

            <svg t-if="props.vehicleType === 'pickup'" viewBox="0 0 240 105" role="img" aria-label="Pickup" style="display:block;width:100%;max-width:260px;height:auto;margin:0 auto;overflow:visible">
                <path class="cw-car-shadow" fill="rgba(15,23,42,.12)" d="M24 84h193c7 0 13 4 13 8s-6 7-13 7H24c-8 0-14-3-14-7s6-8 14-8z"/>
                <path class="cw-car-body" fill="var(--cw-car-paint,#2563eb)" stroke="rgba(15,23,42,.25)" stroke-width="2" d="M16 63c2-10 10-17 22-19l43-7 20-24h54c12 0 19 5 26 15l12 17h30c8 0 13 5 14 13l2 17H16z"/>
                <path class="cw-car-glass" fill="#dff5ff" stroke="rgba(3,105,161,.26)" stroke-width="2" d="M105 19h43c10 0 14 3 20 11l9 13h-83z"/>
                <path class="cw-car-line" fill="none" stroke="rgba(15,23,42,.28)" stroke-width="2" d="M181 46h42M84 38v39M184 45v31"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="62" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="62" cy="78" r="9"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="194" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="194" cy="78" r="9"/>
            </svg>

            <svg t-elif="props.vehicleType === 'truck'" viewBox="0 0 240 105" role="img" aria-label="Truck" style="display:block;width:100%;max-width:260px;height:auto;margin:0 auto;overflow:visible">
                <path class="cw-car-shadow" fill="rgba(15,23,42,.12)" d="M22 84h196c7 0 12 4 12 8s-5 7-12 7H22c-7 0-12-3-12-7s5-8 12-8z"/>
                <path class="cw-car-body" fill="var(--cw-car-paint,#2563eb)" stroke="rgba(15,23,42,.25)" stroke-width="2" d="M14 31h128v46H14zM145 43h42l28 23v11h-70z"/>
                <path class="cw-car-glass" fill="#dff5ff" stroke="rgba(3,105,161,.26)" stroke-width="2" d="M157 48h25l18 16h-43z"/>
                <path class="cw-car-line" fill="none" stroke="rgba(15,23,42,.28)" stroke-width="2" d="M145 43v34M17 54h122"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="58" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="58" cy="78" r="9"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="184" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="184" cy="78" r="9"/>
            </svg>

            <svg t-elif="props.vehicleType === 'van'" viewBox="0 0 240 105" role="img" aria-label="Van" style="display:block;width:100%;max-width:260px;height:auto;margin:0 auto;overflow:visible">
                <path class="cw-car-shadow" fill="rgba(15,23,42,.12)" d="M24 84h192c8 0 14 4 14 8s-6 7-14 7H24c-8 0-14-3-14-7s6-8 14-8z"/>
                <path class="cw-car-body" fill="var(--cw-car-paint,#2563eb)" stroke="rgba(15,23,42,.25)" stroke-width="2" d="M18 58c2-21 13-36 33-39h112c15 0 24 7 34 23l15 24h12c6 0 10 4 10 11H18z"/>
                <path class="cw-car-glass" fill="#dff5ff" stroke="rgba(3,105,161,.26)" stroke-width="2" d="M57 25h50v31H36c4-16 11-27 21-31zM113 25h45c11 0 17 5 25 18l8 13h-78z"/>
                <path class="cw-car-line" fill="none" stroke="rgba(15,23,42,.28)" stroke-width="2" d="M108 24v53M196 57v20"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="62" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="62" cy="78" r="9"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="190" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="190" cy="78" r="9"/>
            </svg>

            <svg t-else="" viewBox="0 0 240 105" role="img" aria-label="Car" style="display:block;width:100%;max-width:260px;height:auto;margin:0 auto;overflow:visible">
                <path class="cw-car-shadow" fill="rgba(15,23,42,.12)" d="M25 84h190c9 0 15 4 15 8s-6 7-15 7H25c-9 0-15-3-15-7s6-8 15-8z"/>
                <path class="cw-car-body" fill="var(--cw-car-paint,#2563eb)" stroke="rgba(15,23,42,.25)" stroke-width="2" d="M15 65c1-10 7-16 18-19l39-9 24-24h55c13 0 22 5 31 17l13 17 25 5c8 2 12 7 13 14l2 11H15z"/>
                <path class="cw-car-glass" fill="#dff5ff" stroke="rgba(3,105,161,.26)" stroke-width="2" d="M100 19h47c9 0 15 4 22 13l10 13H79z"/>
                <path class="cw-car-line" fill="none" stroke="rgba(15,23,42,.28)" stroke-width="2" d="M75 38l6 39M181 45l6 32"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="62" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="62" cy="78" r="9"/>
                <circle class="cw-tire" fill="#111827" stroke="#334155" stroke-width="2" cx="188" cy="78" r="20"/><circle class="cw-rim" fill="#cbd5e1" stroke="#64748b" stroke-width="2" cx="188" cy="78" r="9"/>
            </svg>
        </div>
  </t>

  <t t-name="car_wash_dashboard.CarWashDashboard" owl="1">
    <div class="o_car_wash_dashboard cw-v2 cw-v3" dir="rtl">
            <div class="cw-bubbles" aria-hidden="true">
                <span/><span/><span/><span/><span/><span/><span/><span/>
            </div>

            <t t-if="state.loading">
                <div class="cw-loading">
                    <i class="fa fa-spinner fa-spin"/>
                    <span>جاري تحميل لوحة المغسلة...</span>
                </div>
            </t>

            <t t-else="">
                <div class="cw-content">

                    <!-- ====================================================== -->
                    <!-- Header -->
                    <!-- ====================================================== -->
                    <div class="cw-header cw-v2-header">
                        <div class="cw-title">
                            <div class="cw-logo cw-logo-v2">
                                <i class="fa fa-car"/>
                                <span class="cw-drop"><i class="fa fa-tint"/></span>
                            </div>
                            <div>
                                <div class="cw-title-line">
                                    <h1>لوحة تشغيل مغسلة السيارات</h1>
                                    <span class="cw-version">V4 LIVE JOURNEY</span>
                                </div>
                                <p><t t-esc="state.data.company_name or 'Crystal Clean'"/> · بيانات تشغيل حقيقية</p>
                            </div>
                        </div>
                        <div class="cw-actions">
                            <span t-att-class="'cw-live ' + (state.realtimeConnected ? 'is-realtime' : 'is-polling')">
                                <span class="dot"/>
                                <t t-if="state.realtimeConnected">مباشر لحظي</t>
                                <t t-else="">مباشر · تحديث احتياطي</t>
                            </span>
                            <span t-if="state.liveEventText"
                                  t-att-class="'cw-live-event ' + (state.livePulse ? 'is-pulsing' : '')">
                                <i class="fa fa-bolt"/> <t t-esc="state.liveEventText"/>
                            </span>
                            <span t-if="state.lastUpdate" class="cw-updated">
                                <i class="fa fa-clock-o me-1"/> <t t-esc="state.lastUpdate"/>
                            </span>
                            <button class="btn btn-shop-floor" t-on-click="openShopFloor">
                                <i class="fa fa-desktop me-1"/> شاشة الغسيل
                            </button>
                            <button class="btn btn-refresh" t-on-click="manualRefresh">
                                <i class="fa fa-refresh me-1"/> تحديث
                            </button>
                            <button class="btn btn-create" t-on-click="createSaleOrder">
                                <i class="fa fa-plus me-1"/> طلب جديد
                            </button>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Visual wash tunnel / live operations scene -->
                    <!-- ====================================================== -->
                    <section class="cw-wash-tunnel-shell mb-4">
                        <div class="cw-tunnel-copy">
                            <div class="cw-eyebrow"><span class="cw-pulse-dot"/> LIVE OPERATIONS</div>
                            <h2>المغسلة تتحرك مع البيانات</h2>
                            <p>السيارة، المحطة، المرحلة، الخدمة والمخزون كلها مرتبطة مباشرة ببيانات Odoo الحقيقية.</p>
                            <div class="cw-tunnel-mini-stats">
                                <div><b t-esc="state.data.active_total"/><span>سيارة نشطة</span></div>
                                <div><b t-esc="state.data.station_busy"/><span>محطة تعمل</span></div>
                                <div><b t-esc="state.data.station_queue"/><span>في الطوابير</span></div>
                                <div><b t-esc="formatDuration(state.data.avg_turnaround)"/><span>متوسط الدورة</span></div>
                            </div>
                        </div>
                        <div class="cw-tunnel-scene" aria-label="Live car wash tunnel">
                            <div class="cw-tunnel-glow"/>
                            <div class="cw-wash-arch cw-arch-one"><i/><i/><i/><i/><i/></div>
                            <div class="cw-wash-arch cw-arch-two"><i/><i/><i/><i/><i/></div>
                            <div class="cw-foam-cloud foam-a"><span/><span/><span/><span/></div>
                            <div class="cw-foam-cloud foam-b"><span/><span/><span/></div>
                            <div class="cw-floor-reflection"/>
                            <div class="cw-tunnel-car-wrap" t-if="state.data.active_cars and state.data.active_cars.length">
                                <t t-set="hero" t-value="state.data.active_cars[0]"/>
                                <div class="cw-hero-car cw-clickable" t-on-click="() => this.openProduction(hero.id)">
                                    <CarVisual vehicleType="hero.vehicle_type" color="hero.vehicle_color"/>
                                    <div class="cw-hero-meta">
                                        <b t-esc="hero.plate"/>
                                        <span t-esc="hero.service_name"/>
                                        <small><t t-esc="hero.workcenter_name or hero.status_label"/> · <t t-esc="hero.progress"/>%</small>
                                    </div>
                                </div>
                            </div>
                            <div class="cw-tunnel-car-wrap is-empty" t-else="">
                                <div class="cw-hero-car ghost-car">
                                    <CarVisual vehicleType="'car'" color="'#38bdf8'"/>
                                    <div class="cw-hero-meta"><b>جاهزة لاستقبال السيارة التالية</b><span>Crystal Clean</span></div>
                                </div>
                            </div>
                            <div class="cw-road-lines"><i/><i/><i/><i/></div>
                        </div>
                    </section>

                    <!-- ====================================================== -->
                    <!-- V4 LIVE VEHICLE JOURNEY -->
                    <!-- ====================================================== -->
                    <section class="cw-journey-card mb-4"
                             t-if="state.data.journey_car"
                             t-att-class="'cw-journey-card mb-4 status-' + statusClass(state.data.journey_car.status_code)">
                        <t t-set="journey" t-value="state.data.journey_car"/>
                        <div class="cw-journey-head">
                            <div>
                                <div class="cw-card-title">
                                    <span class="cw-journey-live-dot"/>
                                    رحلة السيارة الحية
                                </div>
                                <div class="cw-card-subtitle">
                                    تتحرك السيارة تلقائيًا عندما تتغير مرحلة Shop Floor الفعلية
                                </div>
                            </div>
                            <div class="cw-journey-head-meta">
                                <span class="cw-journey-plate"><i class="fa fa-id-card-o"/> <t t-esc="journey.plate"/></span>
                                <span class="cw-journey-service" t-esc="journey.service_name"/>
                            </div>
                        </div>

                        <div class="cw-journey-stage-strip">
                            <div class="cw-journey-stage-current">
                                <small>الموقع الحالي</small>
                                <b><i class="fa fa-map-marker"/> <t t-esc="journey.station or journey.current_stage"/></b>
                            </div>
                            <div class="cw-journey-stage-next">
                                <small>المحطة التالية</small>
                                <b t-esc="journey.next_stage or 'التسليم'"/>
                            </div>
                            <div class="cw-journey-stage-time" t-if="journey.current_age_minutes">
                                <small>الوقت في المرحلة</small>
                                <b><t t-esc="formatDuration(journey.current_age_minutes)"/></b>
                            </div>
                            <div t-if="journey.stage_delayed" class="cw-journey-delay">
                                <i class="fa fa-exclamation-triangle"/>
                                تجاوز الوقت المتوقع
                            </div>
                        </div>

                        <div class="cw-journey-rail" t-att-style="journeyStyle(journey)">
                            <div class="cw-journey-base-line"/>
                            <div class="cw-journey-completed-line"/>
                            <div class="cw-journey-flow-dots" aria-hidden="true"><i/><i/><i/><i/><i/></div>

                            <div t-foreach="journey.journey_nodes" t-as="node" t-key="node.key"
                                 t-att-class="'cw-journey-node ' + journeyNodeClass(node)"
                                 t-att-style="journeyNodeStyle(node)">
                                <div class="cw-journey-node-circle">
                                    <i t-att-class="'fa ' + node.icon"/>
                                </div>
                                <div class="cw-journey-node-label" t-esc="node.label"/>
                                <small t-if="node.workcenter" t-esc="node.workcenter"/>
                            </div>

                            <div t-att-class="'cw-journey-car-marker status-' + statusClass(journey.status_code)">
                                <div class="cw-journey-water" t-if="journey.status_code === 'washing'" aria-hidden="true">
                                    <i/><i/><i/><i/><i/>
                                </div>
                                <div class="cw-journey-sparkles" t-if="journey.status_code === 'ready_delivery'" aria-hidden="true">
                                    <i/><i/><i/><i/>
                                </div>
                                <CarVisual vehicleType="journey.vehicle_type" color="journey.vehicle_color" compact="true"/>
                                <span class="cw-journey-car-caption"><t t-esc="journey.journey_percent"/>%</span>
                            </div>
                        </div>

                        <div class="cw-journey-footer">
                            <div>
                                <span>أمر الغسيل</span>
                                <b t-esc="journey.name"/>
                            </div>
                            <div>
                                <span>العميل</span>
                                <b t-esc="journey.customer or '—'"/>
                            </div>
                            <div>
                                <span>الإنجاز التشغيلي</span>
                                <b><t t-esc="journey.done_steps"/> / <t t-esc="journey.total_steps"/> مراحل</b>
                            </div>
                            <button class="btn cw-journey-open" t-on-click="() => this.openProduction(journey.id)">
                                فتح أمر الغسيل <i class="fa fa-arrow-left"/>
                            </button>
                        </div>
                    </section>

                    <!-- ====================================================== -->
                    <!-- Live car floor -->
                    <!-- ====================================================== -->
                    <div class="cw-card cw-live-floor mb-4">
                        <div class="cw-card-head">
                            <div>
                                <div class="cw-card-title"><i class="fa fa-car"/> السيارات داخل دورة الغسيل الآن</div>
                                <div class="cw-card-subtitle">مرتبطة مباشرة بأوامر الغسيل ومراحل Shop Floor</div>
                            </div>
                            <span class="cw-count-badge"><t t-esc="state.data.active_total"/> نشطة</span>
                        </div>

                        <div class="cw-live-car-grid" t-if="state.data.active_cars and state.data.active_cars.length">
                            <div t-foreach="state.data.active_cars" t-as="car" t-key="car.id"
                                 t-att-class="'cw-live-car-card status-' + statusClass(car.status_code) + ' cw-clickable'"
                                 t-on-click="() => this.openProduction(car.id)">
                                <div class="cw-car-stage-top">
                                    <span t-att-class="'cw-status-chip ' + statusClass(car.status_code)">
                                        <span class="cw-status-dot"/>
                                        <t t-esc="car.status_label"/>
                                    </span>
                                    <span class="cw-car-order" t-esc="car.name"/>
                                </div>

                                <CarVisual vehicleType="car.vehicle_type" color="car.vehicle_color"/>

                                <div class="cw-car-main-info">
                                    <div class="cw-plate"><i class="fa fa-id-card-o"/> <t t-esc="car.plate"/></div>
                                    <div class="cw-service-name" t-esc="car.service_name"/>
                                    <div class="cw-customer" t-if="car.customer"><i class="fa fa-user-o"/> <t t-esc="car.customer"/></div>
                                </div>

                                <div class="cw-car-stage-row">
                                    <span><i class="fa fa-map-marker"/> <t t-esc="car.workcenter_name or 'بانتظار المحطة'"/></span>
                                    <span><i class="fa fa-cog"/> <t t-esc="car.current_stage"/></span>
                                </div>

                                <div class="cw-car-progress-row">
                                    <div class="cw-car-progress-track">
                                        <span t-att-style="'width:' + Math.min(car.progress or 0, 100) + '%'"/>
                                    </div>
                                    <b><t t-esc="car.progress"/>%</b>
                                </div>
                            </div>
                        </div>
                        <div class="cw-empty-state" t-else="">
                            <i class="fa fa-check-circle"/>
                            <span>لا توجد سيارات نشطة حاليًا</span>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Operations KPIs -->
                    <!-- ====================================================== -->
                    <div class="row g-3 mb-3">
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi blue cw-clickable" t-on-click="() => this.openKpi('total_today')">
                                <div class="cw-kpi-icon"><i class="fa fa-calendar-check-o"/></div>
                                <div><p class="cw-kpi-label">أوامر الغسيل اليوم</p><div class="cw-kpi-value" t-esc="state.data.total_today"/></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi amber cw-clickable" t-on-click="() => this.openKpi('in_progress')">
                                <div class="cw-kpi-icon"><i class="fa fa-shower"/></div>
                                <div><p class="cw-kpi-label">قيد الغسيل</p><div class="cw-kpi-value" t-esc="state.data.in_progress"/></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi green cw-clickable" t-on-click="() => this.openKpi('done_today')">
                                <div class="cw-kpi-icon"><i class="fa fa-check-circle"/></div>
                                <div><p class="cw-kpi-label">مكتملة اليوم</p><div class="cw-kpi-value" t-esc="state.data.done_today"/></div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi violet cw-clickable" t-on-click="() => this.openKpi('waiting')">
                                <div class="cw-kpi-icon"><i class="fa fa-hourglass-half"/></div>
                                <div><p class="cw-kpi-label">بانتظار البدء</p><div class="cw-kpi-value" t-esc="state.data.waiting"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- Business / accounting KPIs -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi teal cw-clickable" t-on-click="() => this.openSales('revenue_today')">
                                <div class="cw-kpi-icon"><i class="fa fa-shopping-cart"/></div>
                                <div>
                                    <p class="cw-kpi-label">مبيعات خدمات الغسيل اليوم</p>
                                    <div class="cw-kpi-value cw-kpi-money" t-esc="formatMoney(state.data.revenue_today)"/>
                                    <div class="cw-kpi-sub"><t t-esc="state.data.wash_sales_orders_today"/> طلب</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi indigo cw-clickable" t-on-click="() => this.openAccounting('invoiced_today')">
                                <div class="cw-kpi-icon"><i class="fa fa-file-text-o"/></div>
                                <div>
                                    <p class="cw-kpi-label">المفوتر اليوم</p>
                                    <div class="cw-kpi-value cw-kpi-money" t-esc="formatMoney(state.data.invoiced_today)"/>
                                    <div class="cw-kpi-sub"><t t-esc="state.data.posted_invoices_today"/> فاتورة/إشعار</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi rose cw-clickable" t-on-click="() => this.openAccounting('receivable_open')">
                                <div class="cw-kpi-icon"><i class="fa fa-credit-card"/></div>
                                <div>
                                    <p class="cw-kpi-label">مستحقات العملاء</p>
                                    <div class="cw-kpi-value cw-kpi-money" t-esc="formatMoney(state.data.receivable_open)"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <div class="cw-card cw-kpi slate cw-clickable" t-on-click="() => this.openSales('pending_quotations')">
                                <div class="cw-kpi-icon"><i class="fa fa-clock-o"/></div>
                                <div>
                                    <p class="cw-kpi-label">عروض الغسيل المعلقة</p>
                                    <div class="cw-kpi-value" t-esc="state.data.pending_quotations"/>
                                    <div class="cw-kpi-sub">متوسط الطلب <t t-esc="formatMoney(state.data.avg_ticket)"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pipeline + extra KPIs -->
                    <div class="cw-card mb-4">
                        <div class="cw-card-head">
                            <div class="cw-card-title"><i class="fa fa-random"/> حالة أوامر الغسيل</div>
                            <div class="cw-head-actions">
                                <span class="cw-mini-kpi"><i class="fa fa-clock-o"/> متوسط الغسيل: <b t-esc="formatDuration(state.data.avg_turnaround)"/></span>
                                <span class="cw-mini-kpi"><i class="fa fa-bolt"/> كفاءة المراحل: <b t-esc="state.data.wo_efficiency ? state.data.wo_efficiency + '%' : '—'"/></span>
                            </div>
                        </div>
                        <div class="cw-pipeline">
                            <t t-foreach="state.data.pipeline" t-as="p" t-key="p.code">
                                <div t-att-class="'cw-pill cw-clickable pill-' + p.code" t-on-click="() => this.openMfg('state_' + p.code)">
                                    <i t-att-class="'fa ' + pillIcon(p.code)"/>
                                    <span t-esc="p.label"/>
                                    <b t-esc="p.count"/>
                                </div>
                            </t>
                            <div class="cw-pill cw-clickable pill-overdue" t-on-click="() => this.openMfg('overdue')">
                                <i class="fa fa-exclamation-triangle"/><span>متأخرة</span><b t-esc="state.data.overdue"/>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Wash stations -->
                    <!-- ====================================================== -->
                    <div class="cw-section-heading">
                        <div>
                            <h2><i class="fa fa-map-signs"/> محطات الغسيل</h2>
                            <p>الازدحام الحالي والسيارات الموجودة في كل محطة</p>
                        </div>
                        <button class="btn btn-shop-floor-outline" t-on-click="openShopFloor">
                            <i class="fa fa-desktop"/> فتح شاشة التشغيل
                        </button>
                    </div>

                    <div class="cw-station-grid mb-4">
                        <div t-foreach="state.data.workcenter_load" t-as="wc" t-key="wc.id"
                             t-att-class="'cw-station-card ' + (wc.in_progress ? 'is-running' : (wc.queue ? 'has-queue' : 'is-free'))">
                            <div class="cw-station-top cw-clickable" t-on-click="() => this.openWorkcenterOrders(wc)">
                                <div class="cw-station-icon"><i t-att-class="'fa ' + (wc.icon or 'fa-wrench')"/></div>
                                <div class="cw-station-title">
                                    <h3 t-esc="wc.name"/>
                                    <span t-if="wc.in_progress" class="cw-station-status running"><span/> تعمل الآن</span>
                                    <span t-elif="wc.queue" class="cw-station-status queued"><span/> يوجد انتظار</span>
                                    <span t-else="" class="cw-station-status free"><span/> متاحة</span>
                                </div>
                                <div class="cw-station-numbers">
                                    <strong t-esc="wc.load"/>
                                    <small>نشطة</small>
                                </div>
                            </div>

                            <div class="cw-station-metrics">
                                <span><b t-esc="wc.in_progress"/> داخل المحطة</span>
                                <span><b t-esc="wc.queue"/> في الطابور</span>
                                <span><b t-esc="wc.capacity"/> السعة</span>
                            </div>

                            <div class="cw-station-car-list" t-if="wc.cars and wc.cars.length">
                                <div t-foreach="wc.cars" t-as="car" t-key="car.id"
                                     class="cw-station-car cw-clickable" t-on-click.stop="() => this.openProduction(car.id)">
                                    <CarVisual vehicleType="car.vehicle_type" color="car.vehicle_color" compact="true"/>
                                    <div class="cw-station-car-info">
                                        <b t-esc="car.plate"/>
                                        <span t-esc="car.service_name"/>
                                        <small><t t-esc="woStateLabel(car.wo_state)"/> · <t t-esc="car.stage"/></small>
                                    </div>
                                </div>
                            </div>
                            <div class="cw-station-empty" t-else="">
                                <i class="fa fa-check-circle"/> لا توجد سيارة في هذه المحطة
                            </div>

                            <div class="cw-station-pressure">
                                <div class="cw-progress-label"><span>الإشغال الحالي</span><b><t t-esc="wc.utilization"/>%</b></div>
                                <div class="cw-progress-track"><span t-att-style="'width:' + Math.min(wc.utilization or 0, 100) + '%'"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Services -->
                    <!-- ====================================================== -->
                    <div class="cw-card mb-4">
                        <div class="cw-card-head">
                            <div>
                                <div class="cw-card-title"><i class="fa fa-tint"/> توزيع خدمات الغسيل النشطة</div>
                                <div class="cw-card-subtitle">من x_cc_service_product_id وليس Basic/Premium/Deluxe</div>
                            </div>
                        </div>
                        <div class="cw-service-grid">
                            <div t-foreach="state.data.service_dist" t-as="service" t-key="service.id"
                                 class="cw-service-tile cw-clickable" t-on-click="() => this.openService(service)">
                                <div class="cw-service-water"><i class="fa fa-tint"/></div>
                                <div class="cw-service-count" t-esc="service.count"/>
                                <div class="cw-service-label" t-esc="service.name"/>
                                <i class="fa fa-chevron-left cw-service-go"/>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Charts -->
                    <!-- ====================================================== -->
                    <div class="cw-card mb-4">
                        <div class="cw-card-head">
                            <div class="cw-card-title"><i class="fa fa-line-chart"/> السيارات المكتملة خلال 7 أيام</div>
                        </div>
                        <div class="cw-chart-body cw-chart-trend"><canvas id="trendChart"/></div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-lg-6">
                            <div class="cw-card h-100">
                                <div class="cw-card-head"><div class="cw-card-title"><i class="fa fa-bar-chart"/> مراحل الغسيل النشطة</div></div>
                                <div class="cw-chart-body"><canvas id="phaseChart"/></div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="cw-card h-100">
                                <div class="cw-card-head"><div class="cw-card-title"><i class="fa fa-pie-chart"/> توزيع الحمل على المحطات</div></div>
                                <div class="cw-chart-body"><canvas id="workcenterChart"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Materials -->
                    <!-- ====================================================== -->
                    <div class="cw-card mb-4">
                        <div class="cw-card-head">
                            <div>
                                <div class="cw-card-title"><i class="fa fa-cubes"/> مواد الغسيل الحقيقية</div>
                                <div class="cw-card-subtitle">المتاح = الموجود فعليًا − المحجوز</div>
                            </div>
                            <span class="cw-count-badge"><t t-esc="(state.data.materials || []).length"/> مادة</span>
                        </div>
                        <div class="cw-material-grid">
                            <div t-foreach="state.data.materials" t-as="item" t-key="item.product_id"
                                 t-att-class="'cw-material-card ' + materialClass(item) + ' cw-clickable'"
                                 t-on-click="() => this.openProduct(item.product_id)">
                                <div class="cw-material-icon"><i class="fa fa-flask"/></div>
                                <div class="cw-material-main">
                                    <b t-esc="item.product_name"/>
                                    <span t-if="item.has_minimum">الحد الأدنى: <t t-esc="item.min_qty"/> <t t-esc="item.uom"/></span>
                                    <span t-else="">لا يوجد حد إعادة طلب محدد</span>
                                </div>
                                <div class="cw-material-values">
                                    <div><small>الموجود</small><b><t t-esc="item.on_hand"/></b></div>
                                    <div><small>المحجوز</small><b><t t-esc="item.reserved"/></b></div>
                                    <div class="free"><small>المتاح</small><b><t t-esc="item.free"/></b></div>
                                </div>
                                <span t-if="item.is_low" class="cw-material-alert"><i class="fa fa-exclamation-triangle"/> منخفض</span>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Upcoming + completed -->
                    <!-- ====================================================== -->
                    <div class="row g-3 mb-4">
                        <div class="col-lg-6">
                            <div class="cw-card h-100">
                                <div class="cw-card-head"><div class="cw-card-title"><i class="fa fa-calendar"/> قادم للتنفيذ</div></div>
                                <ul class="cw-timeline cw-upcoming">
                                    <t t-if="state.data.upcoming and state.data.upcoming.length">
                                        <li t-foreach="state.data.upcoming" t-as="u" t-key="u.id"
                                            class="cw-clickable" t-on-click="() => this.openProduction(u.id)">
                                            <span class="cw-time"><t t-esc="u.started_at"/><small t-esc="u.scheduled_date"/></span>
                                            <div>
                                                <div class="cw-order-name" t-esc="u.name"/>
                                                <div class="cw-order-plate"><i class="fa fa-car"/> <t t-esc="u.plate"/></div>
                                                <small t-esc="u.service_name"/>
                                            </div>
                                            <span class="cw-ready-chip" t-esc="u.status_label"/>
                                        </li>
                                    </t>
                                    <t t-else=""><li class="cw-empty">لا توجد أوامر مجدولة قادمة</li></t>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="cw-card h-100">
                                <div class="cw-card-head"><div class="cw-card-title"><i class="fa fa-history"/> مكتملة اليوم</div></div>
                                <ul class="cw-timeline">
                                    <t t-if="state.data.timeline and state.data.timeline.length">
                                        <li t-foreach="state.data.timeline" t-as="order" t-key="order.id"
                                            class="cw-clickable" t-on-click="() => this.openProduction(order.id)">
                                            <span class="cw-time" t-esc="order.completed_at"/>
                                            <div>
                                                <div class="cw-order-name" t-esc="order.name"/>
                                                <div class="cw-order-plate"><i class="fa fa-car"/> <t t-esc="order.plate"/></div>
                                                <small t-esc="order.service_name"/>
                                            </div>
                                            <span class="cw-ready-chip">مكتملة</span>
                                        </li>
                                    </t>
                                    <t t-else=""><li class="cw-empty">لم تكتمل أوامر غسيل اليوم بعد</li></t>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- ====================================================== -->
                    <!-- Quick order -->
                    <!-- ====================================================== -->
                    <div class="cw-quick-orders">
                        <div class="cw-quick-orders-head">
                            <div>
                                <div class="cw-quick-orders-title"><i class="fa fa-plus-circle"/><span>إنشاء طلب غسيل جديد</span></div>
                                <div class="cw-quick-orders-subtitle">اختر نوع المركبة لفتح أمر البيع بالقيمة الافتراضية</div>
                            </div>
                            <div class="cw-quick-orders-badge"><i class="fa fa-bolt"/> طلب سريع</div>
                        </div>
                        <div class="cw-vehicle-grid">
                            <t t-foreach="vehicleTypes" t-as="vehicle" t-key="vehicle.code">
                                <div t-att-class="'cw-vehicle-card ' + vehicle.cls + ' cw-clickable'"
                                     t-on-click="() => this.createVehicleOrder(vehicle)">
                                    <div class="cw-vehicle-icon"><i t-att-class="'fa ' + vehicle.icon"/></div>
                                    <div class="cw-vehicle-info">
                                        <div class="cw-vehicle-name" t-esc="vehicle.label"/>
                                        <div class="cw-vehicle-subtitle" t-esc="vehicle.subtitle"/>
                                    </div>
                                    <div class="cw-vehicle-arrow"><i class="fa fa-arrow-left"/></div>
                                </div>
                            </t>
                        </div>
                    </div>

                </div>
            </t>
        </div>
  </t>
</templates>
