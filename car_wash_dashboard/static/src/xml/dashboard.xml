<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="car_wash_dashboard.CarWashDashboard" owl="1">
    <div class="o_car_wash_dashboard cc-odoo-shell" dir="rtl">
      <div id="crystal-concept" lang="ar" dir="rtl">
        <t t-if="state.loading">
          <div class="cc-loading-shell"><div class="cc-loading-box"><i class="fa fa-spinner fa-spin"/><span>جاري تحميل لوحة المغسلة...</span></div></div>
        </t>
        <t t-else="">
          <div class="cc-preview">
            <span><span class="cc-live-ok">متصل بـ Odoo</span> · تصميم Crystal Clean</span>
            <span>بيانات التشغيل حية · مؤثرات السيارة بصرية فقط <t t-if="state.lastUpdate">· آخر تحديث <t t-esc="state.lastUpdate"/></t></span>
          </div>

          <header class="cc-header">
            <div class="cc-brand"><div class="cc-logo" aria-hidden="true">◇</div><div class="cc-wordmark">CRYSTAL CLEAN<br/><small>كريستال كلين · العناية بالسيارات</small></div></div>
            <nav class="cc-nav" aria-label="أقسام لوحة المغسلة" role="tablist">
              <button type="button" role="tab" t-att-aria-selected="state.activeTab === 'ops'" t-on-click="() => this.setTab('ops')">لوحة المغسلة</button>
              <button type="button" role="tab" t-att-aria-selected="state.activeTab === 'owner'" t-on-click="() => this.setTab('owner')">المواد والحسابات</button>
              <button type="button" role="tab" t-att-aria-selected="state.activeTab === 'customer'" t-on-click="() => this.setTab('customer')">شاشة الزبائن</button>
            </nav>
            <div class="cc-top-actions">
              <button class="cc-action-btn" type="button" t-on-click="openShopFloor"><i class="fa fa-desktop"/> شاشة الغسيل</button>
              <button class="cc-action-btn" type="button" t-on-click="manualRefresh"><i class="fa fa-refresh"/> تحديث</button>
            </div>
          </header>

          <main class="cc-body">
            <!-- OPERATIONS TAB -->
            <section t-if="state.activeTab === 'ops'" id="cc-ops" role="tabpanel">
              <div class="cc-heading"><div><span class="cc-kicker">THE ART OF CAR CARE</span><h1>كل سيارة، أمامك.</h1><p>مصدر الطلبات المعتمد: نقطة البيع · من الوصول إلى الجاهزية.</p></div><span class="cc-label"><span class="cc-dot"/>بيانات Odoo الحالية</span></div>

              <div class="cc-kpis" aria-label="مؤشرات التشغيل">
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openKpi('active_total')">
                  <span class="cc-stat-name">السيارات الحالية</span><strong class="cc-stat-value" t-esc="state.data.active_total"/><span class="cc-stat-note">أوامر غسيل نشطة الآن</span><span class="cc-stat-animation cc-anim-car" aria-hidden="true"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></span>
                </button>
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openKpi('in_progress')">
                  <span class="cc-stat-name">أوامر جارية</span><strong class="cc-stat-value" t-esc="state.data.in_progress"/><span class="cc-stat-note">حسب حالة أمر الغسيل</span><span class="cc-stat-animation cc-anim-care" aria-hidden="true">✧</span>
                </button>
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openKpi('waiting')">
                  <span class="cc-stat-name">في الانتظار</span><strong class="cc-stat-value" t-esc="state.data.waiting"/><span class="cc-stat-note">بانتظار بدء العمل</span><span class="cc-stat-animation cc-anim-wait" aria-hidden="true"><i/><i/><i/></span>
                </button>
                <button type="button" class="cc-stat cc-stat-interactive cc-ready" t-on-click="() => readyCar and this.openProduction(readyCar.id)">
                  <span class="cc-stat-name">جاهزة للتسليم</span><strong class="cc-stat-value" t-esc="readyCar ? 1 : 0"/><span class="cc-stat-note" t-if="readyCar"><t t-esc="readyCar.plate"/> · <t t-esc="readyCar.service_name"/></span><span class="cc-stat-note" t-else="">لا توجد سيارة جاهزة الآن</span><span class="cc-stat-animation cc-anim-ready" aria-hidden="true">✓</span>
                </button>
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="openShopFloor">
                  <span class="cc-stat-name">مراحل تعمل الآن</span><strong class="cc-stat-value" t-esc="state.data.station_busy"/><span class="cc-stat-note"><t t-esc="state.data.station_total"/> محطات معرفة</span><span class="cc-stat-animation cc-anim-idle" aria-hidden="true">Ⅱ</span>
                </button>
              </div>

              <div class="cc-primary-grid">
                <section class="cc-stage-card" t-att-data-scene="state.sceneEffect" aria-label="رحلة العناية البصرية">
                  <div class="cc-stage-head"><div><h2 class="cc-stage-title">رحلة العناية</h2><small>سيارة عرض · مسار توضيحي للمؤثرات</small></div><div><span class="cc-scene-live-tag"><i/> Odoo Live</span> <span class="cc-simulation-badge">محاكاة بصرية</span></div></div>
                  <div class="cc-showroom">
                    <div class="cc-studio-light" aria-hidden="true"/><div class="cc-halo" aria-hidden="true"/>
                    <div t-att-class="'cc-car-main' + (state.replaying ? ' is-replay' : '')"><img class="cc-vehicle-photo" src="/car_wash_dashboard/static/src/img/concept_car.webp" alt="سيارة Crystal Clean"/></div>
                    <div class="cc-rain" aria-hidden="true"><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/><i/></div><div class="cc-foam" aria-hidden="true"/><div class="cc-sparks" aria-hidden="true"><b>✦</b><b>✦</b><b>✦</b></div><div class="cc-scan" aria-hidden="true"/>
                    <button type="button" class="cc-floor-mark cc-replay" t-on-click="replayCar">↶ حركة السيارة</button><span class="cc-car-studio-note" t-if="heroCar"><t t-esc="heroCar.plate"/> · <t t-esc="heroCar.service_name"/></span><span class="cc-car-studio-note" t-else="">سيارة عرض</span>
                  </div>
                  <div class="cc-scene-state" aria-live="polite"><div><div class="cc-state-name"><i class="cc-status-dot"/><span t-esc="sceneInfo.title"/></div><p class="cc-state-description" t-esc="sceneInfo.desc"/></div><div class="cc-demo-percent"><span><t t-esc="sceneInfo.progress"/>%</span><small>إنجاز المسار التجريبي</small></div></div>
                  <div class="cc-journey" t-att-style="sceneJourneyStyle()"><div class="cc-track"><div class="cc-track-fill" t-att-style="sceneTrackStyle()"/></div><div class="cc-traveler" aria-hidden="true"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></div><div class="cc-nodes"><div class="cc-node" t-att-data-passed="sceneInfo.progress &gt;= 0" t-att-data-active="state.sceneEffect === 'wait'"><i/><span>انتظار</span></div><div class="cc-node" t-att-data-passed="sceneInfo.progress &gt;= 33" t-att-data-active="state.sceneEffect === 'wash' or state.sceneEffect === 'delay'"><i/><span>غسيل</span></div><div class="cc-node" t-att-data-passed="sceneInfo.progress &gt;= 67" t-att-data-active="state.sceneEffect === 'inspect'"><i/><span>فحص</span></div><div class="cc-node" t-att-data-passed="sceneInfo.progress &gt;= 100" t-att-data-active="state.sceneEffect === 'ready'"><i/><span>جاهزة</span></div></div></div>
                  <div class="cc-effects" aria-label="تجربة المؤثرات"><span class="cc-effects-label">جرّب تغيّر الحالة — المؤثرات بصرية فقط</span><button class="cc-effect" type="button" t-att-aria-pressed="state.sceneEffect === 'wait'" t-on-click="() => this.setScene('wait')">انتظار</button><button class="cc-effect" type="button" t-att-aria-pressed="state.sceneEffect === 'wash'" t-on-click="() => this.setScene('wash')">غسيل</button><button class="cc-effect" type="button" t-att-aria-pressed="state.sceneEffect === 'inspect'" t-on-click="() => this.setScene('inspect')">فحص</button><button class="cc-effect" type="button" t-att-aria-pressed="state.sceneEffect === 'ready'" t-on-click="() => this.setScene('ready')">جاهزة ✦</button><button class="cc-effect" type="button" data-effect="delay" t-att-aria-pressed="state.sceneEffect === 'delay'" t-on-click="() => this.setScene('delay')">تأخير</button></div>
                </section>

                <section class="cc-panel"><div class="cc-panel-head"><h2>السيارات الموثقة</h2><span class="cc-counter" t-esc="String(state.data.active_cars.length).padStart(2, '0')"/></div><p class="cc-panel-sub">اضغط على السيارة لعرض بياناتها المتاحة.</p><div class="cc-cars">
                  <t t-if="state.data.active_cars.length">
                    <t t-foreach="state.data.active_cars" t-as="car" t-key="car.id">
                      <div class="cc-row-wrap"><button type="button" t-att-class="'cc-car-row' + (state.expandedCarId === car.id ? ' is-expanded' : '')" t-on-click="() => this.toggleCar(car.id)"><span class="cc-thumb"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></span><span><b class="cc-plate" t-esc="car.plate"/><span class="cc-service" t-esc="car.service_name"/></span><span><span class="cc-progress-number"><t t-esc="car.progress"/>%</span><span class="cc-mini-track"><b t-att-style="progressStyle(car.progress)"/></span></span></button><div t-if="state.expandedCarId === car.id" class="cc-row-detail"><b t-esc="car.name"/> · <t t-esc="car.status_label"/><br/><span>المرحلة: </span><b t-esc="car.current_stage or '—'"/> · <button type="button" class="cc-action-btn" t-on-click="() => this.openProduction(car.id)">فتح أمر الغسيل</button></div></div>
                    </t>
                  </t><div t-else="" class="cc-empty">لا توجد سيارات نشطة حاليًا.</div>
                </div><div class="cc-panel-foot"><span><t t-esc="knownPlateCount"/> لوحات مسجلة من أصل <t t-esc="state.data.active_cars.length"/></span><span class="cc-num"><t t-esc="state.data.data_quality"/>%</span></div></section>
              </div>

              <div class="cc-lower">
                <section class="cc-panel"><div class="cc-panel-head"><h2>طابور المحطات</h2><span class="cc-label"><t t-esc="state.data.station_queue"/> مراحل منتظرة</span></div><div class="cc-load-body"><t t-foreach="state.data.workcenter_load.filter((w) => w.queue &gt; 0)" t-as="station" t-key="station.id"><div class="cc-load-line"><span><b class="cc-num" t-esc="station.name"/></span><div class="cc-load-bar"><i t-att-style="stationBarStyle(station)"/></div><span class="cc-load-count"><t t-esc="station.queue"/> مراحل</span></div></t><div t-if="!state.data.station_queue" class="cc-empty">لا توجد مراحل في الطابور.</div></div><div class="cc-panel-foot"><span>الطول يوضح حصة المحطة من الطابور</span><span><t t-esc="state.data.station_total"/> محطات إجمالًا</span></div></section>
                <section class="cc-panel"><div class="cc-panel-head"><h2>جاهزة للتسليم</h2><span class="cc-label">بيانات حية</span></div><div class="cc-ready-box" t-if="readyCar"><div><span class="cc-ready-plate cc-num" t-esc="readyCar.plate"/><small><t t-esc="readyCar.service_name"/> · <bdi class="cc-num" t-esc="readyCar.name"/></small></div><div class="cc-ready-check" aria-hidden="true">✓</div></div><div t-else="" class="cc-empty">لا توجد سيارة جاهزة للتسليم الآن.</div></section>
              </div>

              <section class="cc-panel cc-station-board" aria-label="حالة المحطات وسياراتها">
                <div class="cc-panel-head"><div><h2>المحطات، تتحرك أمامك.</h2><p class="cc-station-subtitle">سيارة لكل محطة · الحالة التشغيلية من Odoo</p></div><span class="cc-label"><t t-esc="state.data.station_total"/> محطات</span></div>
                <div class="cc-station-grid cc-dynamic-grid">
                  <t t-foreach="state.data.workcenter_load" t-as="station" t-key="station.id" t-foreach-index="idx">
                    <article t-att-class="'cc-station' + (state.selectedStationId === station.id ? ' is-selected' : '')" t-att-data-state="stationVisualState(station)" t-att-data-kind="stationKind(station)">
                      <button type="button" class="cc-station-button" t-on-click="() => this.selectStation(station.id)"><div class="cc-station-header"><span class="cc-station-id"><t t-esc="stationCode(idx)"/> · <t t-esc="station.name"/></span><span t-att-class="'cc-station-state ' + (stationVisualState(station) === 'working' ? 'cc-status-working' : (stationVisualState(station) === 'queue' ? 'cc-status-queue' : ''))"><i/><t t-esc="stationStateLabel(station)"/></span></div><span class="cc-station-name"><t t-esc="station.in_progress"/> قيد العمل · <t t-esc="station.queue"/> في الطابور</span><div class="cc-station-scene"><div class="cc-bay-roof"/><div class="cc-bay-floor"/><div class="cc-station-car"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></div><div class="cc-station-water"><i style="--drop-x:8%;--drop-delay:-.1s"/><i style="--drop-x:30%;--drop-delay:-.35s"/><i style="--drop-x:52%;--drop-delay:-.55s"/><i style="--drop-x:76%;--drop-delay:-.7s"/></div><div class="cc-station-light"/><div class="cc-station-spark">✦</div></div><div class="cc-station-metrics"><span>قيد العمل <b t-esc="station.in_progress"/></span><span>الطابور <b t-esc="station.queue"/></span><span>السعة <b t-esc="station.capacity"/></span></div></button>
                    </article>
                  </t>
                </div>
                <div class="cc-station-inspector" t-if="selectedStation"><div class="cc-station-inspector-top"><strong><t t-esc="selectedStation.name"/></strong><span class="cc-label">حالة Odoo الحالية</span></div><p>قيد العمل: <t t-esc="selectedStation.in_progress"/> · في الطابور: <t t-esc="selectedStation.queue"/> · السعة: <t t-esc="selectedStation.capacity"/></p><div class="cc-station-demo-controls"><span>جرّب حركة السيارة:</span><button type="button" t-att-aria-pressed="state.stationDemo === 'snapshot'" t-on-click="() => this.setStationDemo('snapshot')">حالة Odoo</button><button type="button" t-att-aria-pressed="state.stationDemo === 'idle'" t-on-click="() => this.setStationDemo('idle')">متاحة</button><button type="button" t-att-aria-pressed="state.stationDemo === 'queue'" t-on-click="() => this.setStationDemo('queue')">انتظار</button><button type="button" t-att-aria-pressed="state.stationDemo === 'working'" t-on-click="() => this.setStationDemo('working')">قيد العمل</button><button type="button" class="cc-action-btn" t-on-click="() => this.openWorkcenter(selectedStation)">فتح المراحل</button></div></div>
              </section>
            </section>

            <!-- OWNER TAB -->
            <section t-if="state.activeTab === 'owner'" id="cc-owner" role="tabpanel">
              <div class="cc-heading"><div><span class="cc-kicker">BUSINESS OVERVIEW</span><h1>الأرقام، بمعناها الصحيح.</h1><p>طلبات نقطة البيع والفواتير والذمم · لكل رقم مصدره.</p></div><span class="cc-label">العملة: <t t-esc="state.data.currency_symbol or 'الدينار الليبي'"/></span></div>
              <div class="cc-finance-grid">
                <button type="button" class="cc-stat cc-stat-interactive"><span class="cc-stat-name">طلبات نقطة البيع</span><strong class="cc-stat-value">—</strong><span class="cc-stat-note cc-owner-pos-unlinked">سيتم ربط POS في مرحلة التهيئة التالية</span><span class="cc-stat-animation cc-anim-receipt" aria-hidden="true"><i/><i/><i/></span></button>
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openAccounting('invoiced_today')"><span class="cc-stat-name">الفواتير المرحلة · اليوم</span><strong class="cc-stat-value" t-esc="state.data.posted_invoices_today"/><span class="cc-stat-note">فاتورة</span><span class="cc-stat-animation cc-anim-stamp" aria-hidden="true">✓</span></button>
                <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openAccounting('invoiced_today')"><span class="cc-stat-name">قيمة الفواتير المرحلة</span><strong class="cc-stat-value"><t t-esc="formatMoney(state.data.invoiced_today)"/></strong><span class="cc-stat-note">إجمالي القيمة</span><span class="cc-stat-animation cc-anim-balance" aria-hidden="true">≋</span></button>
                <button type="button" class="cc-stat cc-stat-interactive cc-ready" t-on-click="() => this.openAccounting('receivable_open')"><span class="cc-stat-name">الذمم المفتوحة</span><strong class="cc-stat-value"><t t-esc="formatMoney(state.data.receivable_open)"/></strong><span class="cc-stat-note">مبالغ مستحقة غير محصلة</span></button>
              </div>
              <section class="cc-panel"><div class="cc-panel-head"><h2>مواد العناية</h2><span class="cc-label"><t t-esc="Math.min(6, state.data.materials.length)"/> مواد مفصلة من أصل <t t-esc="state.data.materials.length"/></span></div><p class="cc-panel-sub">الكميات من Odoo مباشرة، دون افتراض وحدات أو حد أدنى.</p><table class="cc-material-table"><thead><tr><th scope="col">المادة</th><th scope="col">بالمخزون</th><th scope="col">محجوز</th><th scope="col">متاح</th></tr></thead><tbody><t t-foreach="state.data.materials.slice(0,6)" t-as="item" t-key="item.product_id"><tr t-att-data-selected="state.selectedMaterialId === item.product_id" t-on-click="() => this.selectMaterial(item.product_id)"><td><button type="button" class="cc-material-value" t-on-click.stop="() => this.openProduct(item.product_id)" t-esc="item.product_name"/></td><td t-esc="item.on_hand"/><td t-esc="item.reserved"/><td t-esc="item.free"/></tr></t></tbody></table><div class="cc-material-note">حدود إعادة الطلب غير مفترضة؛ أي تحذير يعتمد فقط على إعدادات Odoo الفعلية.</div></section>
            </section>

            <!-- CUSTOMER TAB -->
            <section t-if="state.activeTab === 'customer'" id="cc-customer" role="tabpanel">
              <div class="cc-heading"><div><span class="cc-kicker">CUSTOMER LOUNGE</span><h1>انتظار أكثر راحة.</h1><p>شاشة صالة الانتظار لعرض حالة السيارة والجاهزية.</p></div><span class="cc-label">معاينة شاشة الزبائن</span></div>
              <div class="cc-customer-screen"><div class="cc-customer-title"><div><h2>سيارتك في عنايتنا.</h2><small>كريستال كلين · العناية بالتفاصيل</small></div><span class="cc-customer-tag">شاشة الزبائن</span></div><div class="cc-customer-hero"><div t-if="readyCar"><span class="cc-customer-tag">✓ اكتملت العناية</span><h3>سيارتك جاهزة<br/>للتسليم.</h3><span class="cc-ready-plate" t-esc="readyCar.plate"/></div><div t-else=""><span class="cc-customer-tag">العناية مستمرة</span><h3>سيارتك في<br/>عنايتنا.</h3><span class="cc-ready-plate">CRYSTAL CLEAN</span></div><div class="cc-customer-car" aria-hidden="true"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></div></div><div class="cc-waiting-customer"><t t-foreach="state.data.active_cars.slice(0,4)" t-as="car" t-key="car.id"><div class="cc-customer-order"><button type="button" t-on-click="() => this.openProduction(car.id)"><small t-esc="car.service_name"/><b t-esc="car.plate"/><span class="cc-lounge-status" t-esc="car.status_label"/><div class="cc-lounge-thumbnail"><img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/></div><div class="cc-mini-track"><b t-att-style="progressStyle(car.progress)"/></div></button></div></t></div></div><p class="cc-customer-note">عرض السيارات والجاهزية فقط؛ التفاصيل التشغيلية تبقى داخل لوحة المغسلة.</p>
            </section>

            <footer class="cc-footer"><span>التقدم = المراحل المنتهية ÷ إجمالي المراحل · البيانات التشغيلية من Odoo</span><span class="cc-num">CRYSTAL CLEAN / ODOO DASHBOARD</span></footer>
          </main>
        </t>
      </div>
    </div>
  </t>
</templates>
