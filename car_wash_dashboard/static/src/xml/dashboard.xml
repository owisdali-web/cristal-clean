<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="car_wash_dashboard.CarWashDashboard">
    <div class="o_car_wash_dashboard cc-odoo-shell">
      <div id="crystal-concept" t-att-data-section="state.activeSection">
        <div class="cc-v7-shell">
          <aside class="cc-v7-sidebar">
            <div class="cc-v7-brand"><div class="cc-v7-brand-mark"><i class="fa fa-car"/><span>●</span></div><div><strong>غسيل السيارات</strong><small>CAR WASH MANAGEMENT</small></div></div>
            <nav class="cc-v7-side-nav" aria-label="قوائم لوحة المغسلة">
              <button type="button" t-att-aria-selected="state.activeSection === 'overview'" t-on-click="() => this.setSection('overview')"><i class="fa fa-home"/><span>لوحة التحكم العامة</span></button>
              <button type="button" t-att-aria-selected="state.activeSection === 'automatic'" t-on-click="() => this.setSection('automatic')"><i class="fa fa-car"/><span>الغسيل الآلي</span></button>
              <button type="button" t-att-aria-selected="state.activeSection === 'manual'" t-on-click="() => this.setSection('manual')"><i class="fa fa-hand-paper-o"/><span>الغسيل اليدوي</span></button>
              <button type="button" t-att-aria-selected="state.activeSection === 'reports'" t-on-click="() => this.setSection('reports')"><i class="fa fa-file-text-o"/><span>التقارير</span></button>
            </nav>
            <div class="cc-v7-sidebar-art"><div class="cc-v7-art-bubbles"><i/><i/><i/><i/></div><i class="fa fa-car"/><strong>سيارات أنظف</strong><span>لحياة أجمل</span><small>CLEAN CARS · BRIGHTER DAYS</small></div>
          </aside>

          <div class="cc-v7-main">
            <header class="cc-v7-topbar">
              <div class="cc-v7-search"><i class="fa fa-search"/><input type="search" placeholder="البحث عن سيارة، عميل، أو رقم لوحة..." t-att-value="state.searchTerm" t-on-input="onSearchInput"/></div>
              <div class="cc-v7-top-actions"><button type="button" class="cc-v7-icon-button" t-on-click="manualRefresh" title="تحديث"><i class="fa fa-refresh"/></button><button type="button" class="cc-v7-icon-button" t-on-click="toggleFullscreen" title="ملء الشاشة"><i class="fa fa-expand"/></button><div class="cc-v7-user"><span class="cc-v7-avatar" t-esc="userInitials"/><div><strong t-esc="state.data.user_name || 'مستخدم Odoo'"/><small t-esc="state.data.company_name"/></div></div></div>
            </header>

            <div t-if="state.loading" class="cc-loading-shell"><div class="cc-loading-box"><i class="fa fa-spinner fa-spin"/> جاري تحميل بيانات المغسلة…</div></div>
            <main t-else="" class="cc-v7-content">
          <section t-if="state.activeSection === 'overview'" class="cc-v7-overview">
            <t t-set="auto" t-value="modeData('automatic')"/>
            <t t-set="manual" t-value="modeData('manual')"/>

            <div class="cc-v7-page-head">
              <div class="cc-v7-title-wrap">
                <span class="cc-v7-title-icon"><i class="fa fa-tint"/></span>
                <div><h1>لوحة تشغيل المغسلة</h1><p>مراقبة سير العمل والأداء في جميع أقسام المغسلة لحظة بلحظة</p></div>
              </div>
              <div class="cc-v7-head-meta">
                <div class="cc-v7-meta-card"><i class="fa fa-calendar"/><div><strong t-esc="currentDateLabel"/><span>آخر تحديث <t t-esc="state.lastUpdate or '—'"/></span></div></div>
                <div class="cc-v7-meta-card cc-v7-status-card"><span class="cc-v7-live-pulse"/><div><strong t-esc="state.data.company_city || state.data.company_name"/><span>البيانات متصلة مباشرة بـ Odoo</span></div></div>
              </div>
            </div>

            <div class="cc-v7-kpi-row">
              <button type="button" class="cc-v7-kpi cc-v7-kpi-revenue" t-on-click="openSales"><span class="cc-v7-kpi-icon"><i class="fa fa-money"/></span><div><small>الإيراد اليومي</small><strong t-esc="formatMoney(state.data.revenue_today)"/><span>مبيعات خدمات الغسيل</span></div></button>
              <button type="button" class="cc-v7-kpi cc-v7-kpi-done" t-on-click="() => this.openKpi('done_today')"><span class="cc-v7-kpi-icon"><i class="fa fa-check"/></span><div><small>المكتملة</small><strong class="cc-num" t-esc="state.data.done_today"/><span>مكتملة اليوم</span></div></button>
              <button type="button" class="cc-v7-kpi cc-v7-kpi-wait" t-on-click="() => this.openKpi('waiting')"><span class="cc-v7-kpi-icon"><i class="fa fa-clock-o"/></span><div><small>في الانتظار</small><strong class="cc-num" t-esc="state.data.waiting"/><span>تنتظر الخدمة</span></div></button>
              <button type="button" class="cc-v7-kpi cc-v7-kpi-progress" t-on-click="() => this.openKpi('in_progress')"><span class="cc-v7-kpi-icon"><i class="fa fa-cog"/></span><div><small>قيد التنفيذ</small><strong class="cc-num" t-esc="state.data.in_progress"/><span>حاليًا في الخدمة</span></div></button>
              <button type="button" class="cc-v7-kpi cc-v7-kpi-total" t-on-click="() => this.openKpi('total_today')"><span class="cc-v7-kpi-icon"><i class="fa fa-car"/></span><div><small>إجمالي السيارات اليوم</small><strong class="cc-num" t-esc="state.data.total_today"/><span>منذ بداية اليوم</span></div></button>
            </div>

            <div class="cc-v7-wash-showcase">
              <article class="cc-v7-feature cc-v7-auto-feature">
                <div class="cc-v7-feature-overlay"/>
                <div class="cc-v7-feature-copy">
                  <div class="cc-v7-feature-heading"><span class="cc-v7-feature-icon"><i class="fa fa-car"/></span><div><h2>الغسيل الآلي</h2><p>سرعة عالية · نظافة فائقة · بتقنية متقدمة</p></div></div>
                  <div class="cc-v7-vehicle-tiles">
                    <div class="cc-v7-vehicle-tile"><div><strong>سيارة صغيرة</strong><span><t t-esc="auto.vehicle_counts.small"/> اليوم</span></div><img src="/car_wash_dashboard/static/src/img/car_modern_small.svg" alt="سيارة صغيرة"/></div>
                    <div class="cc-v7-vehicle-tile"><div><strong>سيارة كبيرة</strong><span><t t-esc="auto.vehicle_counts.large"/> اليوم</span></div><img src="/car_wash_dashboard/static/src/img/car_modern_large.svg" alt="سيارة كبيرة"/></div>
                  </div>
                  <button type="button" class="cc-v7-feature-action" t-on-click="() => this.setSection('automatic')"><i class="fa fa-play"/> فتح الغسيل الآلي</button>
                </div>
                <div class="cc-v7-feature-scene cc-v7-auto-scene">
                  <div class="cc-v7-auto-arch"><b>AUTO WASH</b><i/><i/><i/></div>
                  <div class="cc-v7-auto-brush cc-v7-left-brush"/><div class="cc-v7-auto-brush cc-v7-right-brush"/>
                  <div class="cc-v7-water-jets"><i/><i/><i/><i/><i/></div>
                  <img src="/car_wash_dashboard/static/src/img/concept_car.webp" class="cc-v7-hero-car" alt="سيارة داخل الغسيل الآلي"/>
                  <div class="cc-v7-floor-reflection"/>
                </div>
                <div class="cc-v7-feature-list"><span><i class="fa fa-tint"/> غسيل بالضغط العالي</span><span><i class="fa fa-cloud"/> رغوة شاملة</span><span><i class="fa fa-refresh"/> فرش متحركة</span><span><i class="fa fa-shower"/> شطف بالماء</span><span><i class="fa fa-sun-o"/> تجفيف قوي</span></div>
                <div class="cc-v7-feature-foot">نظافة تلقائية بمعايير تشغيل واضحة <i class="fa fa-leaf"/></div>
              </article>

              <article class="cc-v7-feature cc-v7-manual-feature">
                <div class="cc-v7-feature-overlay"/>
                <div class="cc-v7-feature-copy">
                  <div class="cc-v7-feature-heading"><span class="cc-v7-feature-icon"><i class="fa fa-hand-paper-o"/></span><div><h2>الغسيل اليدوي</h2><p>عناية شخصية · تفاصيل أكثر · لمعان يدوم</p></div></div>
                  <div class="cc-v7-vehicle-tiles">
                    <div class="cc-v7-vehicle-tile"><div><strong>سيارة صغيرة</strong><span><t t-esc="manual.vehicle_counts.small"/> اليوم</span></div><img src="/car_wash_dashboard/static/src/img/car_modern_small.svg" alt="سيارة صغيرة"/></div>
                    <div class="cc-v7-vehicle-tile"><div><strong>سيارة كبيرة</strong><span><t t-esc="manual.vehicle_counts.large"/> اليوم</span></div><img src="/car_wash_dashboard/static/src/img/car_modern_large.svg" alt="سيارة كبيرة"/></div>
                  </div>
                  <button type="button" class="cc-v7-feature-action" t-on-click="() => this.setSection('manual')"><i class="fa fa-play"/> فتح الغسيل اليدوي</button>
                </div>
                <div class="cc-v7-feature-scene cc-v7-manual-scene">
                  <div class="cc-v7-garage-light one"/><div class="cc-v7-garage-light two"/>
                  <img src="/car_wash_dashboard/static/src/img/concept_car.webp" class="cc-v7-hero-car" alt="سيارة داخل الغسيل اليدوي"/>
                  <div class="cc-v7-worker"><span class="cc-v7-worker-head"/><span class="cc-v7-worker-body"/><i class="cc-v7-worker-arm"/><b class="cc-v7-spray-gun"/></div>
                  <div class="cc-v7-manual-spray"><i/><i/><i/><i/><i/></div><div class="cc-v7-foam-cloud"><b/><b/><b/><b/><b/></div>
                  <div class="cc-v7-bucket"><i/></div><div class="cc-v7-floor-reflection"/>
                </div>
                <div class="cc-v7-feature-foot">عناية تستحق سيارتك <i class="fa fa-star"/></div>
              </article>
            </div>

            <div class="cc-v7-bottom-grid">
              <section class="cc-v7-widget cc-v7-stations-widget">
                <div class="cc-v7-widget-head"><h3><i class="fa fa-building-o"/> حالة المحطات</h3><button type="button" t-on-click="openShopFloor">عرض الكل</button></div>
                <div class="cc-v7-station-list">
                  <t t-foreach="state.data.workcenter_load.slice(0,4)" t-as="station" t-key="station.id" t-foreach-index="idx">
                    <button type="button" class="cc-v7-station-mini" t-att-data-state="stationSnapshotState(station)" t-on-click="() => this.openWorkcenter(station)"><span class="cc-v7-station-num">المحطة <t t-esc="idx + 1"/></span><i class="fa fa-car"/><strong t-esc="station.name"/><small><span class="cc-v7-state-dot"/><t t-esc="stationStateLabel(station)"/></small></button>
                  </t>
                  <div t-if="!state.data.workcenter_load.length" class="cc-v7-empty">لا توجد محطات متاحة.</div>
                </div>
              </section>

              <section class="cc-v7-widget cc-v7-queue-widget">
                <div class="cc-v7-widget-head"><h3><i class="fa fa-users"/> قائمة الانتظار</h3><span><t t-esc="state.data.active_total"/> نشطة</span></div>
                <div class="cc-v7-queue-list">
                  <t t-foreach="queueCars" t-as="car" t-key="car.id" t-foreach-index="idx">
                    <button type="button" t-on-click="() => this.openProduction(car.id)"><b class="cc-v7-queue-rank" t-esc="idx + 1"/><img t-att-src="vehicleImage(car)" alt=""/><div><strong t-esc="car.plate"/><span><t t-esc="car.vehicle_model || car.service_name"/></span></div><small><t t-esc="car.started_at or '—'"/><em t-att-data-method="car.wash_method" t-esc="car.wash_method_label"/></small></button>
                  </t>
                  <div t-if="!queueCars.length" class="cc-v7-empty">لا توجد سيارات في القائمة.</div>
                </div>
              </section>

              <section class="cc-v7-widget cc-v7-time-widget">
                <div class="cc-v7-widget-head"><h3><i class="fa fa-clock-o"/> متوسط زمن الخدمة</h3></div>
                <div class="cc-v7-time-body"><div><strong class="cc-num" t-esc="state.data.avg_turnaround"/><span>دقيقة</span><small>متوسط الوقت لكل سيارة</small></div><div class="cc-v7-time-ring"><i class="fa fa-clock-o"/></div></div>
              </section>

              <section class="cc-v7-widget cc-v7-revenue-widget">
                <div class="cc-v7-widget-head"><h3><i class="fa fa-pie-chart"/> توزيع الإيرادات اليوم</h3></div>
                <div class="cc-v7-revenue-body"><div class="cc-v7-donut" t-att-style="revenueSplitStyle()"><div><small t-esc="state.data.currency_symbol"/><strong t-esc="Number(state.data.revenue_today || 0).toLocaleString()"/></div></div><div class="cc-v7-revenue-legend"><span class="auto"><i/>الغسيل الآلي <b><t t-esc="automaticRevenuePercent"/>%</b><small t-esc="formatMoney(auto.revenue_today, auto)"/></span><span class="manual"><i/>الغسيل اليدوي <b><t t-esc="manualRevenuePercent"/>%</b><small t-esc="formatMoney(manual.revenue_today, manual)"/></span></div></div>
              </section>
            </div>
          </section>
          <!-- AUTOMATIC / MANUAL -->
          <section t-if="state.activeSection === 'automatic' || state.activeSection === 'manual'" t-att-class="'cc-section-mode cc-mode-' + state.activeSection">
            <div class="cc-heading">
              <div><span class="cc-kicker"><t t-esc="state.activeSection === 'automatic' ? 'AUTOMATIC WASH' : 'MANUAL WASH'"/></span><h1 t-esc="currentModeLabel"/><p t-if="state.activeSection === 'automatic'">لوحة مستقلة لمسار الغسيل الآلي وماكيناته وتقاريره.</p><p t-else="">لوحة مستقلة لمسار الغسيل اليدوي ومحطاته وتقاريره.</p></div>
              <span class="cc-label"><span class="cc-dot"/> بيانات مفلترة: <t t-esc="currentModeLabel"/></span>
            </div>

            <div class="cc-kpis cc-kpis-six">
              <button class="cc-stat cc-stat-interactive" type="button" t-on-click="() => this.openKpi('total_today')"><span class="cc-stat-name">سيارات اليوم</span><strong class="cc-stat-value" t-esc="state.data.total_today"/><span class="cc-stat-note" t-esc="currentModeLabel"/></button>
              <button class="cc-stat cc-stat-interactive" type="button" t-on-click="() => this.openKpi('active_total')"><span class="cc-stat-name">نشطة الآن</span><strong class="cc-stat-value" t-esc="state.data.active_total"/><span class="cc-stat-note">داخل المسار</span></button>
              <button class="cc-stat cc-stat-interactive" type="button" t-on-click="() => this.openKpi('in_progress')"><span class="cc-stat-name">قيد الغسيل</span><strong class="cc-stat-value" t-esc="state.data.in_progress"/><span class="cc-stat-note">تعمل الآن</span></button>
              <button class="cc-stat cc-stat-interactive" type="button" t-on-click="() => this.openKpi('waiting')"><span class="cc-stat-name">انتظار</span><strong class="cc-stat-value" t-esc="state.data.waiting"/><span class="cc-stat-note">بانتظار البدء</span></button>
              <button class="cc-stat cc-stat-interactive cc-ready" type="button" t-on-click="() => this.openKpi('done_today')"><span class="cc-stat-name">مكتملة</span><strong class="cc-stat-value" t-esc="state.data.done_today"/><span class="cc-stat-note">اليوم</span></button>
              <button class="cc-stat cc-stat-interactive" type="button" t-on-click="openSales"><span class="cc-stat-name">الإيراد</span><strong class="cc-stat-value cc-money" t-esc="formatMoney(state.data.revenue_today)"/><span class="cc-stat-note">خاص بهذا النوع</span></button>
            </div>

            <div class="cc-mode-main-grid">
              <section t-if="state.activeSection === 'automatic'" class="cc-mode-scene-card cc-auto-card">
                <div class="cc-stage-head"><div><span class="cc-stage-title">نفق الغسيل الآلي</span><small>دخول · رش · فرش دوارة · شطف · التجفيف</small></div><span class="cc-mode-badge">AUTOMATIC</span></div>
                <div class="cc-auto-tunnel">
                  <div class="cc-auto-arch"><i/><i/><i/></div><div class="cc-auto-rail"/><div class="cc-auto-sprays"><i/><i/><i/><i/><i/><i/></div>
                  <div class="cc-auto-brush cc-brush-left"><b/><span/></div><div class="cc-auto-brush cc-brush-top"><b/><span/></div><div class="cc-auto-brush cc-brush-right"><b/><span/></div>
                  <img t-att-src="vehicleImage(heroCar)" class="cc-mode-car" alt="سيارة داخل الغسيل الآلي"/><div class="cc-auto-dryer"><i/><i/><i/></div><div class="cc-auto-floor-glow"/>
                </div>
                <div class="cc-mode-scene-footer"><span><i class="fa fa-cogs"/> ماكينة الغسيل الآلي</span><span><i class="fa fa-tint"/> رش وفرش متحركة</span><span><i class="fa fa-sun-o"/> التجفيف الآلي</span></div>
              </section>

              <section t-else="" class="cc-mode-scene-card cc-manual-card">
                <div class="cc-stage-head"><div><span class="cc-stage-title">منطقة الغسيل اليدوي</span><small>رغوة · ضغط ماء · تنظيف يدوي · التجفيف</small></div><span class="cc-mode-badge">MANUAL</span></div>
                <div class="cc-manual-bay">
                  <div class="cc-manual-wall"/><div class="cc-manual-floor"/><img t-att-src="vehicleImage(heroCar)" class="cc-mode-car" alt="سيارة داخل الغسيل اليدوي"/>
                  <div class="cc-washer-person"><span class="cc-person-head"/><span class="cc-person-body"/><i class="cc-person-arm"/><i class="cc-person-leg one"/><i class="cc-person-leg two"/></div>
                  <div class="cc-pressure-gun"><span/><i/></div><div class="cc-hose"/><div class="cc-manual-spray"><i/><i/><i/><i/><i/></div><div class="cc-manual-foam"><b/><b/><b/><b/><b/><b/></div>
                  <div class="cc-manual-bucket"><i/></div>
                </div>
                <div class="cc-mode-scene-footer"><span><i class="fa fa-hand-paper-o"/> غسيل يدوي</span><span><i class="fa fa-shower"/> ضغط ماء ورغوة</span><span><i class="fa fa-sun-o"/> التجفيف اليدوي</span></div>
              </section>

              <section class="cc-panel cc-active-panel">
                <div class="cc-panel-head"><div><h2>سيارات <t t-esc="currentModeLabel"/></h2><p class="cc-panel-sub">كل سيارة هنا مفلترة حسب نوع الغسيل</p></div><span class="cc-label"><t t-esc="state.data.active_cars.length"/> نشطة</span></div>
                <div class="cc-live-car-list cc-mode-live-list">
                  <t t-foreach="state.data.active_cars.slice(0,7)" t-as="car" t-key="car.id"><button type="button" class="cc-live-car" t-on-click="() => this.openProduction(car.id)"><img t-att-src="vehicleImage(car)" alt=""/><div><strong t-esc="car.plate"/><span><t t-esc="car.current_stage"/> · <t t-esc="car.status_label"/></span></div><em class="cc-num"><t t-esc="car.progress"/>%</em></button></t>
                  <div t-if="!state.data.active_cars.length" class="cc-empty">لا توجد سيارات نشطة في <t t-esc="currentModeLabel"/> الآن.</div>
                </div>
              </section>
            </div>

            <div class="cc-mode-report-strip">
              <article><small>متوسط زمن الإنجاز</small><strong class="cc-num"><t t-esc="state.data.avg_turnaround"/> د</strong><span>للسيارات المكتملة اليوم</span></article>
              <article><small>متوسط التذكرة</small><strong t-esc="formatMoney(state.data.avg_ticket)"/><span>مبيعات هذا النوع</span></article>
              <article><small>المحطات المشغولة</small><strong class="cc-num"><t t-esc="state.data.station_busy"/>/<t t-esc="state.data.station_total"/></strong><span>نشاط حالي</span></article>
              <article><small>طابور المراحل</small><strong class="cc-num" t-esc="state.data.station_queue"/><span>بانتظار المحطة</span></article>
            </div>

            <section class="cc-panel cc-station-board cc-mode-stations">
              <div class="cc-panel-head"><div><h2>محطات <t t-esc="currentModeLabel"/></h2><p class="cc-station-subtitle">تظهر المحطات التي تحتوي عمليات نشطة لهذا النوع</p></div><span class="cc-label"><t t-esc="state.data.station_total"/> محطة</span></div>
              <div class="cc-station-grid cc-dynamic-grid">
                <t t-foreach="state.data.workcenter_load" t-as="station" t-key="station.id" t-foreach-index="idx">
                  <article t-att-class="'cc-station' + (state.selectedStationId === station.id ? ' is-selected' : '')" t-att-data-kind="stationKind(station)" t-att-data-state="stationVisualState(station)">
                    <button type="button" class="cc-station-button" t-on-click="() => this.selectStation(station.id)">
                      <div class="cc-station-header"><span class="cc-station-id"><t t-esc="stationCode(idx)"/> · <t t-esc="station.name"/></span><span class="cc-station-state"><i/><t t-esc="stationStateLabel(station)"/></span></div>
                      <div t-if="state.activeSection === 'automatic'" class="cc-station-scene cc-mini-auto"><div class="cc-mini-arch"/><div class="cc-mini-brush left"/><div class="cc-mini-brush right"/><div class="cc-station-car"><img src="/car_wash_dashboard/static/src/img/car_modern_small.svg" alt=""/></div><div class="cc-station-water"><i style="--drop-x:20%"/><i style="--drop-x:45%"/><i style="--drop-x:70%"/></div></div>
                      <div t-else="" class="cc-station-scene cc-mini-manual"><div class="cc-mini-worker"><i/><b/></div><div class="cc-mini-hose"/><div class="cc-station-car"><img src="/car_wash_dashboard/static/src/img/car_modern_small.svg" alt=""/></div><div class="cc-manual-foam-mini">•••</div></div>
                      <div class="cc-station-metrics"><span>قيد العمل <b t-esc="station.in_progress"/></span><span>الطابور <b t-esc="station.queue"/></span><span>السعة <b t-esc="station.capacity"/></span></div>
                    </button>
                  </article>
                </t>
                <div t-if="!state.data.workcenter_load.length" class="cc-empty cc-wide-empty">لا توجد محطة نشطة مرتبطة بهذا النوع حاليًا.</div>
              </div>
            </section>
          </section>

          <!-- REPORTS -->
          <section t-if="state.activeSection === 'reports'" class="cc-section-reports">
            <t t-set="auto" t-value="modeData('automatic')"/><t t-set="manual" t-value="modeData('manual')"/>
            <div class="cc-heading"><div><span class="cc-kicker">WASH REPORTS</span><h1>تقارير الغسيل، مفصولة بوضوح.</h1><p>مقارنة مباشرة بين الآلي واليدوي مع إمكانية فتح السجلات الأصلية في Odoo.</p></div><span class="cc-label">اليوم · <t t-esc="state.data.company_name"/></span></div>

            <div class="cc-report-comparison">
              <article class="cc-report-method cc-report-auto">
                <div class="cc-report-method-head"><div><span class="cc-report-icon"><i class="fa fa-cogs"/></span><div><small>AUTOMATIC</small><h2>تقرير الغسيل الآلي</h2></div></div><button type="button" class="cc-action-btn" t-on-click="() => this.setSection('automatic')">فتح اللوحة</button></div>
                <div class="cc-report-metrics"><button t-on-click="() => this.openReportKpi('automatic','total_today')"><small>اليوم</small><strong t-esc="auto.total_today"/></button><button t-on-click="() => this.openReportKpi('automatic','active_total')"><small>نشطة</small><strong t-esc="auto.active_total"/></button><button t-on-click="() => this.openReportKpi('automatic','done_today')"><small>مكتملة</small><strong t-esc="auto.done_today"/></button><button t-on-click="() => this.openReportSales('automatic')"><small>الإيراد</small><strong class="cc-small-money" t-esc="formatMoney(auto.revenue_today, auto)"/></button></div>
                <div class="cc-report-summary"><span>متوسط الإنجاز <b class="cc-num"><t t-esc="auto.avg_turnaround"/> د</b></span><span>متوسط التذكرة <b t-esc="formatMoney(auto.avg_ticket, auto)"/></span><span>الطابور <b class="cc-num" t-esc="auto.station_queue"/></span></div>
                <div class="cc-report-chart"><t t-foreach="auto.trend" t-as="item" t-key="item.date"><div><i t-att-style="trendBarStyle(auto,item.count)"/><small t-esc="item.label"/><b class="cc-num" t-esc="item.count"/></div></t></div>
              </article>

              <article class="cc-report-method cc-report-manual">
                <div class="cc-report-method-head"><div><span class="cc-report-icon"><i class="fa fa-hand-paper-o"/></span><div><small>MANUAL</small><h2>تقرير الغسيل اليدوي</h2></div></div><button type="button" class="cc-action-btn" t-on-click="() => this.setSection('manual')">فتح اللوحة</button></div>
                <div class="cc-report-metrics"><button t-on-click="() => this.openReportKpi('manual','total_today')"><small>اليوم</small><strong t-esc="manual.total_today"/></button><button t-on-click="() => this.openReportKpi('manual','active_total')"><small>نشطة</small><strong t-esc="manual.active_total"/></button><button t-on-click="() => this.openReportKpi('manual','done_today')"><small>مكتملة</small><strong t-esc="manual.done_today"/></button><button t-on-click="() => this.openReportSales('manual')"><small>الإيراد</small><strong class="cc-small-money" t-esc="formatMoney(manual.revenue_today, manual)"/></button></div>
                <div class="cc-report-summary"><span>متوسط الإنجاز <b class="cc-num"><t t-esc="manual.avg_turnaround"/> د</b></span><span>متوسط التذكرة <b t-esc="formatMoney(manual.avg_ticket, manual)"/></span><span>الطابور <b class="cc-num" t-esc="manual.station_queue"/></span></div>
                <div class="cc-report-chart"><t t-foreach="manual.trend" t-as="item" t-key="item.date"><div><i t-att-style="trendBarStyle(manual,item.count)"/><small t-esc="item.label"/><b class="cc-num" t-esc="item.count"/></div></t></div>
              </article>
            </div>

            <div class="cc-finance-grid cc-report-finance">
              <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openAccounting('invoiced_today')"><span class="cc-stat-name">الفواتير المرحلة · اليوم</span><strong class="cc-stat-value" t-esc="state.data.posted_invoices_today"/><span class="cc-stat-note">شركة المغسلة كاملة</span></button>
              <button type="button" class="cc-stat cc-stat-interactive" t-on-click="() => this.openAccounting('invoiced_today')"><span class="cc-stat-name">قيمة الفواتير</span><strong class="cc-stat-value cc-money" t-esc="formatMoney(state.data.invoiced_today)"/><span class="cc-stat-note">مرحلة اليوم</span></button>
              <button type="button" class="cc-stat cc-stat-interactive cc-ready" t-on-click="() => this.openAccounting('receivable_open')"><span class="cc-stat-name">الذمم المفتوحة</span><strong class="cc-stat-value cc-money" t-esc="formatMoney(state.data.receivable_open)"/><span class="cc-stat-note">غير محصلة</span></button>
              <article class="cc-stat"><span class="cc-stat-name">سجلات غير مصنفة</span><strong class="cc-stat-value" t-esc="state.data.method_counts.unclassified"/><span class="cc-stat-note">تحتاج تحديد آلي أو يدوي</span></article>
            </div>

            <section class="cc-panel"><div class="cc-panel-head"><div><h2>مواد العناية</h2><p class="cc-panel-sub">المخزون الفعلي من Odoo</p></div><span class="cc-label"><t t-esc="materialPreviewCount()"/> مواد</span></div><table class="cc-material-table"><thead><tr><th>المادة</th><th>بالمخزون</th><th>محجوز</th><th>متاح</th></tr></thead><tbody><t t-foreach="state.data.materials.slice(0,6)" t-as="item" t-key="item.product_id"><tr t-on-click="() => this.openProduct(item.product_id)"><td t-esc="item.product_name"/><td t-esc="item.on_hand"/><td t-esc="item.reserved"/><td t-esc="item.free"/></tr></t></tbody></table></section>
          </section>

              <footer class="cc-v7-footer"><span>Odoo · غسيل السيارات · لوحة تشغيل مباشرة</span><span>معًا نحو تشغيل أسرع وتجربة أفضل</span></footer>
            </main>
          </div>
        </div>
      </div>
    </div>
  </t>
</templates>
