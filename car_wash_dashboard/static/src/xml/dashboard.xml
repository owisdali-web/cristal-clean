<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="car_wash_dashboard.CarWashDashboard">
    <div class="cc7-root" dir="rtl">
      <div t-if="state.loading" class="cc7-loading">
        <div class="cc7-loader-drop"><i class="fa fa-tint"></i></div>
        <strong>جاري تحميل لوحة المغسلة...</strong>
      </div>

      <div t-else="" class="cc7-layout">
        <!-- RIGHT NAVIGATION -->
        <aside class="cc7-sidebar">
          <button class="cc7-side-item is-active" t-on-click="() => this.openSidebar('home')"><i class="fa fa-home"></i><span>الرئيسية</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('cars')"><i class="fa fa-car"></i><span>السيارات</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('appointments')"><i class="fa fa-calendar"></i><span>المواعيد</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('stations')"><i class="fa fa-building"></i><span>المحطات</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('customers')"><i class="fa fa-users"></i><span>العملاء</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('inventory')"><i class="fa fa-cube"></i><span>المخزون</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('sales')"><i class="fa fa-shopping-cart"></i><span>المبيعات</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('reports')"><i class="fa fa-bar-chart"></i><span>التقارير</span></button>
          <button class="cc7-side-item" t-on-click="() => this.openSidebar('settings')"><i class="fa fa-cog"></i><span>الإعدادات</span></button>
          <div class="cc7-side-promo">
            <div class="cc7-side-promo-bubbles"><b></b><b></b><b></b></div>
            <strong>كريستال كلين</strong>
            <span>أكثر من مغسلة<br/>... تجربة مميزة</span>
            <img src="/car_wash_dashboard/static/src/img/concept_car.webp" alt=""/>
          </div>
        </aside>

        <!-- DASHBOARD -->
        <div class="cc7-dashboard-scroll">
          <!-- TOP UTILITY BAR -->
          <header class="cc7-topbar">
            <div class="cc7-brand">
              <div class="cc7-logo"><i class="fa fa-tint"></i></div>
              <div><strong>كريستال كلين</strong><span>حلول العناية بالسيارات</span></div>
            </div>
            <div class="cc7-search"><i class="fa fa-search"></i><input type="search" placeholder="ابحث عن سيارة، عميل أو رقم لوحة..." t-on-input="onSearchInput"/></div>
            <div class="cc7-time"><span t-esc="dateLabel"></span><b><i class="fa fa-clock-o"></i> <t t-esc="timeLabel"/></b></div>
            <div class="cc7-top-icons"><button><i class="fa fa-commenting-o"></i></button><button class="cc7-bell"><i class="fa fa-bell"></i><em t-if="state.data.overdue" t-esc="state.data.overdue"></em></button></div>
            <div class="cc7-user"><div><strong>مدير المغسلة</strong><span t-esc="state.data.company_name or 'كريستال كلين'"/></div><span class="cc7-avatar">A</span></div>
          </header>

          <!-- HERO -->
          <section class="cc7-hero">
            <div class="cc7-hero-car"><img src="/car_wash_dashboard/static/src/img/v7/hero_car.png" alt=""/><div class="cc7-hero-tag">سيارتك<br/><strong>تستحق الأفضل</strong></div></div>
            <div class="cc7-hero-title"><h1>لوحة تحكم المغسلة</h1><p>مراقبة سير العمل والعمليات المباشرة لحظة بلحظة</p></div>
            <div class="cc7-hero-message"><span class="cc7-bubble b1"></span><span class="cc7-bubble b2"></span><strong>نظافة أكثر<br/>لحياة أجمل</strong></div>
          </section>

          <!-- KPI ROW -->
          <section class="cc7-kpis">
            <button class="cc7-kpi" t-on-click="() => this.openKpi('active_total')"><div class="cc7-kpi-icon blue"><i class="fa fa-car"></i></div><div><span>السيارات الحالية</span><strong t-esc="state.data.active_total"></strong><small>سيارة في المغسلة</small></div></button>
            <button class="cc7-kpi" t-on-click="() => this.openKpi('in_progress')"><div class="cc7-kpi-icon drop"><i class="fa fa-tint"></i></div><div><span>قيد الغسيل</span><strong t-esc="state.data.in_progress"></strong><small>سيارة</small></div></button>
            <button class="cc7-kpi" t-on-click="() => this.openKpi('ready_delivery')"><div class="cc7-kpi-icon green"><i class="fa fa-check"></i></div><div><span>الجاهزة للتسليم</span><strong t-esc="state.data.ready_delivery"></strong><small>سيارة</small></div></button>
            <button class="cc7-kpi" t-on-click="() => this.openKpi('done_today')"><div class="cc7-kpi-icon violet"><i class="fa fa-bar-chart"></i></div><div><span>إجمالي اليوم</span><strong t-esc="state.data.done_today"></strong><small>سيارة تم خدمتها</small></div></button>
            <button class="cc7-kpi cc7-kpi-progress" t-on-click="() => this.openKpi('done_today')"><div class="cc7-ring" t-att-style="completionRingStyle()"><span><t t-esc="completionRate"/>%</span></div><div><span>نسبة الإنجاز</span><strong><t t-esc="state.data.done_today"/> من <t t-esc="state.data.total_today"/></strong><small>إنجاز اليوم</small></div></button>
          </section>

          <!-- JOURNEY -->
          <section class="cc7-card cc7-journey">
            <div class="cc7-journey-heading"><div><h2>رحلة السيارة في المغسلة</h2><p>من الاستقبال إلى التسليم ... بخدمة احترافية</p></div><div class="cc7-journey-note"><i class="fa fa-tint"></i><strong>رحلة نظافة متكاملة</strong><span>لأن التفاصيل تصنع الفرق</span></div></div>
            <div class="cc7-journey-line"></div>
            <div class="cc7-journey-steps">
              <div t-att-class="'cc7-step ' + journeyStepClass(0)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_reception.png" alt=""/></div><div class="cc7-step-label"><b>1</b><span>الاستقبال</span></div></div>
              <i class="cc7-route-arrow fa fa-angle-left"></i>
              <div t-att-class="'cc7-step ' + journeyStepClass(1)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_wait.png" alt=""/></div><div class="cc7-step-label"><b>2</b><span>الانتظار</span></div></div>
              <i class="cc7-route-arrow fa fa-angle-left"></i>
              <div t-att-class="'cc7-step ' + journeyStepClass(2)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_wash.png" alt=""/></div><div class="cc7-step-label"><b>3</b><span>الغسيل</span></div></div>
              <i class="cc7-route-arrow fa fa-angle-left"></i>
              <div t-att-class="'cc7-step ' + journeyStepClass(3)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_polish.png" alt=""/></div><div class="cc7-step-label"><b>4</b><span>التلميع</span></div></div>
              <i class="cc7-route-arrow fa fa-angle-left"></i>
              <div t-att-class="'cc7-step ' + journeyStepClass(4)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_qc.png" alt=""/></div><div class="cc7-step-label"><b>5</b><span>الفحص النهائي</span></div></div>
              <i class="cc7-route-arrow fa fa-angle-left"></i>
              <div t-att-class="'cc7-step ' + journeyStepClass(5)"><div class="cc7-step-art"><img src="/car_wash_dashboard/static/src/img/v7/journey_ready.png" alt=""/></div><div class="cc7-step-label"><b>6</b><span>جاهزة للتسليم</span></div></div>
            </div>
            <div class="cc7-live-car" t-if="heroCar"><i class="fa fa-car"></i><span><b t-esc="heroCar.public_reference or heroCar.name"></b><small><t t-esc="heroCar.service_name"/> · <t t-esc="heroCar.current_stage"/></small></span><em><t t-esc="heroCar.progress"/>%</em></div>
          </section>

          <!-- MAIN OPERATIONS GRID -->
          <section class="cc7-main-grid">
            <!-- CARS TABLE -->
            <article class="cc7-card cc7-cars-panel">
              <div class="cc7-panel-head"><h3><i class="fa fa-car"></i> السيارات الحالية في المغسلة <span>(<t t-esc="state.data.active_total"/>)</span></h3><button t-on-click="() => this.openKpi('active_total')">عرض الكل</button></div>
              <div class="cc7-table-wrap">
                <table class="cc7-table"><thead><tr><th>#</th><th>رقم اللوحة</th><th>نوع الخدمة</th><th>المرحلة الحالية</th><th>المدة</th><th>الحالة</th></tr></thead><tbody>
                  <t t-foreach="filteredCars" t-as="car" t-key="car.id"><tr t-on-click="() => this.openProduction(car.id)"><td t-esc="car_index + 1"></td><td class="cc7-plate" t-esc="car.public_reference or car.plate"></td><td t-esc="car.service_name"></td><td t-esc="car.current_stage"></td><td t-esc="carDurationLabel(car)"></td><td><span t-att-class="'cc7-status is-' + statusClass(car)" t-esc="statusLabel(car)"></span></td></tr></t>
                  <tr t-if="!filteredCars.length"><td colspan="6" class="cc7-empty">لا توجد سيارات مطابقة للبحث.</td></tr>
                </tbody></table>
              </div>
            </article>

            <!-- STATIONS -->
            <article class="cc7-card cc7-stations-panel">
              <div class="cc7-panel-head"><h3><i class="fa fa-car"></i> المحطات <span>(10)</span></h3><button t-on-click="openShopFloor"><i class="fa fa-cog"></i> إدارة المحطات</button></div>
              <div class="cc7-stations-grid"><t t-foreach="stationSlots" t-as="station" t-key="station.id"><button t-att-class="stationCardClass(station)" t-on-click="() => this.openWorkcenter(station)"><span class="cc7-station-number" t-esc="station.slot"></span><i t-if="stationKind(station) === 'auto'" class="fa fa-car cc7-special-icon"></i><i t-if="stationKind(station) === 'polish'" class="fa fa-diamond cc7-special-icon"></i><strong t-esc="station.name"></strong><small t-att-class="'cc7-station-state is-' + stationStatus(station)" t-esc="stationStatusLabel(station)"></small><em t-if="!station.placeholder"><t t-esc="station.in_progress"/> عمل · <t t-esc="station.queue"/> انتظار</em></button></t></div>
            </article>
          </section>

          <!-- BOTTOM GRID -->
          <section class="cc7-bottom-grid">
            <!-- QUICK ACTIONS -->
            <article class="cc7-card cc7-quick-panel"><div class="cc7-panel-head"><h3><i class="fa fa-bolt"></i> إجراءات سريعة</h3></div><div class="cc7-quick-grid"><button class="green" t-on-click="() => this.quickAction('start')"><i class="fa fa-play"></i> بدء الغسيل</button><button class="blue" t-on-click="() => this.quickAction('finish')"><i class="fa fa-check-circle"></i> إنهاء الخدمة</button><button class="orange" t-on-click="() => this.quickAction('deliver')"><i class="fa fa-key"></i> تسليم السيارة</button><button class="purple" t-on-click="() => this.quickAction('receipt')"><i class="fa fa-print"></i> طباعة الواصل</button></div></article>

            <!-- CUSTOMER LOUNGE -->
            <article class="cc7-card cc7-lounge-panel"><div class="cc7-panel-head"><h3><i class="fa fa-coffee"></i> صالة العملاء / الجاهزة للتسليم <span>(<t t-esc="state.data.ready_delivery"/>)</span></h3><button t-on-click="() => this.openKpi('ready_delivery')">عرض الكل</button></div><div class="cc7-lounge-content"><div class="cc7-ready-list"><t t-foreach="readyCars" t-as="car" t-key="car.id"><button t-on-click="() => this.openProduction(car.id)"><i class="fa fa-car"></i><b t-esc="car.public_reference or car.name"></b><span>جاهزة للتسليم</span><small t-esc="carDurationLabel(car)"></small></button></t><div t-if="!readyCars.length" class="cc7-empty">لا توجد سيارات جاهزة الآن.</div></div><div class="cc7-lounge-photo"><img src="/car_wash_dashboard/static/src/img/v7/lounge.png" alt=""/><strong>راحة عملائنا</strong><span>هي جزء من خدمتنا</span></div></div></article>

            <!-- MATERIALS -->
            <article class="cc7-card cc7-materials-panel"><div class="cc7-panel-head"><h3><i class="fa fa-cube"></i> المواد والمخزون</h3><button t-on-click="openMaterials">عرض الكل</button></div><div class="cc7-material-grid"><t t-foreach="displayMaterials" t-as="item" t-key="item.product_id"><button t-on-click="() => this.openProduct(item.product_id)"><strong t-esc="item.product_name"></strong><span><t t-esc="item.free"/> <t t-esc="item.uom"/></span><div class="cc7-material-bar"><i t-att-class="materialTone(item_index)" t-att-style="materialStyle(item)"></i></div><small><t t-esc="materialPct(item)"/>%</small></button></t><div t-if="!displayMaterials.length" class="cc7-empty">لم يتم ربط مواد تشغيلية بعد.</div></div></article>
          </section>

          <footer class="cc7-footer"><span><strong>كريستال كلين</strong> · لوحة التشغيل المباشرة</span><span>آخر تحديث: <t t-esc="state.lastUpdate or '—'"/></span><span class="cc7-system-ok"><i></i> النظام يعمل بشكل طبيعي · v18.0.7.1</span></footer>
        </div>
      </div>
    </div>
  </t>
</templates>
