<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="car_wash_dashboard.KpiCard">
        <button type="button"
                t-att-class="'cw-kpi-card ' + (props.tone || '') + (props.active ? ' is-active' : '')"
                t-on-click="props.onClick">
            <div t-att-class="'cw-kpi-icon ' + (props.icon || '')"><i/></div>
            <div class="cw-kpi-copy">
                <span class="cw-kpi-label" t-esc="props.label"/>
                <strong class="cw-kpi-value" t-esc="props.value"/>
                <small t-if="props.note" t-esc="props.note"/>
            </div>
            <span class="cw-kpi-affordance"><i class="fa fa-angle-right"/></span>
        </button>
    </t>

    <t t-name="car_wash_dashboard.QueuePanel">
        <section class="cw-panel cw-queue-panel">
            <header class="cw-queue-heading">
                <div class="cw-queue-title-row">
                    <div class="cw-section-title">
                        <span class="cw-section-icon"><i class="fa fa-users"/></span>
                        <h2>Waiting Queue</h2>
                    </div>
                    <button type="button" class="cw-icon-link" t-on-click="props.onOpenQueue" title="View full queue">
                        <i class="fa fa-angle-right"/>
                    </button>
                </div>
                <div class="cw-queue-count-line">
                    <strong t-esc="props.total"/>
                    <span>cars waiting for next available station</span>
                </div>
            </header>

            <div class="cw-queue-list">
                <t t-foreach="props.queue.slice(0, 4)" t-as="item" t-key="item.id">
                    <button type="button" class="cw-queue-row" t-on-click="() => props.onOpenCar(item.id)">
                        <span class="cw-queue-car"><img t-att-src="vehicleImage(item)" alt=""/></span>
                        <span class="cw-queue-main">
                            <strong t-esc="item.plate"/>
                            <small t-esc="item.vehicle_model || 'Current vehicle'"/>
                            <em t-esc="item.service_name"/>
                            <span class="cw-queue-time"><i class="fa fa-clock-o"/> <t t-esc="formatMinutes(item.waiting_minutes)"/></span>
                        </span>
                        <span class="cw-size-chip" t-esc="sizeLabel(item.vehicle_size)"/>
                    </button>
                </t>
                <div t-if="!props.queue.length" class="cw-empty-state compact">
                    <span class="cw-empty-check"><i class="fa fa-check"/></span>
                    <p>No cars are waiting.</p>
                </div>
            </div>

            <button type="button" class="cw-secondary-wide" t-on-click="props.onOpenQueue">
                View Full Queue <i class="fa fa-long-arrow-right"/>
            </button>
        </section>
    </t>

    <t t-name="car_wash_dashboard.StationCard">
        <button type="button"
                t-att-title="props.station.name"
                t-att-class="'cw-station-card status-' + (props.station.visual_status || props.station.status) + (props.selected ? ' is-selected' : '')"
                t-att-disabled="props.station.is_placeholder"
                t-on-click="select">
            <div class="cw-station-topline">
                <strong>Station <t t-esc="props.station.slot_number"/></strong>
                <span t-att-class="'cw-type-badge type-' + props.station.station_type" t-esc="typeLabel(props.station.station_type)"/>
            </div>

            <t t-if="props.station.current_car">
                <div class="cw-station-vehicle">
                    <img t-att-src="vehicleImage()" alt=""/>
                </div>
                <div class="cw-station-car-copy">
                    <strong t-esc="props.station.current_car.plate"/>
                    <small t-esc="props.station.current_car.vehicle_model || 'Current vehicle'"/>
                </div>
                <p class="cw-service-name" t-esc="props.station.current_car.service_name"/>
                <div class="cw-station-meta-row">
                    <span class="cw-size-chip" t-esc="sizeLabel(props.station.current_car.vehicle_size)"/>
                    <span class="cw-time-chip"><i class="fa fa-clock-o"/> <t t-esc="formatMinutes(props.station.elapsed_minutes)"/></span>
                </div>
                <div t-if="props.station.expected_minutes" class="cw-progress-row" title="Elapsed time compared with Odoo expected duration">
                    <span class="cw-progress-track"><span t-att-class="'cw-progress-fill status-' + (props.station.visual_status || props.station.status)" t-att-style="progressStyle()"/></span>
                    <small><t t-esc="props.station.progress_percent"/>%</small>
                </div>
                <span t-att-class="'cw-status-bar status-' + (props.station.visual_status || props.station.status)" t-esc="statusLabel(props.station.visual_status || props.station.status)"/>
            </t>

            <t t-elif="props.station.is_placeholder">
                <div class="cw-station-empty not-configured">
                    <span class="cw-empty-car"><i class="fa fa-car"/></span>
                    <strong>Not Configured</strong>
                    <small>Configure a real Odoo work center.</small>
                </div>
            </t>

            <t t-else="">
                <div class="cw-station-empty">
                    <span class="cw-empty-car"><i class="fa fa-car"/></span>
                    <strong>Available</strong>
                    <small>Ready for next car</small>
                    <span class="cw-status-bar status-available">Available</span>
                </div>
            </t>

            <div t-if="props.station.status === 'conflict'" class="cw-conflict-note">
                <strong t-esc="props.station.conflict_count"/> active cars detected — check Shop Floor.
            </div>
        </button>
    </t>

    <t t-name="car_wash_dashboard.StationDetail">
        <aside class="cw-detail-drawer">
            <header class="cw-drawer-head">
                <div>
                    <h2>Station <t t-esc="props.station.slot_number"/> Details</h2>
                    <small t-esc="props.station.name"/>
                </div>
                <button type="button" class="cw-close" t-on-click="props.onClose" title="Close"><i class="fa fa-times"/></button>
            </header>

            <div class="cw-drawer-status-row">
                <span t-att-class="'cw-type-badge type-' + props.station.station_type" t-esc="typeLabel(props.station.station_type)"/>
                <span t-att-class="'cw-status-chip status-' + (props.station.visual_status || props.station.status)"><i class="cw-status-dot"/> <t t-esc="statusLabel(props.station.visual_status || props.station.status)"/></span>
            </div>

            <t t-if="props.station.current_car">
                <div class="cw-detail-car">
                    <img t-att-src="vehicleImage()" alt=""/>
                </div>
                <div class="cw-detail-plate-row">
                    <div>
                        <strong t-esc="props.station.current_car.plate"/>
                        <small t-esc="props.station.current_car.vehicle_model || 'Current vehicle'"/>
                    </div>
                    <div class="cw-detail-time">
                        <strong><i class="fa fa-clock-o"/> <t t-esc="formatMinutes(props.station.elapsed_minutes)"/></strong>
                        <small>Time in station</small>
                    </div>
                </div>

                <dl class="cw-detail-list">
                    <div>
                        <dt><i class="fa fa-clone"/> Service</dt>
                        <dd t-esc="props.station.current_car.service_name"/>
                    </div>
                    <div>
                        <dt><i class="fa fa-car"/> Vehicle Size</dt>
                        <dd t-esc="sizeLabel(props.station.current_car.vehicle_size)"/>
                    </div>
                    <div>
                        <dt><i class="fa fa-user-o"/> Customer</dt>
                        <dd><span t-esc="props.station.current_car.customer_name || '—'"/><small t-if="props.station.current_car.customer_phone" t-esc="props.station.current_car.customer_phone"/></dd>
                    </div>
                    <div>
                        <dt><i class="fa fa-tasks"/> Current Operation</dt>
                        <dd t-esc="props.station.current_car.stage_name || '—'"/>
                    </div>
                    <div>
                        <dt><i class="fa fa-file-text-o"/> Service Notes</dt>
                        <dd t-esc="props.station.current_car.vehicle_notes || 'No notes'"/>
                    </div>
                </dl>

                <div class="cw-drawer-actions">
                    <button type="button" class="cw-primary-action" t-on-click="props.onOpenShopFloor">
                        <i class="fa fa-check"/> Open Wash Screen
                    </button>
                    <button type="button" class="cw-secondary-action" t-on-click="() => props.onOpenProduction(props.station.current_car.production_id)">
                        <i class="fa fa-car"/> Open Car Wash Order
                    </button>
                    <button t-if="props.station.current_car.workorder_id" type="button" class="cw-secondary-action" t-on-click="() => props.onOpenWorkorder(props.station.current_car.workorder_id)">
                        <i class="fa fa-list"/> Open Current Operation
                    </button>
                </div>
            </t>

            <t t-else="">
                <div class="cw-empty-state drawer">
                    <span class="cw-empty-large-car"><i class="fa fa-car"/></span>
                    <h3>Station Available</h3>
                    <p>No car is currently running in this work center.</p>
                    <button type="button" class="cw-primary-action" t-on-click="props.onOpenShopFloor">Open Wash Screen</button>
                </div>
            </t>
        </aside>
    </t>

    <t t-name="car_wash_dashboard.CarWashDashboard">
        <div t-att-class="'cw-dashboard-app' + (selectedStation ? ' has-detail' : '') + ' focus-' + state.focusMode">
            <div t-if="state.loading" class="cw-loading-screen">
                <span class="cw-loader"/>
                <strong>Loading car wash dashboard…</strong>
            </div>

            <t t-else="">
                <aside class="cw-sidebar">
                    <div class="cw-brand">
                        <span class="cw-brand-mark"><i class="fa fa-tint"/></span>
                        <div><strong>CleanDrive</strong><small>CAR WASH</small></div>
                    </div>

                    <nav class="cw-nav">
                        <button t-att-class="state.page === 'operations' &amp;&amp; state.focusMode === 'overview' ? 'is-active' : ''" t-on-click="showOperations"><i class="fa fa-tachometer"/>Dashboard</button>
                        <button t-on-click="openCars"><i class="fa fa-car"/>Cars</button>
                        <button t-att-class="state.page === 'operations' &amp;&amp; state.focusMode === 'stations' ? 'is-active' : ''" t-on-click="showStationDirectory"><i class="fa fa-th-large"/>Work Centers</button>
                        <button t-on-click="openServices"><i class="fa fa-tint"/>Services</button>
                        <button t-on-click="openCustomers"><i class="fa fa-users"/>Customers</button>
                        <button t-att-class="state.page === 'analytics' ? 'is-active' : ''" t-on-click="showAnalytics"><i class="fa fa-bar-chart"/>Analytics</button>
                        <button t-on-click="openReports"><i class="fa fa-line-chart"/>Reports</button>
                        <button t-on-click="openStationSettings"><i class="fa fa-cog"/>Settings</button>
                    </nav>

                    <div class="cw-sidebar-art">
                        <img src="/car_wash_dashboard/static/src/img/sidebar_wash_reference.webp" alt=""/>
                        <div><strong>Cleaner Cars</strong><span>Brighter Days</span></div>
                    </div>
                </aside>

                <main class="cw-main">
                    <header class="cw-topbar">
                        <div class="cw-title-block">
                            <h1 t-esc="state.page === 'analytics' ? 'Business Analytics' : 'Car Wash Dashboard'"/>
                            <p t-esc="state.page === 'analytics' ? 'Insights for a cleaner, more profitable tomorrow.' : 'Live overview of stations, queue and today’s activity.'"/>
                        </div>

                        <div class="cw-header-tools">
                            <label class="cw-search">
                                <i class="fa fa-search"/>
                                <input type="search" placeholder="Search cars, customers, or plates..." t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
                            </label>
                            <button type="button" class="cw-round-tool" t-on-click="manualRefresh" title="Refresh"><i class="fa fa-refresh"/></button>
                            <button type="button" t-att-class="'cw-round-tool cw-audio-toggle' + (state.audioEnabled ? ' is-on' : '')" t-on-click="toggleAudio" t-att-title="state.audioEnabled ? 'Mute sound feedback' : 'Enable sound feedback'">
                                <i t-att-class="state.audioEnabled ? 'fa fa-volume-up' : 'fa fa-volume-off'"/>
                            </button>
                            <button type="button" class="cw-round-tool cw-bell" t-on-click="showLiveStatus" title="Live notifications"><i class="fa fa-bell-o"/><span/></button>
                            <div class="cw-user-summary">
                                <span class="cw-avatar" t-esc="state.data.user_initials || 'OD'"/>
                                <div><strong t-esc="state.data.user_name || 'Odoo User'"/><small t-esc="state.data.user_role || 'Operator'"/></div>
                                <i class="fa fa-angle-down"/>
                            </div>
                            <div class="cw-date-box"><small t-esc="state.dateLabel"/><strong t-esc="state.nowLabel"/></div>
                        </div>
                    </header>

                    <t t-if="state.page === 'analytics'">
                        <section class="cw-analytics-page">
                            <div class="cw-analytics-toolbar">
                                <div class="cw-analytics-period-label">
                                    <i class="fa fa-calendar-o"/>
                                    <span t-esc="state.analytics.period_label || state.dateLabel"/>
                                </div>
                                <label class="cw-analytics-period-select">
                                    <select t-att-value="state.analyticsPeriod" t-on-change="onAnalyticsPeriodChange">
                                        <option value="today">Today</option>
                                        <option value="month">This Month</option>
                                    </select>
                                    <i class="fa fa-angle-down"/>
                                </label>
                            </div>

                            <div t-if="state.analyticsLoading &amp;&amp; !state.analyticsLoaded" class="cw-analytics-loading">
                                <span class="cw-loader"/><strong>Loading business analytics…</strong>
                            </div>

                            <t t-else="">
                                <section class="cw-analytics-kpis">
                                    <article class="cw-analytics-kpi">
                                        <span class="cw-analytics-kpi-icon money"><i class="fa fa-dollar"/></span>
                                        <div><small>Today's Revenue</small><strong t-esc="formatMoney(state.analytics.kpis.today_revenue)"/><span t-att-class="'cw-analytics-growth ' + growthClass(state.analytics.kpis.today_revenue_growth)"><i t-att-class="growthClass(state.analytics.kpis.today_revenue_growth) === 'down' ? 'fa fa-arrow-down' : 'fa fa-arrow-up'"/> <t t-esc="growthText(state.analytics.kpis.today_revenue_growth)"/></span><em>vs. yesterday</em></div>
                                    </article>
                                    <article class="cw-analytics-kpi">
                                        <span class="cw-analytics-kpi-icon calendar"><i class="fa fa-calendar"/></span>
                                        <div><small>Monthly Revenue</small><strong t-esc="formatMoney(state.analytics.kpis.monthly_revenue)"/><span t-att-class="'cw-analytics-growth ' + growthClass(state.analytics.kpis.monthly_revenue_growth)"><i t-att-class="growthClass(state.analytics.kpis.monthly_revenue_growth) === 'down' ? 'fa fa-arrow-down' : 'fa fa-arrow-up'"/> <t t-esc="growthText(state.analytics.kpis.monthly_revenue_growth)"/></span><em>vs. last month</em></div>
                                    </article>
                                    <article class="cw-analytics-kpi">
                                        <span class="cw-analytics-kpi-icon washes"><i class="fa fa-car"/></span>
                                        <div><small>Total Washes Today</small><strong t-esc="state.analytics.kpis.total_washes_today || 0"/><em>paid POS visits</em></div>
                                    </article>
                                    <article class="cw-analytics-kpi">
                                        <span class="cw-analytics-kpi-icon customers"><i class="fa fa-users"/></span>
                                        <div><small>Active Customers</small><strong t-esc="state.analytics.kpis.active_customers || 0"/><em>today</em></div>
                                    </article>
                                    <article class="cw-analytics-kpi">
                                        <span class="cw-analytics-kpi-icon ticket"><i class="fa fa-ticket"/></span>
                                        <div><small>Average Ticket</small><strong t-esc="formatMoney(state.analytics.kpis.average_ticket)"/><em>today</em></div>
                                    </article>
                                </section>

                                <section class="cw-analytics-grid cw-analytics-grid-top">
                                    <article class="cw-analytics-card cw-chart-card">
                                        <header><div><i class="fa fa-car"/><h2>Daily Washes</h2></div><span class="cw-chart-filter">Cars Washed <i class="fa fa-angle-down"/></span></header>
                                        <div class="cw-line-chart">
                                            <svg viewBox="0 0 560 165" preserveAspectRatio="none" aria-label="Daily washes chart">
                                                <defs><linearGradient id="cwAnalyticsArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#168cf2" stop-opacity="0.20"/><stop offset="100%" stop-color="#168cf2" stop-opacity="0.02"/></linearGradient></defs>
                                                <line x1="0" y1="25" x2="560" y2="25" class="cw-grid-line"/><line x1="0" y1="65" x2="560" y2="65" class="cw-grid-line"/><line x1="0" y1="105" x2="560" y2="105" class="cw-grid-line"/><line x1="0" y1="150" x2="560" y2="150" class="cw-grid-line"/>
                                                <polygon t-att-points="analyticsLineAreaPoints" fill="url(#cwAnalyticsArea)"/>
                                                <polyline t-att-points="analyticsLinePoints" class="cw-line-series"/>
                                                <t t-foreach="analyticsLineDots" t-as="point" t-key="point.label"><circle t-att-cx="point.x" t-att-cy="point.y" r="4" class="cw-line-dot"><title><t t-esc="point.label"/>: <t t-esc="point.value"/></title></circle></t>
                                            </svg>
                                            <div class="cw-line-labels"><t t-foreach="state.analytics.daily_washes" t-as="row" t-key="row.label"><span t-esc="row.label"/></t></div>
                                            <div t-if="!state.analytics.daily_washes.length" class="cw-chart-empty">No wash activity today.</div>
                                        </div>
                                    </article>

                                    <article class="cw-analytics-card cw-chart-card">
                                        <header><div><i class="fa fa-bar-chart"/><h2>Popular Services</h2></div><span class="cw-chart-filter">By Volume <i class="fa fa-angle-down"/></span></header>
                                        <div class="cw-bars-chart">
                                            <t t-foreach="state.analytics.popular_services" t-as="service" t-key="service.name">
                                                <div class="cw-bar-column"><strong t-esc="service.value"/><span class="cw-bar-track"><i t-att-style="analyticsBarStyle(service.value, state.analytics.popular_services)"/></span><small t-esc="service.name"/></div>
                                            </t>
                                            <div t-if="!state.analytics.popular_services.length" class="cw-chart-empty">No service sales in this period.</div>
                                        </div>
                                    </article>

                                    <article class="cw-analytics-card cw-utilization-card">
                                        <header><div><i class="fa fa-pie-chart"/><h2>Station Utilization</h2></div><span class="cw-chart-filter" t-esc="state.analyticsPeriod === 'month' ? 'This Month' : 'Today'"/></header>
                                        <div class="cw-utilization-body">
                                            <div class="cw-donut cw-station-donut" t-att-style="stationDonutStyle()"><div><strong><t t-esc="roundNumber(state.analytics.station_utilization.overall)"/>%</strong><span>Overall<br/>Utilization</span></div></div>
                                            <div class="cw-station-legend"><t t-foreach="state.analytics.station_utilization.stations" t-as="station" t-key="station.id"><div><i/><span t-esc="station.name"/><strong><t t-esc="roundNumber(station.utilization)"/>%</strong></div></t></div>
                                        </div>
                                    </article>
                                </section>

                                <section class="cw-analytics-grid cw-analytics-grid-middle">
                                    <article class="cw-analytics-card">
                                        <header><div><i class="fa fa-users"/><h2>Top Customers</h2></div><span class="cw-chart-filter">By Washes <i class="fa fa-angle-down"/></span></header>
                                        <div class="cw-ranked-list"><t t-foreach="state.analytics.top_customers" t-as="customer" t-key="customer.partner_id"><div class="cw-ranked-row"><span class="cw-rank" t-esc="customer_index + 1"/><span class="cw-customer-avatar" t-esc="customer.initial"/><strong t-esc="customer.name"/><em><t t-esc="customer.washes"/> washes</em></div></t><div t-if="!state.analytics.top_customers.length" class="cw-list-empty">No customer history in this period.</div></div>
                                    </article>

                                    <article class="cw-analytics-card">
                                        <header><div><i class="fa fa-cube"/><h2>Supplies Near Depletion</h2></div><span class="cw-chart-filter">Low Stock <i class="fa fa-angle-down"/></span></header>
                                        <div class="cw-ranked-list cw-supply-list"><t t-foreach="state.analytics.low_supplies" t-as="supply" t-key="supply.product_id"><div class="cw-supply-row"><span class="cw-rank" t-esc="supply_index + 1"/><span class="cw-supply-icon"><i class="fa fa-flask"/></span><div><strong t-esc="supply.name"/><small><t t-esc="supply.available_qty"/> <t t-esc="supply.uom"/> left · min <t t-esc="supply.minimum_qty"/></small></div><span class="cw-supply-progress"><i t-att-style="supplyBarStyle(supply.remaining_percent)"/></span><em><t t-esc="roundNumber(supply.remaining_percent)"/>%</em></div></t><div t-if="!state.analytics.low_supplies.length" class="cw-list-empty">No car-wash supply is below a configured reorder minimum.</div></div>
                                    </article>

                                    <article class="cw-analytics-card cw-chart-card">
                                        <header><div><i class="fa fa-bar-chart"/><h2>Revenue Trend</h2></div><span class="cw-chart-filter">This Month <i class="fa fa-angle-down"/></span></header>
                                        <div class="cw-bars-chart revenue"><t t-foreach="state.analytics.revenue_trend" t-as="week" t-key="week.label"><div class="cw-bar-column"><strong t-esc="formatMoney(week.value)"/><span class="cw-bar-track"><i t-att-style="analyticsBarStyle(week.value, state.analytics.revenue_trend)"/></span><small t-esc="week.label"/></div></t></div>
                                    </article>
                                </section>

                                <section class="cw-analytics-grid cw-analytics-grid-bottom">
                                    <article class="cw-analytics-card">
                                        <header><div><i class="fa fa-users"/><h2>New vs Returning Customers</h2></div></header>
                                        <div class="cw-customer-mix"><div class="cw-donut" t-att-style="customerDonutStyle()"><div><strong><t t-esc="roundNumber(state.analytics.customer_mix.returning_percent)"/>%</strong><span>Returning<br/>Customers</span></div></div><div class="cw-simple-legend"><div><i class="returning"/><span>Returning</span><strong><t t-esc="state.analytics.customer_mix.returning_percent || 0"/>%</strong></div><div><i class="new"/><span>New</span><strong><t t-esc="state.analytics.customer_mix.new_percent || 0"/>%</strong></div></div></div>
                                    </article>

                                    <article class="cw-analytics-card">
                                        <header><div><i class="fa fa-pie-chart"/><h2>Revenue by Service Category</h2></div></header>
                                        <div class="cw-category-body"><div class="cw-donut" t-att-style="categoryDonutStyle()"><div><strong t-esc="formatMoney(state.analytics.kpis.monthly_revenue)"/><span>This Month</span></div></div><div class="cw-category-legend"><t t-foreach="state.analytics.revenue_by_category" t-as="category" t-key="category.name"><div><i t-att-style="'background:' + categoryColor(category_index)"/><span t-esc="category.name"/><strong><t t-esc="category.percent"/>%</strong></div></t></div></div>
                                    </article>

                                    <article class="cw-analytics-card">
                                        <header><div><i class="fa fa-clock-o"/><h2>Recent Activity</h2></div><span class="cw-chart-filter">Live</span></header>
                                        <div class="cw-activity-list"><t t-foreach="state.analytics.recent_activity" t-as="activity" t-key="activity.timestamp + activity.reference + activity.type"><div class="cw-activity-row"><time t-esc="activityTime(activity.timestamp)"/><span t-att-class="'cw-activity-icon type-' + activity.type"><i t-att-class="activity.type === 'payment' ? 'fa fa-credit-card' : activity.type === 'done' ? 'fa fa-check' : activity.type === 'active' ? 'fa fa-play' : 'fa fa-info'"/></span><strong t-esc="activity.title"/><span t-esc="activity.reference"/><small t-esc="activity.detail"/><em t-if="activity.amount !== false" t-esc="formatMoney(activity.amount)"/></div></t><div t-if="!state.analytics.recent_activity.length" class="cw-list-empty">No recent activity.</div></div>
                                    </article>
                                </section>
                            </t>
                        </section>
                    </t>

                    <t t-else="">
                    <div t-if="state.data.station_configuration.warnings &amp;&amp; state.data.station_configuration.warnings.length" class="cw-config-banner">
                        <i class="fa fa-exclamation-triangle"/>
                        <div>
                            <strong>Station configuration needs attention</strong>
                            <p t-esc="state.data.station_configuration.warnings.join(' ')"/>
                        </div>
                        <button type="button" t-on-click="openStationSettings">Configure</button>
                    </div>

                    <section class="cw-kpi-grid">
                        <KpiCard label="'Total Active Cars'" value="state.data.kpis.active_cars || 0" note="'in stations now'" icon="'car'" tone="'blue'" active="state.focusMode === 'active'" onClick="() => activateFocus('active')"/>
                        <KpiCard label="'General Waiting Queue'" value="state.data.kpis.waiting_queue || 0" note="'cars waiting'" icon="'queue'" tone="'cyan'" active="state.focusMode === 'waiting'" onClick="() => activateFocus('waiting')"/>
                        <KpiCard label="'Available Stations'" value="state.data.kpis.available_stations || 0" note="'of 10 stations'" icon="'station'" tone="'blue'" active="state.focusMode === 'available'" onClick="() => activateFocus('available')"/>
                        <KpiCard label="'Finished Today'" value="state.data.kpis.finished_today || 0" note="'completed wash orders'" icon="'done'" tone="'green'" active="state.focusMode === 'finished'" onClick="() => activateFocus('finished')"/>
                    </section>

                    <section t-if="state.focusMode !== 'overview'" class="cw-focus-panel">
                        <header class="cw-focus-header">
                            <div class="cw-focus-heading">
                                <button type="button" class="cw-focus-back" t-on-click="clearFocus" title="Back to dashboard"><i class="fa fa-arrow-left"/></button>
                                <div>
                                    <div class="cw-focus-title-line"><h2 t-esc="focusTitle"/><span class="cw-focus-count" t-esc="focusCount"/></div>
                                    <p t-esc="focusSubtitle"/>
                                </div>
                            </div>
                            <button t-if="state.focusMode === 'active' || state.focusMode === 'available' || state.focusMode === 'stations'"
                                    type="button"
                                    class="cw-grid-view"
                                    t-on-click="toggleViewMode">
                                <i t-att-class="state.viewMode === 'grid' ? 'fa fa-th' : 'fa fa-list'"/>
                                <t t-esc="state.viewMode === 'grid' ? 'Grid View' : 'List View'"/>
                            </button>
                        </header>

                        <t t-if="state.focusMode === 'active'">
                            <div t-att-class="'cw-station-grid cw-focus-station-grid' + (state.viewMode === 'list' ? ' is-list' : '')">
                                <t t-foreach="activeStations" t-as="station" t-key="station.slot_number">
                                    <StationCard station="station" selected="station.id === state.selectedStationId" onSelect.bind="selectStation"/>
                                </t>
                            </div>
                            <div t-if="!activeStations.length" class="cw-empty-state focus"><span class="cw-empty-check"><i class="fa fa-check"/></span><h3>No active cars</h3><p>No car is currently inside a station.</p></div>
                        </t>

                        <t t-elif="state.focusMode === 'waiting'">
                            <div class="cw-focus-vehicle-list">
                                <t t-foreach="filteredQueue" t-as="item" t-key="item.id">
                                    <button type="button" class="cw-focus-vehicle-row" t-on-click="() => openProduction(item.production_id)">
                                        <span class="cw-focus-vehicle-photo"><img t-att-src="vehicleImage(item)" alt=""/></span>
                                        <span class="cw-focus-vehicle-copy">
                                            <strong t-esc="item.plate"/>
                                            <small t-esc="item.vehicle_model || 'Current vehicle'"/>
                                            <em t-esc="item.service_name"/>
                                        </span>
                                        <span class="cw-size-chip" t-esc="sizeLabel(item.vehicle_size)"/>
                                        <span class="cw-focus-meta"><i class="fa fa-clock-o"/> <t t-esc="formatMinutes(item.waiting_minutes)"/> waiting</span>
                                        <i class="fa fa-angle-right cw-row-arrow"/>
                                    </button>
                                </t>
                            </div>
                            <div t-if="!filteredQueue.length" class="cw-empty-state focus"><span class="cw-empty-check"><i class="fa fa-check"/></span><h3>Queue is clear</h3><p>No cars are waiting for a station.</p></div>
                        </t>

                        <t t-elif="state.focusMode === 'available'">
                            <div t-att-class="'cw-station-grid cw-focus-station-grid' + (state.viewMode === 'list' ? ' is-list' : '')">
                                <t t-foreach="availableStations" t-as="station" t-key="station.slot_number">
                                    <StationCard station="station" selected="station.id === state.selectedStationId" onSelect.bind="selectStation"/>
                                </t>
                            </div>
                            <div t-if="!availableStations.length" class="cw-empty-state focus"><h3>No available stations</h3><p>All configured stations are currently occupied.</p></div>
                        </t>

                        <t t-elif="state.focusMode === 'finished'">
                            <div class="cw-focus-vehicle-list finished">
                                <t t-foreach="finishedTodayItems" t-as="item" t-key="item.id">
                                    <button type="button" class="cw-focus-vehicle-row" t-on-click="() => openProduction(item.production_id)">
                                        <span class="cw-focus-vehicle-photo"><img t-att-src="vehicleImage(item)" alt=""/></span>
                                        <span class="cw-focus-vehicle-copy">
                                            <strong t-esc="item.plate"/>
                                            <small t-esc="item.vehicle_model || 'Current vehicle'"/>
                                            <em t-esc="item.service_name"/>
                                        </span>
                                        <span class="cw-size-chip" t-esc="sizeLabel(item.vehicle_size)"/>
                                        <span class="cw-focus-meta finished"><i class="fa fa-check-circle"/> Finished <t t-esc="formatFinishedAt(item.finished_at)"/></span>
                                        <i class="fa fa-angle-right cw-row-arrow"/>
                                    </button>
                                </t>
                            </div>
                            <div t-if="!finishedTodayItems.length" class="cw-empty-state focus"><h3>No completed washes today</h3><p>Completed wash orders will appear here.</p></div>
                        </t>

                        <t t-elif="state.focusMode === 'stations'">
                            <div t-att-class="'cw-station-directory' + (state.viewMode === 'grid' ? ' is-grid' : ' is-list')">
                                <t t-foreach="filteredStations" t-as="station" t-key="station.slot_number">
                                    <button type="button" class="cw-directory-row" t-on-click="() => selectStation(station.id)" t-att-disabled="station.is_placeholder">
                                        <span class="cw-directory-number" t-esc="station.slot_number"/>
                                        <span class="cw-directory-name"><strong t-esc="station.name"/><small t-esc="stationTypeLabel(station.station_type)"/></span>
                                        <span t-att-class="'cw-type-badge type-' + station.station_type" t-esc="stationTypeLabel(station.station_type)"/>
                                        <span t-att-class="'cw-directory-status status-' + (station.visual_status || station.status)" t-esc="stationStatusLabel(station.visual_status || station.status)"/>
                                        <span class="cw-directory-car">
                                            <t t-if="station.current_car">
                                                <strong t-esc="station.current_car.plate"/><small t-esc="station.current_car.service_name"/>
                                            </t>
                                            <t t-else=""><strong>Available</strong><small>Ready for next car</small></t>
                                        </span>
                                        <i class="fa fa-angle-right cw-row-arrow"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                    </section>

                    <section t-else="" class="cw-operations-layout">
                        <QueuePanel queue="filteredQueue" total="state.data.kpis.waiting_queue || 0" onOpenQueue.bind="openQueue" onOpenCar.bind="openProduction"/>

                        <section class="cw-stations-panel">
                            <header class="cw-stations-heading">
                                <div class="cw-stations-title">
                                    <span class="cw-section-icon"><i class="fa fa-building-o"/></span>
                                    <div><h2>Work Centers (10)</h2><p>Each station handles one car at a time.</p></div>
                                </div>
                                <button type="button" class="cw-grid-view" t-on-click="toggleViewMode">
                                    <i t-att-class="state.viewMode === 'grid' ? 'fa fa-th' : 'fa fa-list'"/>
                                    <t t-esc="state.viewMode === 'grid' ? 'Grid View' : 'List View'"/>
                                    <i class="fa fa-angle-down"/>
                                </button>
                            </header>

                            <div t-att-class="'cw-station-grid' + (state.viewMode === 'list' ? ' is-list' : '')">
                                <t t-foreach="filteredStations" t-as="station" t-key="station.slot_number">
                                    <StationCard station="station" selected="station.id === state.selectedStationId" onSelect.bind="selectStation"/>
                                </t>
                            </div>

                            <div t-if="state.searchQuery &amp;&amp; !filteredStations.length" class="cw-empty-state search"><h3>No stations match your search.</h3></div>
                        </section>
                    </section>
                    </t>
                </main>

                <StationDetail t-if="state.page === 'operations' &amp;&amp; selectedStation"
                               station="selectedStation"
                               onClose.bind="closeStation"
                               onOpenShopFloor.bind="openShopFloor"
                               onOpenProduction.bind="openProduction"
                               onOpenWorkorder.bind="openWorkorder"/>

                <div t-if="state.feedbackText" t-att-class="'cw-feedback-toast tone-' + state.feedbackTone">
                    <i class="fa fa-check-circle"/>
                    <span t-esc="state.feedbackText"/>
                </div>
            </t>
        </div>
    </t>
</templates>
