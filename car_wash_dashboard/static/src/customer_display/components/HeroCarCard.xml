<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="car_wash_dashboard.HeroCarCard">
<article class="cc_hero_car">
    <div class="cc_hero_car__visual"><WashTunnel progress="progress" car="props.car" state="props.car.display_state"/></div>
    <div class="cc_hero_car__info">
        <div class="cc_hero_car__identity"><Plate value="props.car.public_reference" variant="props.car.display_state === 'ready_for_pickup' ? 'ready' : 'normal'" tv="true"/><div t-if="props.policy.show_vehicle_model"><strong t-esc="props.car.vehicle_model || ''"/><span t-esc="props.car.vehicle_color || ''"/></div></div>
        <div class="cc_hero_meta"><span t-esc="props.car.service_name || ''"/><b t-esc="stationText"/></div>
        <div t-if="props.policy.show_current_stage" class="cc_current_stage"><small t-esc="currentStageLabel"/><strong t-esc="props.car.current_stage || props.car.display_label"/></div>
        <StepTracker currentStage="props.car.current_stage" state="props.car.display_state"/>
        <div class="cc_hero_progress"><div class="cc_hero_progress__head"><span t-esc="props.car.display_label"/><strong t-esc="progressText"/></div><div class="cc_hero_progress__bar"><span t-att-style="'width:' + progress + '%'"/></div></div>
        <div t-if="props.policy.show_eta" class="cc_eta"><small t-esc="etaTitle"/><strong t-esc="etaLabel"/></div>
    </div>
</article>
</t></templates>
