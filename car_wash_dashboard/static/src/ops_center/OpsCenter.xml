<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="car_wash_dashboard.OpsCenter">
    <main t-att-class="rootClass" t-att-data-theme="state.theme" dir="rtl">
        <ConnectionBanner online="state.online" lastUpdated="state.lastUpdated"/>
        <header class="cc_ops_header">
            <div class="cc_brand">
                <div class="cc_brand_mark">CC</div>
                <div><h1 t-esc="t.title"/><p t-esc="t.subtitle"/></div>
            </div>
            <div class="cc_header_tunnel"><WashTunnel progress="55" car="headerCar" mini="true" state="'in_service'"/></div>
            <div class="cc_header_tools">
                <span t-if="state.demo" class="cc_demo_badge" t-esc="t.demo"/>
                <LiveBadge online="state.online" loading="state.refreshing"/>
                <time class="cc_clock" t-esc="clockText"/>
                <button type="button" class="cc_icon_btn" t-on-click="toggleTheme" t-att-aria-label="t.theme" t-att-title="t.theme"><span t-esc="state.theme === 'dark' ? '☀' : '☾'"/></button>
            </div>
        </header>

        <section t-if="state.loading" class="cc_kpi_strip"><article t-foreach="[1,2,3,4,5,6]" t-as="n" t-key="n" class="cc_kpi cc_skeleton"/></section>
        <section t-else="" class="cc_kpi_strip"><KpiCard t-foreach="kpis" t-as="kpi" t-key="kpi.key" label="kpi.label" value="kpi.value" caption="kpi.caption" tone="kpi.tone" icon="kpi.icon" suffix="kpi.suffix || ''" decimals="kpi.decimals || 0"/></section>

        <div t-if="state.error" class="cc_inline_error"><span t-esc="state.error"/><button type="button" t-on-click="retry" t-esc="t.retry"/></div>

        <div class="cc_ops_main" t-if="state.bundle">
            <StationGrid stations="stations" projectedClear="projectedClear" onSelect.bind="selectStation"/>
            <QueuePanel rows="queueRows"/>
        </div>
        <div t-elif="!state.loading" class="cc_empty cc_empty--hero"><div class="cc_empty__icon">◇</div><strong t-esc="t.noData"/></div>

        <ManagementStrip t-if="state.isManager &amp;&amp; management" management="management" team="team"/>
        <StationDrawer stationId="state.selectedStationId" open="state.drawerOpen" onClose.bind="closeDrawer"/>
    </main>
</t>
</templates>
