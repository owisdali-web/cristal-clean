<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="car_wash_dashboard.KpiCard">
    <article t-att-class="'cc_kpi cc_kpi--' + props.tone">
        <div class="cc_kpi__icon" aria-hidden="true" t-esc="props.icon"/>
        <div class="cc_kpi__body">
            <span class="cc_kpi__label" t-esc="props.label"/>
            <strong class="cc_kpi__value" t-esc="displayValue"/>
            <small t-if="props.caption" class="cc_kpi__caption" t-esc="props.caption"/>
        </div>
    </article>
</t>
</templates>
