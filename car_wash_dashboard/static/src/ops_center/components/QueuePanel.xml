<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="car_wash_dashboard.QueuePanel">
<section class="cc_panel cc_queue_panel" t-ref="root">
    <header class="cc_panel__head"><div><span class="cc_eyebrow" t-esc="eyebrow"/><h2 t-esc="title"/></div><span class="cc_queue_count" t-esc="props.rows.length"/></header>
    <div class="cc_queue_rows" t-if="props.rows.length">
        <article t-foreach="props.rows" t-as="row" t-key="row.workorder_id || row.production_id" t-att-data-flip="row.workorder_id || row.production_id" t-att-class="'cc_queue_row ' + (isLong(row) ? 'is-long' : '')">
            <div class="cc_queue_row__main"><Plate value="plate(row)"/><div><strong t-esc="service(row)"/><small><span t-esc="row.station_code || row.station_name || '—'"/> · <span t-esc="wait(row)"/></small></div></div>
            <div class="cc_queue_row__eta"><span t-esc="eta(row)"/><small t-esc="row.station_position ? '#' + row.station_position : ''"/></div>
        </article>
    </div>
    <div t-else="" class="cc_empty cc_empty--compact"><div class="cc_empty__icon">✓</div><span t-esc="empty"/></div>
</section>
</t></templates>
