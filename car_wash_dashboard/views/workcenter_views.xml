<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_wash_workcenter_list" model="ir.ui.view">
        <field name="name">car.wash.workcenter.list</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <list string="Car Wash Stations" editable="bottom">
                <field name="car_wash_sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" optional="show"/>
                <field name="car_wash_enabled"/>
                <field name="car_wash_station_type"/>
                <field name="default_capacity" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_car_wash_workcenter_form" model="ir.ui.view">
        <field name="name">car.wash.workcenter.form</field>
        <field name="model">mrp.workcenter</field>
        <field name="arch" type="xml">
            <form string="Car Wash Station">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Dashboard">
                            <field name="car_wash_enabled"/>
                            <field name="car_wash_station_type"/>
                            <field name="car_wash_sequence"/>
                            <field name="default_capacity"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_wash_workcenters" model="ir.actions.act_window">
        <field name="name">Car Wash Stations</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_car_wash_workcenters_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_car_wash_workcenter_list"/>
        <field name="act_window_id" ref="action_car_wash_workcenters"/>
    </record>

    <record id="action_car_wash_workcenters_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_car_wash_workcenter_form"/>
        <field name="act_window_id" ref="action_car_wash_workcenters"/>
    </record>
</odoo>
