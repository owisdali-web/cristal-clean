<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_car_wash_dashboard" model="ir.actions.client">
        <field name="name">لوحة التحكم العامة</field>
        <field name="tag">car_wash_dashboard.overview_action</field>
        <field name="target">main</field>
    </record>

    <record id="action_car_wash_automatic" model="ir.actions.client">
        <field name="name">الغسيل الآلي</field>
        <field name="tag">car_wash_dashboard.automatic_action</field>
        <field name="target">main</field>
    </record>

    <record id="action_car_wash_manual" model="ir.actions.client">
        <field name="name">الغسيل اليدوي</field>
        <field name="tag">car_wash_dashboard.manual_action</field>
        <field name="target">main</field>
    </record>

    <record id="action_car_wash_reports" model="ir.actions.client">
        <field name="name">التقارير</field>
        <field name="tag">car_wash_dashboard.reports_action</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_car_wash_root"
              name="غسيل السيارات"
              sequence="10"
              web_icon="car_wash_dashboard,static/description/icon.png"
              groups="base.group_user"/>

    <menuitem id="menu_car_wash_dashboard"
              name="لوحة التحكم العامة"
              parent="menu_car_wash_root"
              action="action_car_wash_dashboard"
              sequence="1"
              groups="base.group_user"/>

    <menuitem id="menu_car_wash_automatic"
              name="الغسيل الآلي"
              parent="menu_car_wash_root"
              action="action_car_wash_automatic"
              sequence="2"
              groups="base.group_user"/>

    <menuitem id="menu_car_wash_manual"
              name="الغسيل اليدوي"
              parent="menu_car_wash_root"
              action="action_car_wash_manual"
              sequence="3"
              groups="base.group_user"/>

    <menuitem id="menu_car_wash_reports"
              name="التقارير"
              parent="menu_car_wash_root"
              action="action_car_wash_reports"
              sequence="4"
              groups="base.group_user"/>
</odoo>
