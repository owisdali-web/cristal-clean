<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_car_wash_dashboard" model="ir.actions.client">
        <field name="name">Car Wash Dashboard</field>
        <field name="tag">car_wash_dashboard.client_action</field>
        <field name="target">main</field>
    </record>

    <menuitem id="menu_car_wash_root"
              name="Car Wash"
              sequence="10"
              web_icon="car_wash_dashboard,static/description/icon.png"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_car_wash_dashboard"
              name="Dashboard"
              parent="menu_car_wash_root"
              action="action_car_wash_dashboard"
              sequence="1"
              groups="mrp.group_mrp_user"/>

    <menuitem id="menu_car_wash_workcenters"
              name="Station Configuration"
              parent="menu_car_wash_root"
              action="action_car_wash_workcenters"
              sequence="90"
              groups="mrp.group_mrp_manager"/>
</odoo>
