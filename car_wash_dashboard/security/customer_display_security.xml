<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated permission for a waiting-room TV/browser session.
         Deliberately grants no direct MRP, POS, Stock or Accounting access. -->
    <record id="group_car_wash_customer_display" model="res.groups">
        <field name="name">Car Wash Customer Display</field>
    </record>

    <!-- V18: dedicated permission for management/analytics contracts.
         No extra model ACL is granted here; access to the contracts is checked explicitly. -->
    <record id="group_car_wash_manager" model="res.groups">
        <field name="name">Car Wash Manager Analytics</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
