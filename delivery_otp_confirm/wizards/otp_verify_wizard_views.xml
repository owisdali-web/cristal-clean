<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_otp_verify_wizard" model="ir.ui.view">
        <field name="name">delivery.otp.verify.wizard.form</field>
        <field name="model">delivery.otp.verify.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="otp_id" invisible="1"/>
                    <field name="code" placeholder="Enter 4-digit OTP" password="True"/>
                </group>
                <footer>
                    <button name="action_verify" string="Verify" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delivery_otp_verify_wizard" model="ir.actions.act_window">
        <field name="name">Verify OTP</field>
        <field name="res_model">delivery.otp.verify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>