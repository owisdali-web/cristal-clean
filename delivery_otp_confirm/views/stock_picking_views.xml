<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_otp_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.otp.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_delivery_otp"
                        type="object"
                        string="Send OTP"
                        class="btn-secondary"
                        invisible="not delivery_otp_required or state in ('done','cancel')"/>

                <!-- NEW: WhatsApp OTP -->
                <button name="action_send_delivery_otp_whatsapp"
                        type="object"
                        string="Send OTP via WhatsApp"
                        class="btn-success"
                        icon="fa-whatsapp"
                        invisible="not delivery_otp_required or state in ('done','cancel')"/>

                <button name="action_verify_delivery_otp"
                        type="object"
                        string="Verify OTP"
                        class="btn-primary"
                        invisible="not delivery_otp_required or state in ('done','cancel')"/>

                <!-- Skip OTP button – only for Inventory Administrators -->
                <button name="action_skip_otp"
                        type="object"
                        string="Skip OTP"
                        class="btn-warning"
                        invisible="not delivery_otp_required or state in ('done','cancel')"
                        groups="stock.group_stock_manager"/>
            </header>
            <field name="state" position="after">
                <field name="otp_verified" invisible="not delivery_otp_required"/>
                <field name="delivery_otp_required" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>