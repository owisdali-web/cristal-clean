<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_delivery_otp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.delivery.otp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />

        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <div class="app_settings_block"
                    data-string="Delivery OTP"
                    string="Delivery OTP">

                    <h2>Delivery OTP Settings</h2>

                    <div class="delivery_otp_settings">

                        <!-- Enable OTP -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <label for="delivery_otp_enabled">
                                    Enable Delivery OTP
                                </label>
                            </div>

                            <div class="delivery_otp_field">
                                <field name="delivery_otp_enabled" />
                                <div class="text-muted">
                                    Require OTP to validate delivery orders.
                                </div>
                            </div>
                        </div>


                        <!-- Expiry -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <label for="delivery_otp_expiry_minutes">
                                    OTP Expiry
                                </label>
                            </div>

                            <div class="delivery_otp_field">
                                <field name="delivery_otp_expiry_minutes" />
                                <div class="text-muted">
                                    Number of minutes before the OTP expires.
                                </div>
                            </div>
                        </div>


                        <!-- OTP Required Operation Types -->
                        <div class="delivery_otp_row">

                            <div class="delivery_otp_label">
                                <label for="otp_operation_type_ids">
                                    OTP Required Operation Types
                                </label>
                            </div>

                            <div class="delivery_otp_field">

                                <field name="otp_operation_type_ids"
                                    widget="many2many_tags" />

                                <div class="text-muted">
                                    OTP will be required only for these operation types.
                                    Leave empty to require OTP for all operation types
                                    in the selected warehouses.
                                </div>

                            </div>

                        </div>


                        <!-- API Username -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <label for="sms_otp_username">
                                    API Username
                                </label>
                            </div>

                            <div class="delivery_otp_field">
                                <field name="sms_otp_username" />

                                <div class="text-muted">
                                    Username used to access the SMS API.
                                </div>
                            </div>
                        </div>


                        <!-- API Password -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <label for="sms_otp_password">
                                    API Password
                                </label>
                            </div>

                            <div class="delivery_otp_field">
                                <field name="sms_otp_password"
                                    password="True" />

                                <div class="text-muted">
                                    Password used to access the SMS API.
                                </div>
                            </div>
                        </div>


                        <!-- Fetch Token -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <span>API Token</span>
                            </div>

                            <div class="delivery_otp_field">
                                <button name="action_fetch_token"
                                    type="object"
                                    string="Fetch Token"
                                    class="btn btn-primary" />

                                <div class="text-muted">
                                    Fetch a new authentication token
                                    from the SMS API.
                                </div>
                            </div>
                        </div>


                        <!-- Token -->
                        <div class="delivery_otp_row">
                            <div class="delivery_otp_label">
                                <label for="sms_otp_token">
                                    Current Token
                                </label>
                            </div>

                            <div class="delivery_otp_field">
                                <field name="sms_otp_token"
                                    readonly="1" />

                                <div class="text-muted">
                                    Token is valid for one year
                                    after being fetched from the API.
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>