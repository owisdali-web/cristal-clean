<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_wash_service_list" model="ir.ui.view">
        <field name="name">car.wash.service.list</field>
        <field name="model">car.wash.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="sequence" widget="handle" />
                <field name="active" />
                <field name="location_ids" string="Steps" widget="many2many_tags" limit="5" />
            </list>
        </field>
    </record>

    <record id="view_car_wash_service_form" model="ir.ui.view">
        <field name="name">car.wash.service.form</field>
        <field name="model">car.wash.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="sequence" widget="handle"
                            help="Lower number means this service is performed first. Drag to reorder." />
                        <field name="active" />
                    </group>
                    <notebook>
                        <page string="Flow Steps">
                            <field name="location_ids" context="{'default_service_id': id}">
                                <list editable="bottom" delete="true">
                                    <field name="step_sequence" widget="handle"
                                        help="Order of locations for this service." />
                                    <field name="location_id" options="{'no_create': True}" />
                                </list>
                            </field>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle" /> Define the ordered list of locations
                                this service must pass through. The service priority (sequence)
                                determines the order among different services. </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_wash_service" model="ir.actions.act_window">
        <field name="name">Cleaning Services</field>
        <field name="res_model">car.wash.service</field>
        <field name="view_mode">list,form</field>
        <field name="help">Define cleaning types (Outside, Inside, Deep, etc.) and their
            step-by-step locations.</field>
    </record>
    <menuitem id="menu_config_services" name="Cleaning Services" parent="menu_car_wash_config"
        action="action_car_wash_service" sequence="20" />
</odoo>