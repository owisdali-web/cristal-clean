<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_wash_type_list" model="ir.ui.view">
        <field name="name">car.wash.type.list</field>
        <field name="model">car.wash.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_car_wash_type_form" model="ir.ui.view">
        <field name="name">car.wash.type.form</field>
        <field name="model">car.wash.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Pricing Matrix">
                            <!-- Fixed: use 'id' instead of 'active_id' -->
                            <field name="pricelist_ids" context="{'default_car_type_id': id}">
                                <list editable="bottom" delete="true">
                                    <field name="service_id" options="{'no_create': True}"/>
                                    <field name="price" sum="Total Matrix Prices"/>
                                </list>
                            </field>
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> Set the price for each service specifically for this car type.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_wash_type" model="ir.actions.act_window">
        <field name="name">Car Types</field>
        <field name="res_model">car.wash.type</field>
        <field name="view_mode">list,form</field>
        <field name="help">Define car categories (SUV, Sedan, Hatchback, etc.).</field>
    </record>
    <menuitem id="menu_config_car_types" name="Car Types" parent="menu_car_wash_config" action="action_car_wash_type" sequence="30"/>
</odoo>