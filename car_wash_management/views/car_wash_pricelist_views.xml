<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_wash_pricelist_list" model="ir.ui.view">
        <field name="name">car.wash.pricelist.list</field>
        <field name="model">car.wash.pricelist</field>
        <field name="arch" type="xml">
            <list>
                <field name="car_type_id"/>
                <field name="service_id"/>
                <field name="price" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_car_wash_pricelist_form" model="ir.ui.view">
        <field name="name">car.wash.pricelist.form</field>
        <field name="model">car.wash.pricelist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="car_type_id" options="{'no_create': True}"/>
                        <field name="service_id" options="{'no_create': True}"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_wash_pricelist" model="ir.actions.act_window">
        <field name="name">Pricing Matrix</field>
        <field name="res_model">car.wash.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="help">Global list of all price combinations. Usually managed through Car Types form.</field>
    </record>
    <menuitem id="menu_config_pricelist" name="Pricing Matrix (All)" parent="menu_car_wash_config" action="action_car_wash_pricelist" sequence="40" groups="base.group_system"/>
</odoo>