<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_car_wash_location_list" model="ir.ui.view">
        <field name="name">car.wash.location.list</field>
        <field name="model">car.wash.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="capacity" />
                <field name="current_count" widget="integer"
                    decoration-danger="current_count >= capacity" />
                <field name="is_waiting_zone" />
                <field name="is_final_zone" />
            </list>
        </field>
    </record>

    <record id="view_car_wash_location_form" model="ir.ui.view">
        <field name="name">car.wash.location.form</field>
        <field name="model">car.wash.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="capacity" />
                        <field name="is_waiting_zone" />
                        <field name="is_final_zone" />
                        <field name="current_count" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_car_wash_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">car.wash.location</field>
        <field name="view_mode">list,form</field>   <!-- changed tree → list -->
        <field name="help">Manage wash stations, waiting, and done zones.</field>
    </record>
    <menuitem id="menu_config_locations" name="Locations" parent="menu_car_wash_config"
        action="action_car_wash_location" sequence="10" />
</odoo>