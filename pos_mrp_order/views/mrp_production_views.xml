<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_pos" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.pos.mrp.order</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pos_order" type="object"
                        class="oe_stat_button" icon="fa-shopping-basket"
                        invisible="not pos_order_id"
                        groups="point_of_sale.group_pos_user">
                    <div class="o_stat_info"><span class="o_stat_text">POS Order</span></div>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pos_order_id" invisible="not pos_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
