<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_mrp" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.pos.mrp.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mrp_productions" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="mrp_production_count == 0"
                        groups="mrp.group_mrp_user">
                    <field name="mrp_production_count" widget="statinfo" string="Manufacturing"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
